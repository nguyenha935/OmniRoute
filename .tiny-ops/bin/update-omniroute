#!/usr/bin/env bash
set -euo pipefail

readonly UPDATE_SCRIPT="/opt/omniroute/ops/update.sh"
readonly DEPLOY_SCRIPT="/opt/omniroute/ops/deploy.sh"
readonly MODE="${1:---check}"
readonly LOCK_FILE="/run/omniroute-update-wrapper.lock"
readonly UNIT_FILE="/run/omniroute-update.unit"

export CIRCLE_NODE_TOTAL="${CIRCLE_NODE_TOTAL:-1}"

UNIT=""
RUNNER_PID=""
STOPPING=0

stop_update_unit() {
  [ "$STOPPING" -eq 0 ] || return 0
  STOPPING=1

  if [ -n "$RUNNER_PID" ] && kill -0 "$RUNNER_PID" 2>/dev/null; then
    kill -TERM "$RUNNER_PID" 2>/dev/null || true
  fi

  if [ -n "$UNIT" ] && systemctl is-active --quiet "$UNIT" 2>/dev/null; then
    systemctl kill --kill-whom=all --signal=TERM "$UNIT" 2>/dev/null || true
    for _ in $(seq 1 10); do
      systemctl is-active --quiet "$UNIT" 2>/dev/null || break
      sleep 1
    done
    if systemctl is-active --quiet "$UNIT" 2>/dev/null; then
      systemctl kill --kill-whom=all --signal=KILL "$UNIT" 2>/dev/null || true
    fi
    systemctl stop --no-block "$UNIT" 2>/dev/null || true
  fi

  if [ -n "$RUNNER_PID" ]; then
    wait "$RUNNER_PID" 2>/dev/null || true
  fi
  rm -f "$UNIT_FILE"
}

handle_signal() {
  local signal="$1"
  trap - EXIT INT TERM HUP
  stop_update_unit
  case "$signal" in
    INT) exit 130 ;;
    TERM) exit 143 ;;
    HUP) exit 129 ;;
  esac
}

cleanup() {
  local exit_code=$?
  trap - EXIT INT TERM HUP
  stop_update_unit
  return "$exit_code"
}

case "$MODE" in
  -h|--help|help)
    exec "$DEPLOY_SCRIPT" help
    ;;
  --update|update)
    exec 8>"$LOCK_FILE"
    if ! flock -n 8; then
      printf '[omniroute-update] ERROR: another updater wrapper is already running\n' >&2
      exit 20
    fi
    if systemctl list-units --all --type=service --no-legend 'omniroute-update-*.service' \
      | grep -Eq '[[:space:]](activating|active|deactivating)[[:space:]]'; then
      printf '[omniroute-update] ERROR: another updater unit is already active\n' >&2
      exit 20
    fi

    UNIT="omniroute-update-$(date -u +%Y%m%dT%H%M%SZ)-$$.service"
    printf '%s\n' "$UNIT" >"$UNIT_FILE"
    trap cleanup EXIT
    trap 'handle_signal INT' INT
    trap 'handle_signal TERM' TERM
    trap 'handle_signal HUP' HUP

    systemd-run \
      --unit="${UNIT%.service}" \
      --description="OmniRoute artifact-only automatic update" \
      --collect \
      --wait \
      --pipe \
      --service-type=exec \
      --property=MemoryHigh=4G \
      --property=MemoryMax=6G \
      --property=MemorySwapMax=512M \
      --property=CPUQuota=300% \
      --property=Nice=10 \
      --property=OOMPolicy=stop \
      --property=KillMode=control-group \
      --property=TimeoutStopSec=20s \
      --property=RuntimeMaxSec=35min \
      --setenv=CIRCLE_NODE_TOTAL="$CIRCLE_NODE_TOTAL" \
      "$DEPLOY_SCRIPT" update &
    RUNNER_PID=$!

    set +e
    wait "$RUNNER_PID"
    exit_code=$?
    set -e
    RUNNER_PID=""
    rm -f "$UNIT_FILE"
    trap - EXIT INT TERM HUP
    exit "$exit_code"
    ;;
  *)
    exec "$UPDATE_SCRIPT" "$@"
    ;;
esac
