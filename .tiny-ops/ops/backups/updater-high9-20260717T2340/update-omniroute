#!/usr/bin/env bash
set -euo pipefail

readonly UPDATE_SCRIPT="/opt/omniroute/ops/update.sh"
readonly MODE="${1:---check}"

export CIRCLE_NODE_TOTAL="${CIRCLE_NODE_TOTAL:-1}"

case "$MODE" in
  --update|update)
    readonly UNIT="omniroute-update-$(date -u +%Y%m%dT%H%M%SZ)-$$"
    exec systemd-run \
      --unit="$UNIT" \
      --description="OmniRoute pinned safe update" \
      --collect \
      --wait \
      --pipe \
      --service-type=exec \
      --property=MemoryHigh=8G \
      --property=MemoryMax=10G \
      --property=MemorySwapMax=512M \
      --property=CPUQuota=300% \
      --property=Nice=10 \
      --property=OOMPolicy=stop \
      --property=KillMode=control-group \
      --setenv=CIRCLE_NODE_TOTAL="$CIRCLE_NODE_TOTAL" \
      --setenv=OMNIROUTE_BUILD_MEMORY_MB=8192 \
      "$UPDATE_SCRIPT" "$@"
    ;;
  *)
    exec "$UPDATE_SCRIPT" "$@"
    ;;
esac
