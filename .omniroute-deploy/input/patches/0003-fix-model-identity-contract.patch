index 000000000..76b4d1813
--- /dev/null
+++ b/tests/unit/combo-target-node-prefix.test.ts
@@ -0,0 +1,104 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+
+/**
+ * A combo step that targets a CUSTOM compatible provider must resolve to the bare
+ * upstream model id.
+ *
+ * Combo steps persist `provider` as the raw node id (storage shape) while `modelStr`
+ * carries whatever the catalog published — i.e. `<nodePrefix>/<model>`. The strip in
+ * `getComboTargetModelId()` accepts a prefix only when `prefixRoutesToProvider()`
+ * says it routes to the provider, and that check is a `parseModel()` probe.
+ * `parseModel()` only knows the STATIC registry, so an operator-configured
+ * `provider_nodes.prefix` never matched: the only accepted prefix for such a
+ * provider was its own raw node id.
+ *
+ * Consequence: `"pix4k/claude-opus-5"` was returned verbatim as the *model id*, so
+ * every downstream lookup keyed by the bare id (registry model, model spec, synced
+ * capability, pricing) missed. In `computeComboContextLength` that member then fails
+ * the source check and contributes nothing to the min() — the combo silently reports
+ * a context window computed from its OTHER members only, or `undefined` when the
+ * compatible provider is its only member.
+ *
+ * The existing combo-context test uses `glm/glm-5.2`, a STATIC registry alias, so it
+ * passed throughout.
+ */
+
+const maps = await import("../../src/app/api/v1/models/catalogProviderMaps.ts");
+
+const NODE_ID = "anthropic-compatible-abababab-cdcd-efef-0101-232323232323";
+const NODE_PREFIX = "pix4k";
+const MODEL = "claude-opus-5";
+
+const aliasMaps = maps.buildAliasMaps();
+
+test("a prefix-qualified modelStr on a compatible node resolves to the bare model id", () => {
+  const resolved = maps.getComboTargetModelId(
+    aliasMaps,
+    { provider: NODE_ID, modelStr: `${NODE_PREFIX}/${MODEL}` },
+    NODE_PREFIX
+  );
+
+  assert.deepEqual(resolved, { providerId: NODE_ID, modelId: MODEL });
+});
+
+test("without the node prefix the same input keeps the prefix glued on (the defect)", () => {
+  // Pinning the old behaviour so the reason the parameter exists stays visible:
+  // this is exactly what every lookup downstream received.
+  const resolved = maps.getComboTargetModelId(aliasMaps, {
+    provider: NODE_ID,
+    modelStr: `${NODE_PREFIX}/${MODEL}`,
+  });
+
+  assert.equal(
+    resolved?.modelId,
+    `${NODE_PREFIX}/${MODEL}`,
+    "with no prefix supplied the strip cannot fire — callers must pass provider_nodes.prefix"
+  );
+});
+
+test("the node-id-qualified shape keeps resolving (combo steps also store this)", () => {
+  const resolved = maps.getComboTargetModelId(
+    aliasMaps,
+    { provider: NODE_ID, modelStr: `${NODE_ID}/${MODEL}` },
+    NODE_PREFIX
+  );
+
+  assert.deepEqual(resolved, { providerId: NODE_ID, modelId: MODEL });
+});
+
+test("getProviderPrefixes reports the operator prefix as a routable prefix", () => {
+  const prefixes = maps.getProviderPrefixes(aliasMaps, NODE_ID, NODE_ID, NODE_PREFIX);
+
+  assert.ok(
+    prefixes.includes(NODE_PREFIX),
+    `the configured prefix must be accepted; got ${JSON.stringify(prefixes)}`
+  );
+  assert.ok(prefixes.includes(NODE_ID), "the raw node id must stay accepted");
+});
+
+test("a prefix that is NOT this node's is still rejected", () => {
+  // Widening must not turn the strip into 'peel any leading segment', which would
+  // corrupt ids that legitimately contain a slash.
+  const resolved = maps.getComboTargetModelId(
+    aliasMaps,
+    { provider: NODE_ID, modelStr: `someone-elses-prefix/${MODEL}` },
+    NODE_PREFIX
+  );
+
+  assert.equal(
+    resolved?.modelId,
+    `someone-elses-prefix/${MODEL}`,
+    "only this provider's own names may be stripped"
+  );
+});
+
+test("a bare modelStr is passed through untouched", () => {
+  const resolved = maps.getComboTargetModelId(
+    aliasMaps,
+    { provider: NODE_ID, modelStr: MODEL },
+    NODE_PREFIX
+  );
+
+  assert.deepEqual(resolved, { providerId: NODE_ID, modelId: MODEL });
+});
