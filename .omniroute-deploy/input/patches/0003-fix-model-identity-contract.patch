+
+/**
+ * The full listability rule: the combo is enabled, not eye-hidden, and no model it
+ * resolves to is eye-hidden. This is what `/v1/models` enforces; every other combo
+ * listing must enforce the same thing.
+ */
+export function isComboListable(
+  combo: ComboLike,
+  allCombos: readonly ComboLike[],
+  context: ComboResolutionContext
+): boolean {
+  if (combo?.isActive === false) return false;
+  if (combo?.isHidden === true) return false;
+  return comboTargetsAllVisible(combo, allCombos, context);
+}
+
+/** Filter a combo list down to the listable ones, preserving order. */
+export async function filterListableCombos<T extends ComboLike>(
+  combos: readonly T[]
+): Promise<T[]> {
+  if (!Array.isArray(combos) || combos.length === 0) return [];
+  const context = await buildComboResolutionContext();
+  return combos.filter((combo) => isComboListable(combo, combos, context));
