+
+// ── G2. Same cross-surface contract on the DEFAULT (static) connection path ─
+// Test G above seeds gpt-5.6-sol via synced discovery (supportedEndpoints). The
+// regression that motivated the emission fix hit the DEFAULT path: a plain codex
+// connection with NO synced models, where the static chat loop and the image
+// registry both emit `codex/gpt-5.6-sol`. Single-prefix must keep BOTH intentional
+// surfaces under one public id — the Responses chat surface and the image surface —
+// not collapse them into the image row alone.
+test("G2: default codex connection (no synced models) keeps both responses + image base surfaces under one id", async () => {
+  await seedConnection("codex");
+  const entries = await listEntries();
+  const solEntries = entries.filter((e) => String(e.id) === "codex/gpt-5.6-sol");
+
+  const imageSurface = solEntries.find((e) => String(e.type ?? "chat") === "image");
+  const responsesSurface = solEntries.find(
+    (e) =>
+      String(e.type ?? "chat") !== "image" &&
+      Array.isArray(e.supported_endpoints) &&
+      (e.supported_endpoints as string[]).includes("responses")
+  );
+
+  assert.ok(
+    imageSurface,
+    `default path must keep the image surface; got: ${JSON.stringify(solEntries.map((e) => ({ id: e.id, type: e.type })))}`
+  );
+  assert.ok(
+    responsesSurface,
+    `default path must keep the Responses chat surface (not collapse into image-only); got: ${JSON.stringify(solEntries.map((e) => ({ id: e.id, type: e.type, se: e.supported_endpoints })))}`
+  );
+  // Exactly the two intentional base surfaces, both under the one canonical id.
+  assert.equal(
+    solEntries.length,
+    2,
+    `expected exactly the responses + image base surfaces, got: ${JSON.stringify(solEntries.map((e) => ({ id: e.id, type: e.type, se: e.supported_endpoints })))}`
+  );
+  // Sibling absence must be proven against the FULL entry list, not solEntries
+  // (which only filters the canonical id). The single-prefix contract publishes
+  // this model under `codex/` alone: no `cx/` alias row and no bare id row.
+  assert.equal(
+    entries.some((e) => String(e.id) === "cx/gpt-5.6-sol"),
+    false,
+    "the legacy cx/ alias must NOT be a catalog row (inbound-callable only)"
+  );
+  assert.equal(
+    entries.some((e) => String(e.id) === "gpt-5.6-sol"),
+    false,
+    "the bare id must NOT be a catalog row (inbound-callable only)"
+  );
