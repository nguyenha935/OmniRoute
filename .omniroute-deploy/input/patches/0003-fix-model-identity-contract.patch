diff --git a/tests/unit/mcp-catalog-provider-identity.test.ts b/tests/unit/mcp-catalog-provider-identity.test.ts
new file mode 100644
index 000000000..5cf0d048b
--- /dev/null
+++ b/tests/unit/mcp-catalog-provider-identity.test.ts
@@ -0,0 +1,228 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+/**
+ * `omniroute_list_models_catalog` (the MCP surface) must name providers exactly as
+ * the HTTP surfaces do.
+ *
+ * It used to resolve provider names from a private walk over AI_PROVIDERS +
+ * NOAUTH_PROVIDERS, which never consulted `provider_nodes`. Two consequences, both
+ * invisible from the dashboard:
+ *
+ *   1. a custom compatible provider could only be addressed by its raw node id.
+ *      The public prefix — the ONLY name /v1/models advertises, and therefore the
+ *      only one an MCP client can have learned — matched nothing, so the tool
+ *      answered "No active connections found for provider '<prefix>'";
+ *   2. `provider` was echoed straight from the per-connection endpoint's
+ *      `owned_by`, i.e. the internal node UUID. #8327 removed that leak from
+ *      /v1/models but this surface kept publishing it.
+ *
+ * The pre-existing mcp-model-catalog.test.ts covers built-in providers with
+ * injected connections only, where node resolution never comes into play, so it
+ * passed throughout.
+ */
+
+const TEST_DATA_DIR = fs.mkdtempSync(path.join(os.tmpdir(), "omniroute-mcp-identity-"));
+process.env.DATA_DIR = TEST_DATA_DIR;
+process.env.API_KEY_SECRET = process.env.API_KEY_SECRET || "mcp-identity-test-secret";
+
+const core = await import("../../src/lib/db/core.ts");
+const providersDb = await import("../../src/lib/db/providers.ts");
+const modelsDb = await import("../../src/lib/db/models.ts");
+const readCache = await import("../../src/lib/db/readCache.ts");
+const v1ModelsCatalog = await import("../../src/app/api/v1/models/catalog.ts");
+const { getMcpModelsCatalog } = await import("../../open-sse/mcp-server/catalog.ts");
+
+const NODE_ID = "anthropic-compatible-12121212-3434-5656-7878-909090909090";
+const NODE_PREFIX = "pix4k";
+const CONNECTION_ID = "conn-mcp-compat";
+
+/** What /api/providers/<connId>/models returns: bare ids, STORAGE-shaped owned_by. */
+const upstreamPayload = {
+  source: "api",
+  models: [
+    { id: "claude-opus-5", owned_by: NODE_ID, supportedEndpoints: ["chat"] },
+    { id: "claude-haiku-4-5", owned_by: NODE_ID, supportedEndpoints: ["chat"] },
+  ],
+};
+
+async function seedNode() {
+  await providersDb.createProviderNode({
+    id: NODE_ID,
+    type: "anthropic-compatible",
+    name: "Pix4k",
+    prefix: NODE_PREFIX,
+    baseUrl: "https://example.invalid/v1",
+  } as never);
+  readCache.invalidateReadCaches?.();
+  v1ModelsCatalog.__resetCatalogBuilderRunsForTest();
+}
+
+async function seedCatalogModel() {
+  const connection = await providersDb.createProviderConnection({
+    provider: NODE_ID,
+    authType: "apikey",
+    name: "pix4k-catalog",
+    apiKey: "sk-test",
+    isActive: true,
+    testStatus: "active",
+    providerSpecificData: {},
+  });
+  await modelsDb.replaceSyncedAvailableModelsForConnection(NODE_ID, connection.id, [
+    { id: "claude-opus-5", supportedEndpoints: ["chat"] },
+  ]);
+  readCache.invalidateReadCaches?.();
+  v1ModelsCatalog.__resetCatalogBuilderRunsForTest();
+}
+
+async function callCatalog(provider: string | undefined) {
+  const calls: string[] = [];
+  const result = await getMcpModelsCatalog(
+    provider ? { provider } : {},
+    {
+      listProviderConnections: async () => [
+        { id: CONNECTION_ID, provider: NODE_ID, isActive: true, providerSpecificData: {} },
+      ],
+      fetchJson: async (requestPath: string) => {
+        calls.push(requestPath);
+        return upstreamPayload;
+      },
+    }
+  );
+  return { calls, result };
+}
+
+test.beforeEach(async () => {
+  core.resetDbInstance();
+  fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true });
+  fs.mkdirSync(TEST_DATA_DIR, { recursive: true });
+});
+
+test.after(async () => {
+  core.resetDbInstance();
+  fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true });
+});
+
+test("a compatible provider is reachable by the PREFIX the catalog advertises", async () => {
+  await seedNode();
+
+  const { calls, result } = await callCatalog(NODE_PREFIX);
+  assert.equal(
+    result.warning,
+    undefined,
+    `the public prefix must resolve to the node; got: ${result.warning}`
+  );
+  assert.deepEqual(calls, [`/api/providers/${CONNECTION_ID}/models?excludeHidden=true`]);
+  assert.equal(result.models.length, 2, "both upstream models must be listed");
+});
+
+test("the same provider stays reachable by its raw node id", async () => {
+  await seedNode();
+
+  const { result } = await callCatalog(NODE_ID);
+  assert.equal(result.warning, undefined, "storage-shaped ids must not regress");
+  assert.equal(result.models.length, 2);
+});
+
+test("the internal node id never appears in a published provider field", async () => {
+  await seedNode();
+
+  const { result } = await callCatalog(NODE_PREFIX);
+  // Assert the list is non-empty FIRST. Without this the loop below is vacuous on
+  // a build where the prefix does not resolve at all: zero models means zero
+  // iterations means a green test that proved nothing.
+  assert.equal(result.models.length, 2, "precondition: the provider must have resolved");
+  for (const model of result.models) {
+    assert.equal(
+      model.provider,
+      NODE_PREFIX,
+      `provider must be the operator prefix, got "${model.provider}"`
+    );
+    assert.ok(!model.provider.includes(NODE_ID), "the raw node UUID must never leak");
+  }
+});
+
+test("the unified catalog and MCP use the same public owner for a compatible node", async () => {
+  await seedNode();
+  await seedCatalogModel();
+
+  const v1Response = await v1ModelsCatalog.getUnifiedModelsResponse(
+    new Request("http://localhost/api/v1/models")
+  );
+  assert.equal(v1Response.status, 200);
+  const v1Body = (await v1Response.json()) as {
+    data: Array<{ id?: string; owned_by?: string }>;
+  };
+
+  const v1Models = v1Body.data.filter(
+    (model): model is { id: string; owned_by: string } =>
+      typeof model.id === "string" &&
+      model.id.startsWith(`${NODE_PREFIX}/`) &&
+      typeof model.owned_by === "string"
+  );
+  assert.ok(v1Models.length > 0, "the unified catalog must publish a prefixed node model");
+
+  const v1Owners = new Set(v1Models.map((model) => model.owned_by));
+  assert.ok(
+    !v1Owners.has(NODE_ID),
+    "the unified catalog must not expose the storage UUID as an owner"
+  );
+
+  const { result } = await callCatalog(NODE_PREFIX);
+  const publishedModelIds = new Set(
+    v1Models.map((model) => model.id.slice(`${NODE_PREFIX}/`.length))
+  );
+  const matchingMcpModels = result.models.filter((model) => publishedModelIds.has(model.id));
+
+  assert.ok(
+    matchingMcpModels.length > 0,
+    "MCP must return at least one model also published by the unified catalog"
+  );
+
+  const mcpOwners = new Set(matchingMcpModels.map((model) => model.provider));
+  assert.deepEqual(
+    mcpOwners,
+    v1Owners,
+    "catalog and MCP must publish matching models under the same public owner"
+  );
+  assert.ok(
+    !mcpOwners.has(NODE_ID),
+    "MCP must not expose the storage UUID as a provider"
+  );
+});
+
+test("owner naming matches /v1/models: canonical id, not the short alias", async () => {
+  // Generic /v1/models publishes GitHub under `github/` with
+  // `owned_by: "github"`; `gh/` is inbound-only. MCP addressed by `gh` must
+  // return the same canonical owner, `github`.
+  const result = await getMcpModelsCatalog(
+    { provider: "gh" },
+    {
+      listProviderConnections: async () => [
+        { id: "conn-github", provider: "github", isActive: true },
+      ],
+      fetchJson: async () => ({
+        source: "api",
+        models: [{ id: "gpt-4.1", owned_by: "github", supportedEndpoints: ["chat"] }],
+      }),
+    }
+  );
+
+  assert.equal(result.models.length, 1);
+  assert.equal(result.models[0]?.provider, "github", "owner must be the canonical id");
+});
+
+test("an unknown provider name is still reported as unknown, echoing what was asked", async () => {
+  await seedNode();
+
+  const { result } = await callCatalog("definitely-not-a-provider");
