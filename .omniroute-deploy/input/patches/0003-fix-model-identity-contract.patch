@@ -0,0 +1,152 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+/**
+ * `GET /v1/providers/{provider}/models` for a CUSTOM compatible provider.
+ *
+ * This endpoint feeds the provider-detail Playground and the "test model" dialog.
+ * Both showed no selectable model for a custom provider, and the endpoint was in
+ * fact returning `{"object":"list","data":[]}` — verified against a live install.
+ *
+ * Two independent causes, both about the same identity mismatch:
+ *
+ *   1. the route matched `model.owned_by === providerId` (the raw node id), but
+ *      #8327 deliberately made the PUBLIC `owned_by` the operator's prefix via
+ *      resolvePublicOwnerId(). node id !== prefix, so every row was filtered out;
+ *   2. the route accepted only the node id in the URL, so the prefix — the very
+ *      name the catalog advertises — answered `400 Unknown provider`. The provider
+ *      was therefore unreachable under BOTH of its names.
+ *
+ * The pre-existing provider-scoped test covers built-in providers only, where the
+ * alias and the canonical id coincide, so it passed throughout.
+ */
+
+const TEST_DATA_DIR = fs.mkdtempSync(path.join(os.tmpdir(), "omniroute-provider-models-compat-"));
+process.env.DATA_DIR = TEST_DATA_DIR;
+
+const core = await import("../../src/lib/db/core.ts");
+const providersDb = await import("../../src/lib/db/providers.ts");
+const modelsDb = await import("../../src/lib/db/models.ts");
+const readCache = await import("../../src/lib/db/readCache.ts");
+const v1Catalog = await import("../../src/app/api/v1/models/catalog.ts");
+const providerModelsRoute =
+  await import("../../src/app/api/v1/providers/[provider]/models/route.ts");
+
+const NODE_ID = "anthropic-compatible-aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee";
+const NODE_PREFIX = "pix4k";
+const VISIBLE_MODEL = "claude-opus-5";
+const HIDDEN_MODEL = "claude-sonnet-4";
+
+type ModelsResponse = {
+  object?: string;
+  data?: Array<Record<string, unknown>>;
+  error?: { message?: string; code?: string };
+};
+
+async function resetStorage() {
+  core.resetDbInstance();
+  fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true });
+  fs.mkdirSync(TEST_DATA_DIR, { recursive: true });
+}
+
+async function seedCompatibleProvider() {
+  await providersDb.createProviderNode({
+    id: NODE_ID,
+    type: "anthropic-compatible",
+    name: "Pix4k",
+    prefix: NODE_PREFIX,
+    baseUrl: "https://example.invalid/v1",
+  } as never);
+
+  const connection = await providersDb.createProviderConnection({
+    provider: NODE_ID,
+    authType: "apikey",
+    name: "pix4k-main",
+    apiKey: "sk-test",
+    isActive: true,
+    testStatus: "active",
+    providerSpecificData: {},
+  } as never);
+
+  await modelsDb.replaceSyncedAvailableModelsForConnection(
+    NODE_ID,
+    (connection as { id: string }).id,
+    [{ id: VISIBLE_MODEL }, { id: HIDDEN_MODEL }] as never
+  );
+
+  // provider_nodes and the catalog payload are both cached; clear them so the
+  // route sees the rows this test just wrote.
+  readCache.invalidateReadCaches?.();
+  v1Catalog.__resetCatalogBuilderRunsForTest?.();
+  return connection as { id: string };
+}
+
+const call = async (provider: string): Promise<ModelsResponse> => {
+  const response = await providerModelsRoute.GET(
+    new Request(`http://localhost/v1/providers/${provider}/models`),
+    { params: Promise.resolve({ provider }) }
+  );
+  return (await response.json()) as ModelsResponse;
+};
+
+test.beforeEach(async () => {
+  await resetStorage();
+});
+
+test.after(async () => {
+  core.resetDbInstance();
+  fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true });
+});
+
+test("addressing a compatible provider by its PREFIX returns its models", async () => {
+  await seedCompatibleProvider();
+
+  const body = await call(NODE_PREFIX);
+  assert.equal(body.error, undefined, `prefix must be accepted, got: ${body.error?.message}`);
+  const ids = (body.data ?? []).map((m) => m.id);
+  assert.ok(
+    ids.includes(VISIBLE_MODEL),
+    `expected the synced model with an unprefixed id; got ${JSON.stringify(ids)}`
+  );
+});
+
+test("addressing the same provider by its NODE ID also returns its models", async () => {
+  await seedCompatibleProvider();
+
+  const body = await call(NODE_ID);
+  assert.equal(body.error, undefined, `node id must stay accepted, got: ${body.error?.message}`);
+  const ids = (body.data ?? []).map((m) => m.id);
+  assert.ok(ids.includes(VISIBLE_MODEL), `expected the synced model; got ${JSON.stringify(ids)}`);
+});
+
+test("returned ids are unprefixed, never carrying the prefix or the raw node id", async () => {
+  await seedCompatibleProvider();
+
+  const body = await call(NODE_PREFIX);
+  for (const model of body.data ?? []) {
+    const id = String(model.id);
+    assert.ok(!id.includes("/"), `id must be unprefixed for this endpoint, got "${id}"`);
+    assert.ok(!id.includes(NODE_ID), `the internal node id must never leak, got "${id}"`);
+  }
+});
+
+test("a hidden model stays hidden on this endpoint", async () => {
+  await seedCompatibleProvider();
+  modelsDb.mergeModelCompatOverride(NODE_ID, HIDDEN_MODEL, { isHidden: true } as never);
+  readCache.invalidateReadCaches?.();
+  v1Catalog.__resetCatalogBuilderRunsForTest?.();
+
+  const body = await call(NODE_PREFIX);
+  const ids = (body.data ?? []).map((m) => String(m.id));
+  assert.ok(!ids.includes(HIDDEN_MODEL), "widening the owner match must not expose hidden models");
+});
+
+test("a genuinely unknown provider is still rejected", async () => {
+  await seedCompatibleProvider();
+
+  const body = await call("definitely-not-a-provider");
+  assert.equal(body.error?.code, "invalid_provider", "unknown names must still 400");
+});
