index 000000000..901acd4b7
--- /dev/null
+++ b/src/shared/providers/nodePrefix.ts
@@ -0,0 +1,260 @@
+/**
+ * Provider-node prefix validation — the one place that decides whether an operator
+ * may claim a given `provider_nodes.prefix`.
+ *
+ * WHY THIS EXISTS
+ *
+ * A node's prefix becomes the FIRST SEGMENT of every model id that node publishes
+ * (`pix4k/claude-opus-5`), and the request path resolves that segment back to a
+ * provider. Nothing validated it, so three shapes of unusable configuration could be
+ * saved through the normal UI:
+ *
+ *   1. A prefix that shadows a BUILT-IN provider id or alias. `resolveProviderSegment`
+ *      deliberately lets built-ins win (a user prefix must never hijack `openai`), so
+ *      the node publishes ids that resolve straight back to the built-in — the node
+ *      itself becomes unreachable. Verified: a node with prefix `openai` publishes
+ *      `openai/<model>` and `getModelInfo("openai/gpt-4o")` still resolves to the
+ *      built-in `openai`.
+ *
+ *   2. A prefix that shadows a SYNTHETIC namespace (`auto`, `combo`, `no-think`,
+ *      `qtSd`). These are gateway constructs, and here the node WINS rather than
+ *      losing: verified that a node with prefix `auto` captures `auto/best`, and one
+ *      with prefix `no-think` captures `no-think/openai/gpt-4o` — so a single node
+ *      can silently take over auto-routing or the no-thinking alias namespace.
+ *
+ *   3. A prefix ALREADY used by another node. The column has no UNIQUE constraint;
+ *      verified that two nodes save fine and the first one wins every lookup, leaving
+ *      the second permanently dead.
+ *
+ * POLICY (as decided with the operator): block it at write time for NEW/EDITED nodes,
+ * and only WARN about rows that already exist. A hard UNIQUE constraint was rejected
+ * on purpose — migrations run all-or-nothing and a failure keeps the DB from starting,
+ * so adding one would brick any install that already has a duplicate. Existing rows are
+ * surfaced via `findProviderNodePrefixConflicts` instead, and never rewritten: the
+ * prefix is part of the ids clients have already pinned.
+ *
+ * @module shared/providers/nodePrefix
+ */
+
+import { REGISTRY } from "@omniroute/open-sse/config/providerRegistry.ts";
+import { AI_PROVIDERS } from "@/shared/constants/providers";
+import { SYNTHETIC_MODEL_NAMESPACES, type ProviderNodeLike } from "./identity";
+
+/**
+ * Shape of a prefix: what may appear in the first segment of a published model id.
+ *
+ * A slash would split into a second segment and forge a provider boundary; whitespace
+ * and `?#%` break URL/id parsing downstream; a leading or trailing separator produces
+ * ids like `foo-/model`.
+ *
+ * Mixed case IS allowed. Segment resolution compares prefixes case-SENSITIVELY
+ * (`sse/services/model.ts` matches `node.prefix === segment`), so an uppercase prefix
+ * routes perfectly well, and the gateway's own `qtSd` namespace proves the codebase
+ * uses camelCase segments. Rejecting them would also lock existing nodes out of the
+ * edit form. The reserved and duplicate comparisons below therefore fold case
+ * themselves, so `MyDup` cannot slip past a `mydup` that already exists.
+ */
+const PREFIX_SHAPE_RE = /^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$/;
+const PREFIX_MAX_LENGTH = 64;
+
+export type PrefixRejection = {
+  /** Machine-readable cause, for tests and API error codes. */
+  code: "empty" | "shape" | "too-long" | "reserved-provider" | "reserved-synthetic" | "duplicate";
+  /** Operator-facing explanation. */
+  message: string;
+  /** The node already holding this prefix (duplicate only). */
+  conflictingNodeId?: string;
+};
+
+/**
+ * Case-insensitive membership in the synthetic namespaces. The set itself is
+ * mixed-case (`qtSd`), so neither a raw nor a lowercased comparison alone covers it:
+ * `qtsd` must be refused as firmly as `qtSd`, since a node claiming either ends up
+ * competing for the same quota-pool ids.
+ */
+function isSyntheticPrefix(prefix: string): boolean {
+  const lower = prefix.toLowerCase();
+  for (const namespace of SYNTHETIC_MODEL_NAMESPACES) {
+    if (namespace.toLowerCase() === lower) return true;
+  }
+  return false;
+}
+
+let _reservedProviderPrefixes: Set<string> | null = null;
+
+/**
+ * Built-in provider names reserved when an operator creates or edits a node prefix.
+ *
+ * `REGISTRY` supplies the exact built-in provider ids and aliases used by the
+ * existing runtime collision guard. `AI_PROVIDERS` contributes a wider public and
+ * configuration provider-name surface for create/edit validation.
+ *
+ * New and edited node prefixes are checked against the union of both sources.
+ * Existing rows are reported through `findProviderNodePrefixConflicts` rather than
+ * rewritten, so model ids already published from those rows are preserved.
+ *
+ * The validation set and the runtime collision-guard set therefore intentionally
+ * are not required to be equal.
+ *
+ * Built lazily and cached: `AI_PROVIDERS` is a Proxy that materializes its backing
+ * map on first access.
+ */
+export function getReservedNodePrefixes(): ReadonlySet<string> {
+  if (_reservedProviderPrefixes) return _reservedProviderPrefixes;
+  const reserved = new Set<string>();
+  for (const entry of Object.values(REGISTRY)) {
+    const record = entry as { id?: unknown; alias?: unknown } | null;
+    if (typeof record?.id === "string" && record.id) reserved.add(record.id.toLowerCase());
+    if (typeof record?.alias === "string" && record.alias) reserved.add(record.alias.toLowerCase());
+  }
+  try {
+    for (const providerId of Object.keys(AI_PROVIDERS)) {
+      if (providerId) reserved.add(providerId.toLowerCase());
+      const alias = (AI_PROVIDERS as Record<string, { alias?: unknown }>)[providerId]?.alias;
+      if (typeof alias === "string" && alias) reserved.add(alias.toLowerCase());
+    }
+  } catch {
+    // A malformed provider table must not make prefix validation unavailable; the
+    // REGISTRY half above still applies.
+  }
+  _reservedProviderPrefixes = reserved;
+  return reserved;
+}
+
+/** Test seam: drop the cached reserved set so a stubbed provider table is re-read. */
+export function resetReservedNodePrefixesForTest(): void {
+  _reservedProviderPrefixes = null;
+}
+
+/**
+ * Validate a prefix an operator wants to claim.
+ *
+ * @param prefix - the candidate, as typed (trimmed here, never mutated for storage)
+ * @param options.existingNodes - current provider_nodes rows, for the duplicate check
+ * @param options.selfNodeId - the node being edited; its own row is not a conflict
+ * @returns null when the prefix is acceptable, otherwise the reason it is not
+ */
+export function validateProviderNodePrefix(
+  prefix: string | null | undefined,
+  options: { existingNodes?: readonly ProviderNodeLike[]; selfNodeId?: string | null } = {}
+): PrefixRejection | null {
+  const raw = typeof prefix === "string" ? prefix.trim() : "";
+  if (!raw) {
+    return { code: "empty", message: "Prefix is required" };
+  }
+  if (raw.length > PREFIX_MAX_LENGTH) {
+    return {
+      code: "too-long",
+      message: `Prefix must be at most ${PREFIX_MAX_LENGTH} characters`,
+    };
+  }
+  if (!PREFIX_SHAPE_RE.test(raw)) {
+    return {
+      code: "shape",
+      message:
+        "Prefix may contain only letters, digits, dot, underscore and hyphen, and must start and end with a letter or digit",
+    };
+  }
+
+  const lower = raw.toLowerCase();
+  if (isSyntheticPrefix(raw)) {
+    return {
+      code: "reserved-synthetic",
+      message: `"${raw}" is reserved for gateway-generated model ids (auto-routing, combos, no-thinking aliases and quota pools) and would capture that whole namespace`,
+    };
+  }
+  if (getReservedNodePrefixes().has(lower)) {
+    return {
+      code: "reserved-provider",
+      message: `"${raw}" is a built-in provider id or alias; a node using it would publish model ids that route to the built-in provider instead, making the node unreachable`,
+    };
+  }
+
+  const selfId = typeof options.selfNodeId === "string" ? options.selfNodeId : null;
+  for (const node of options.existingNodes ?? []) {
+    const nodeId = typeof node?.id === "string" ? node.id : null;
+    if (nodeId && selfId && nodeId === selfId) continue;
+    const existing = typeof node?.prefix === "string" ? node.prefix.trim().toLowerCase() : "";
+    if (existing && existing === lower) {
+      return {
+        code: "duplicate",
+        message: `Prefix "${raw}" is already used by another provider node; only the first node would ever receive requests`,
+        ...(nodeId ? { conflictingNodeId: nodeId } : {}),
+      };
+    }
+  }
+
+  return null;
+}
+
+export type PrefixConflict = {
+  nodeId: string;
+  prefix: string;
+  /** Why this pre-existing row is unusable. */
+  reason: "reserved-provider" | "reserved-synthetic" | "duplicate" | "shape";
+  message: string;
+};
+
+/**
+ * Report pre-existing rows whose prefix is unusable, WITHOUT changing any of them.
+ *
+ * Used by the provider dashboard and startup logging so an operator can see why a node
+ * never receives traffic. Data is left alone deliberately: rewriting a prefix would
+ * change every model id that node has already published, breaking client configs that
+ * pinned them.
+ */
+export function findProviderNodePrefixConflicts(
+  nodes: readonly ProviderNodeLike[]
+): PrefixConflict[] {
+  const conflicts: PrefixConflict[] = [];
+  const seen = new Map<string, string>();
+
+  for (const node of nodes) {
+    const nodeId = typeof node?.id === "string" ? node.id : "";
+    const prefix = typeof node?.prefix === "string" ? node.prefix.trim() : "";
+    if (!nodeId || !prefix) continue;
+    const lower = prefix.toLowerCase();
+
+    const firstHolder = seen.get(lower);
+    if (firstHolder) {
+      conflicts.push({
+        nodeId,
+        prefix,
+        reason: "duplicate",
+        message: `Prefix "${prefix}" is also used by node ${firstHolder}; only that node receives requests for this prefix`,
+      });
+      continue;
+    }
+    seen.set(lower, nodeId);
+
+    // Same order as validateProviderNodePrefix so the two never disagree about a row.
+    if (isSyntheticPrefix(prefix)) {
+      conflicts.push({
+        nodeId,
+        prefix,
+        reason: "reserved-synthetic",
+        message: `Prefix "${prefix}" captures the gateway "${prefix}/…" namespace, so auto-routing, combos, no-thinking aliases or quota models addressed that way reach this node instead`,
+      });
+      continue;
+    }
+    if (getReservedNodePrefixes().has(lower)) {
+      conflicts.push({
+        nodeId,
+        prefix,
+        reason: "reserved-provider",
+        message: `Prefix "${prefix}" shadows the built-in provider "${prefix}"; requests for "${prefix}/…" route to the built-in provider, so this node is unreachable`,
+      });
+      continue;
+    }
+    if (!PREFIX_SHAPE_RE.test(prefix)) {
+      conflicts.push({
+        nodeId,
+        prefix,
+        reason: "shape",
+        message: `Prefix "${prefix}" contains characters that are not valid in a published model id`,
+      });
+    }
+  }
+
+  return conflicts;
+}
