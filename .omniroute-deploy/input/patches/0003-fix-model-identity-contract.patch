diff --git a/tests/unit/provider-identity-resolver.test.ts b/tests/unit/provider-identity-resolver.test.ts
new file mode 100644
index 000000000..27619b66a
--- /dev/null
+++ b/tests/unit/provider-identity-resolver.test.ts
@@ -0,0 +1,165 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+
+import {
+  resolveProviderIdentity,
+  resolveProviderSegment,
+  splitProviderSegment,
+  getPublicProviderPrefix,
+  isPublishableProviderSegment,
+  isSyntheticModelNamespace,
+} from "../../src/shared/providers/identity.ts";
+
+/**
+ * Canonical provider-identity resolver.
+ *
+ * The defect class this replaces: a dozen call sites did `split("/")[0]` and used
+ * segment 0 as a provider *node id*. That holds for exactly one of the five id
+ * shapes the catalog publishes, so every other shape resolved to a provider that
+ * does not exist — and because the api-key gate does this on the inference path,
+ * an advertised id became uncallable, not merely invisible.
+ *
+ * Each test below pins one shape that used to break.
+ */
+
+const NODE_ID = "anthropic-compatible-675899fb-8be4-41a4-8c75-1af39c62b044";
+
+const NODES = [
+  { id: NODE_ID, prefix: "pix4k", type: "anthropic-compatible", name: "Pix4k" },
+  { id: "openai-compatible-chat-1111", prefix: "  ", type: "openai-compatible", name: "NoPrefix" },
+];
+
+// A trimmed stand-in for the registry-derived maps.
+const ALIAS_TO_PROVIDER_ID = {
+  antigravity: "antigravity",
+  ag: "antigravity",
+  codex: "codex",
+  cx: "codex",
+  openai: "openai",
+};
+const PROVIDER_ID_TO_ALIAS = {
+  antigravity: "ag",
+  codex: "cx",
+  openai: "openai",
+};
+
+const OPTS = {
+  nodes: NODES,
+  aliasToProviderId: ALIAS_TO_PROVIDER_ID,
+  providerIdToAlias: PROVIDER_ID_TO_ALIAS,
+};
+
+test("splitProviderSegment splits on the FIRST slash only", () => {
+  // `split("/")[1]` truncated every namespaced model id — openrouter/<vendor>/<model>
+  // lost its tail, which is why such ids could be published but never called back.
+  assert.deepEqual(splitProviderSegment("openrouter/vendor/model-x"), {
+    segment: "openrouter",
+    rest: "vendor/model-x",
+  });
+  assert.deepEqual(splitProviderSegment("gpt-5.6"), { segment: null, rest: "gpt-5.6" });
+  assert.deepEqual(splitProviderSegment("  cx/gpt-5.6  "), { segment: "cx", rest: "gpt-5.6" });
+});
+
+test("a node PREFIX resolves to the node id, not to itself", () => {
+  // The original bug: `pix4k/<model>` was looked up under provider "pix4k", which
+  // is not a key in syncedAvailableModels, so the model read as non-public.
+  const resolved = resolveProviderIdentity("pix4k/claude-opus-5", OPTS);
+  assert.equal(resolved.providerId, NODE_ID, "storage lookups must use the node id");
+  assert.equal(resolved.modelId, "claude-opus-5");
+  assert.equal(resolved.kind, "nodePrefix");
+});
+
+test("a raw node id still resolves (combo steps store this shape)", () => {
+  const resolved = resolveProviderIdentity(`${NODE_ID}/claude-opus-5`, OPTS);
+  assert.equal(resolved.providerId, NODE_ID);
+  assert.equal(resolved.modelId, "claude-opus-5");
+  assert.equal(resolved.kind, "nodeId");
+});
+
+test("a registry alias resolves to the canonical provider id", () => {
+  // `cx/gpt-5.6` is the id the catalog publishes by default (dual prefix mode), so
+  // a client copying it verbatim must not be denied.
+  const byAlias = resolveProviderIdentity("cx/gpt-5.6", OPTS);
+  assert.equal(byAlias.providerId, "codex");
+  assert.equal(byAlias.kind, "alias");
+
+  const byId = resolveProviderIdentity("codex/gpt-5.6", OPTS);
+  assert.equal(byId.providerId, "codex");
+  assert.equal(byId.kind, "providerId", "an already-canonical segment is not an alias");
+});
+
+test("a bare model id yields no provider rather than a bogus one", () => {
+  // Inference is a routing policy, not an identity fact — the resolver must not
+  // invent a provider. The old code produced shortModelId "" and denied outright.
+  const resolved = resolveProviderIdentity("gpt-5.6", OPTS);
+  assert.equal(resolved.providerId, null);
+  assert.equal(resolved.modelId, "gpt-5.6");
+});
+
+test("synthetic namespaces follow only their documented identity shapes", () => {
+  assert.ok(isSyntheticModelNamespace("no-think"));
+  assert.ok(isSyntheticModelNamespace("qtSd"));
+  assert.ok(!isSyntheticModelNamespace("pix4k"));
+
+  // `no-think/pix4k/<model>` must resolve to the pix4k node, NOT to "no-think".
+  assert.deepEqual(resolveProviderIdentity("no-think/pix4k/claude-opus-5", OPTS), {
+    providerId: NODE_ID,
+    modelId: "claude-opus-5",
+    kind: "nodePrefix",
+  });
+
+  // qtSd has one non-provider slug between the namespace and the real provider.
+  assert.deepEqual(resolveProviderIdentity("qtSd/group/cx/gpt-5.6", OPTS), {
+    providerId: "codex",
+    modelId: "gpt-5.6",
+    kind: "alias",
+  });
+
+  // auto/combo payloads are routing identities, not an implicit provider wrapper.
+  assert.deepEqual(resolveProviderIdentity("auto/cx/gpt-5.6", OPTS), {
+    providerId: "auto",
+    modelId: "cx/gpt-5.6",
+    kind: "synthetic",
+  });
+  assert.deepEqual(resolveProviderIdentity("combo/cx/gpt-5.6", OPTS), {
+    providerId: "combo",
+    modelId: "cx/gpt-5.6",
+    kind: "synthetic",
+  });
+
+  const bare = resolveProviderSegment("auto", OPTS);
+  assert.equal(bare.kind, "synthetic");
+});
+
+test("a built-in id/alias wins over a colliding node prefix", () => {
+  // A node whose prefix shadows a built-in must not hijack it. Prefix collisions
+  // are rejected at write time, but pre-existing rows and direct-DB edits exist.
+  const hijacker = [{ id: "openai-compatible-chat-9999", prefix: "openai" }];
+  const resolved = resolveProviderSegment("openai", { ...OPTS, nodes: hijacker });
+  assert.equal(resolved.providerId, "openai");
+  assert.equal(resolved.kind, "providerId");
+});
+
+test("an unknown segment passes through unchanged", () => {
+  const resolved = resolveProviderSegment("totally-unknown", OPTS);
+  assert.equal(resolved.providerId, "totally-unknown");
+  assert.equal(resolved.kind, "unknown");
+});
+
+test("getPublicProviderPrefix prefers node prefix, then alias, then the id", () => {
+  assert.equal(getPublicProviderPrefix(NODE_ID, OPTS), "pix4k", "operator prefix wins");
+  assert.equal(getPublicProviderPrefix("codex", OPTS), "cx", "registry alias next");
+  assert.equal(
+    getPublicProviderPrefix("openai-compatible-chat-1111", OPTS),
+    "openai-compatible-chat-1111",
+    "a blank prefix must not publish an empty segment; fall back to the id"
+  );
+});
+
+test("isPublishableProviderSegment rejects raw compatible-node ids", () => {
+  // A raw UUID node id is a storage detail. Clients group by the segment and
+  // render it verbatim, so leaking it produced UUID-named pseudo-providers.
+  assert.ok(!isPublishableProviderSegment(NODE_ID));
+  assert.ok(isPublishableProviderSegment("pix4k"));
+  assert.ok(isPublishableProviderSegment("cx"));
+});
