+++ b/tests/unit/single-public-prefix-contract.test.ts
@@ -0,0 +1,452 @@
+/**
+ * tests/unit/single-public-prefix-contract.test.ts
+ *
+ * Full matrix for the single routable public-prefix contract (catalog.ts
+ * `resolvePublicPrefix`). Precedence:
+ *   1. operator node prefix wins;
+ *   2. else canonical registry id — only when `${id}/x` round-trips through
+ *      parseModel to that provider AND the noauth policy permits it;
+ *   3. else the routable alias.
+ *
+ * Legacy aliases stay INBOUND-callable but must never create a second catalog
+ * identity. no-think is inbound-only. Effort variants inherit the base's
+ * published prefix. Combo rows (owned_by:"combo") never go through prefix logic.
+ *
+ * Mandatory focused gate (run together):
+ *   - this file
+ *   - tests/unit/image-model-not-in-chat-catalog-6457.test.ts  (G: responses+image same-id)
+ *   - tests/unit/models-catalog-exact-dup-4424.test.ts          (dedupe contract)
+ */
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+const TEST_DATA_DIR = fs.mkdtempSync(path.join(os.tmpdir(), "omni-single-prefix-"));
+process.env.DATA_DIR = TEST_DATA_DIR;
+process.env.API_KEY_SECRET = process.env.API_KEY_SECRET || "single-prefix-test-secret";
+
+const core = await import("../../src/lib/db/core.ts");
+const providersDb = await import("../../src/lib/db/providers.ts");
+const combosDb = await import("../../src/lib/db/combos.ts");
+const apiKeysDb = await import("../../src/lib/db/apiKeys.ts");
+const v1ModelsCatalog = await import("../../src/app/api/v1/models/catalog.ts");
+const providerScopedRoute = await import("../../src/app/api/v1/providers/[provider]/models/route.ts");
+const { parseModel } = await import("../../open-sse/services/model.ts");
+const { buildAliasMaps } = await import("../../src/app/api/v1/models/catalogProviderMaps.ts");
+const { NOAUTH_PROVIDERS } = await import("../../src/shared/constants/providers/noauth.ts");
+const { appendSyncedEffortVariants } = await import("../../open-sse/utils/syncedEffortVariants.ts");
+const { resolveResponsesApiModel } = await import(
+  "../../src/app/api/internal/codex-responses-ws/modelResolution.ts"
+);
+
+type Entry = { id?: unknown; owned_by?: unknown; root?: unknown; [k: string]: unknown };
+type CatalogBody = { data?: Entry[] };
+
+// ── helpers ──────────────────────────────────────────────────────────────────
+
+async function resetStorage() {
+  core.resetDbInstance();
+  apiKeysDb.resetApiKeyState();
+  fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true });
+  fs.mkdirSync(TEST_DATA_DIR, { recursive: true });
+  v1ModelsCatalog.__resetCatalogBuilderRunsForTest();
+}
+
+async function seedConnection(provider: string) {
+  return providersDb.createProviderConnection({
+    provider,
+    authType: "apikey",
+    name: `${provider}-sp`,
+    apiKey: "sk-test",
+    accessToken: null,
+    isActive: true,
+    testStatus: "active",
+    providerSpecificData: {},
+  });
+}
+
+async function listEntries(): Promise<Entry[]> {
+  const res = await v1ModelsCatalog.getUnifiedModelsResponse(
+    new Request("http://localhost/api/v1/models")
+  );
+  assert.equal(res.status, 200);
+  return ((await res.json()) as CatalogBody).data ?? [];
+}
+
+async function listIds(): Promise<string[]> {
+  return (await listEntries())
+    .map((e) => e.id)
+    .filter((v): v is string => typeof v === "string" && v.length > 0);
+}
+
+const byPrefix = (ids: string[], pre: string) => ids.filter((i) => i.startsWith(`${pre}/`));
+const effortRe = /-(low|medium|high|max|min|xhigh|extra-low|extra-high)$/;
+
+test.beforeEach(async () => { await resetStorage(); });
+test.after(async () => {
+  core.resetDbInstance();
+  apiKeysDb.resetApiKeyState();
+  fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true });
+});
+
+// ── A. Fragmenting providers: exact-one identity + no alias/canonical siblings ─
+
+test("A: codex antigravity kiro ollama-cloud each publish canonical only, zero alias siblings", async () => {
+  for (const p of ["codex", "antigravity", "kiro", "ollama-cloud"]) await seedConnection(p);
+  const ids = await listIds();
+
+  const pairs: Array<[string, string]> = [
+    ["codex", "cx"],
+    ["antigravity", "ag"],
+    ["kiro", "kr"],
+    ["ollama-cloud", "ollamacloud"],
+  ];
+
+  for (const [canon, alias] of pairs) {
+    const canonRows = byPrefix(ids, canon).filter((i) => !effortRe.test(i));
+    const aliasRows = byPrefix(ids, alias);
+    assert.ok(
+      canonRows.length > 0,
+      `${canon}: expected canonical rows to be published, got 0`
+    );
+    assert.equal(
+      aliasRows.length,
+      0,
+      `${alias}: alias sibling rows must not exist, got ${JSON.stringify(aliasRows.slice(0, 3))}`
+    );
+  }
+});
+
+// ── B. opencode: oc/ nonzero, opencode/ is NOT free OpenCode, opencode-zen distinct ─
+
+test("B: opencode publishes under oc/ only; opencode/ and opencode-zen stay separate", async () => {
+  const ids = await listIds();
+  const ocRows = byPrefix(ids, "oc");
+  const opencodeRows = byPrefix(ids, "opencode");
+  const zenRows = byPrefix(ids, "opencode-zen");
+
+  assert.ok(ocRows.length > 0, "oc/ must have rows (free OpenCode publishes via its alias)");
+  assert.equal(
+    opencodeRows.length,
+    0,
+    `opencode/ canonical rows must not appear (slug-hijacked to opencode-zen): ${JSON.stringify(opencodeRows.slice(0, 3))}`
+  );
+  for (const id of zenRows) {
+    assert.ok(!ocRows.includes(id), `${id} must not collide with a free-opencode oc/ id`);
+  }
+  assert.equal(parseModel("opencode/__p__").provider, "opencode-zen", "opencode/ slug routes to opencode-zen");
+  assert.equal(parseModel("oc/__p__").provider, "opencode", "oc/ routes to opencode");
+  assert.notEqual(parseModel("oc/__p__").provider, parseModel("opencode/__p__").provider);
+});
+
+// ── C. Owner-aware: every emitted slash-id routes to its owned_by provider ─
+
+test("C: every emitted slash-id routes back to its owned_by provider (owner-aware, all rows)", async () => {
+  for (const p of ["codex", "antigravity", "kiro", "ollama-cloud"]) await seedConnection(p);
+  const entries = await listEntries();
+
+  const offenders: string[] = [];
+  let checked = 0;
+
+  for (const entry of entries) {
+    const id = typeof entry.id === "string" ? entry.id : "";
+    const owner = typeof entry.owned_by === "string" ? entry.owned_by : "";
+    if (!id.includes("/")) continue; // bare ids (combo names, native) are not prefixed
+    if (owner === "combo") continue; // combo rows never go through prefix logic
+    if (!owner) continue; // rows without an owner cannot be checked
+    checked++;
+    const got = parseModel(id).provider;
+    if (got !== owner) {
+      offenders.push(`id="${id}" owned_by="${owner}" parseModel→"${got}"`);
+    }
+  }
+
+  assert.ok(checked > 20, `expected broad coverage, only checked ${checked} slash-id rows`);
+  assert.deepEqual(offenders, [], `owner-aware round-trip failures:\n  ${offenders.join("\n  ")}`);
+});
+
+// ── D. Eight non-opencode noauth providers not broadened ─
+
+test("D: eight non-opencode noauth providers gain zero chat-shaped canonical-prefix rows", async () => {
+  // Source of truth: NOAUTH_PROVIDERS (9 entries) minus opencode (which publishes oc/).
+  const noauthCanonical = Object.keys(NOAUTH_PROVIDERS).filter((id) => id !== "opencode");
+  assert.equal(noauthCanonical.length, 8, `expected exactly 8 non-opencode noauth providers, got ${noauthCanonical.length}: ${noauthCanonical.join(", ")}`);
+
+  // Modality (non-chat) registries — video/image/audio/etc. — publish under the
+  // canonical provider id directly and are OUT OF SCOPE for the chat prefix contract.
+  // Only chat-shaped rows (untyped or type:"chat") count as "broadened".
+  const MODALITY_TYPES = new Set(["video", "image", "audio", "embedding", "rerank", "moderation", "music"]);
+
+  const entries = await listEntries();
+  const broadened: string[] = [];
+  for (const canon of noauthCanonical) {
+    const chatRows = entries.filter((e) => {
+      const id = String(e.id ?? "");
+      if (!id.startsWith(`${canon}/`)) return false;
+      const type = String(e.type ?? "chat");
+      return !MODALITY_TYPES.has(type);
+    });
+    if (chatRows.length > 0) broadened.push(`${canon}: ${JSON.stringify(chatRows.slice(0, 2).map((e) => ({ id: e.id, type: e.type })))}`);
+  }
+  assert.deepEqual(broadened, [], `noauth providers must not gain chat-shaped canonical rows:\n  ${broadened.join("\n  ")}`);
+});
+
+// ── E. Effort variants inherit published prefix; oc/ never rewritten ─
+
+test("E: effort variants carry their base's prefix; oc/ base never rewritten to opencode/", async () => {
+  await seedConnection("antigravity");
+  const ids = await listIds();
+
+  const agEffort = ids.filter((i) => i.startsWith("antigravity/") && effortRe.test(i));
+  assert.ok(agEffort.length > 0, `expected antigravity effort variants, got none; sample: ${JSON.stringify(ids.slice(0, 5))}`);
+  for (const id of agEffort) {
+    assert.ok(!id.startsWith("ag/"), `effort variant must not be rewritten to alias prefix: ${id}`);
+  }
+
+  const opencodeEffort = ids.filter((i) => i.startsWith("opencode/") && effortRe.test(i));
+  assert.equal(opencodeEffort.length, 0, `opencode/ effort rows must not exist: ${JSON.stringify(opencodeEffort)}`);
+});
+
+test("E (unit): appendSyncedEffortVariants preserves an oc/ base prefix verbatim — never rewrites to opencode/", () => {
+  // Direct synthetic test: pass an oc/-prefixed base entry through the synced effort
+  // variant generator. appendSyncedEffortVariants builds variantId = `${model.id}-${tier}`
+  // and never consults any alias map, so the oc/ prefix must survive unchanged.
+  const base: Record<string, unknown> = {
+    id: "oc/mimo-v2.5-free",
+    owned_by: "opencode",
+    root: "mimo-v2.5-free",
+    capabilities: { effort_tiers: ["low", "high"] },
+  };
+  const out = appendSyncedEffortVariants([base as never]) as Array<Record<string, unknown>>;
+  const variantIds = out.map((m) => String(m.id));
+  assert.ok(variantIds.includes("oc/mimo-v2.5-free-low"), `expected oc/mimo-v2.5-free-low in ${JSON.stringify(variantIds)}`);
+  assert.ok(variantIds.includes("oc/mimo-v2.5-free-high"), `expected oc/mimo-v2.5-free-high in ${JSON.stringify(variantIds)}`);
+  assert.equal(
+    variantIds.filter((i) => i.startsWith("opencode/")).length,
+    0,
+    `no variant may be rewritten to opencode/: ${JSON.stringify(variantIds)}`
+  );
+});
+
+// ── F. Combo shadow + bare-model inbound compatibility ─
+
+test("F: combo row appears bare in catalog; bare-model and combo inbound routing both preserved", async () => {
+  await seedConnection("codex");
+  await combosDb.createCombo({
+    name: "gpt-5.5",
+    description: "single-prefix combo shadow probe",
+    steps: [{ provider: "codex", model: "codex/gpt-5.5", temperature: 0.7 }],
+    isActive: true,
+  });
+
+  const entries = await listEntries();
+  const ids = entries.map((e) => String(e.id ?? ""));
+
+  // Combo row is present and bare (owned_by:"combo", no prefix).
+  const comboRow = entries.find((e) => e.id === "gpt-5.5" && e.owned_by === "combo");
+  assert.ok(comboRow, `combo "gpt-5.5" (owned_by:combo) must appear; ids: ${JSON.stringify(ids.filter((i) => i.includes("gpt-5.5")))}`);
+  assert.ok(!String(comboRow!.id).includes("/"), `combo id must be bare, got "${comboRow!.id}"`);
+
+  // The prefixed model row coexists — combo never displaces it.
+  assert.ok(ids.some((i) => i.startsWith("codex/") && i.includes("gpt-5.5")), "codex/gpt-5.5 model row must coexist");
+
+  // Inbound: a bare combo name must NOT be rewritten to codex/ (combo routing path).
+  // `resolveResponsesApiModel` expects a getModelInfo-style async resolver; parseModel
+  // is the synchronous parse, so adapt it to the ResolvedModelInfo shape it consumes.
+  const resolver = async (modelStr: string) => parseModel(modelStr);
+  const isCombo = async (name: string) => name === "gpt-5.5";
+  const comboOut = await resolveResponsesApiModel("gpt-5.5", resolver, isCombo);
+  assert.equal(comboOut.changed, false, `bare combo "gpt-5.5" must not be codex-prefixed`);
+  assert.equal(comboOut.model, "gpt-5.5");
+
+  // Inbound: a bare model id (not a combo) IS rewritten to codex/ (bare-model compat path).
+  const isNotCombo = async () => false;
+  const modelOut = await resolveResponsesApiModel("gpt-5.5", resolver, isNotCombo);
+  assert.equal(modelOut.changed, true, "bare model id must be codex-prefixed when not a combo");
+  assert.equal(modelOut.model, "codex/gpt-5.5");
+});
+
+// ── G. Provider-scoped selector + cross-surface (responses+image) same-id survival ─
+
+test("G: provider-scoped endpoint returns bare ids including gpt-5.6-sol; responses+image surfaces coexist (see image-6457)", async () => {
+  await seedConnection("codex");
+  // Seed gpt-5.6-sol with responses endpoint so it appears in the synced catalog.
