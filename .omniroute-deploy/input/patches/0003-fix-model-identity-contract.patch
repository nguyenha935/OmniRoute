+
+// ── quota-exclusive keys: hidden qtSd/* combos must survive (#4806) ──────────
+//
+// Every qtSd/* combo is auto-minted with isHidden: true. `/v1/models` builds the quota
+// catalog from the RAW combo list (buildQuotaExclusiveModels), deliberately skipping
+// listability — so a quota-exclusive key sees the pool's models there. The combo listing
+// must select from the raw list too; running filterListableCombos first would drop the
+// hidden quota combos and hand the key an empty listing while /v1/models still advertised
+// them. The expected set is derived from buildQuotaExclusiveModels itself, so these tests
+// prove EXACT parity with the /v1/models quota contract rather than a hand-written list.
+
+const OUT_OF_SCOPE_COMBO = "qtSd/othergroup/codex/gpt-5.5";
+const REGULAR_COMBO = "regular-combo";
+
+/**
+ * Seed a quota pool deterministically: write the minimal pool rows directly (in one
+ * transaction) and run syncQuotaCombos ONCE, awaited. createPool is deliberately NOT used —
+ * it fires a fire-and-forget sync hook, so combining it with an awaited sync would leave two
+ * concurrent sync owners racing at getComboByName/createCombo (the UNIQUE(name) warning).
+ * group-demo ('GroupDemo') is seeded by migration 088 → groupSlug "groupdemo".
+ */
+async function seedQuotaScope(): Promise<string> {
+  const conn = await providersDb.createProviderConnection({
+    provider: "codex",
+    authType: "apikey",
+    name: "quota-combo-policy-conn",
+    apiKey: "sk-test-quota-combo-policy",
+  });
+  const connId = (conn as Record<string, unknown>).id as string;
+
+  const poolId = randomUUID();
+  const now = new Date().toISOString();
+  const db = core.getDbInstance();
+  const seedPool = db.transaction(() => {
+    db.prepare(
+      "INSERT INTO quota_pools (id, connection_id, name, group_id, created_at) VALUES (?, ?, ?, ?, ?)"
+    ).run(poolId, connId, "Combo Policy Pool", "group-demo", now);
+    db.prepare(
+      "INSERT INTO quota_pool_connections (pool_id, connection_id, created_at) VALUES (?, ?, ?)"
+    ).run(poolId, connId, now);
+  });
+  seedPool();
+
+  // The single sync owner. Mints one hidden qtSd/groupdemo/codex/<model> combo per codex
+  // REGISTRY model — the same raw-combo set /v1/models publishes for the key.
+  await syncQuotaCombos(poolId);
+  return poolId;
+}
+
+async function seedQuotaCombos() {
+  // A different group's quota combo — outside this key's scope.
+  await combosDb.createCombo({
+    name: OUT_OF_SCOPE_COMBO,
+    strategy: "quota-share",
+    isHidden: true,
+    models: [{ kind: "model", model: "codex/gpt-5.5", providerId: "codex" }],
+  });
+  // A normal visible combo — a quota-exclusive key must NOT see it.
+  await combosDb.createCombo({
+    name: REGULAR_COMBO,
+    strategy: "priority",
+    models: [{ kind: "model", model: "codex/gpt-5.6-sol-high", providerId: "codex" }],
+  });
+}
+
+/**
+ * The exact set `/v1/models` publishes for this quota-exclusive key — derived from the same
+ * buildQuotaExclusiveModels the catalog calls, sorted for stable comparison.
+ */
+async function expectedQuotaIds(poolId: string): Promise<string[]> {
+  const all = (await combosDb.getCombos()) as ComboRow[];
+  const catalog = await buildQuotaExclusiveModels([poolId], all, 0, () => ({}));
+  return catalog.map((model) => String(model.id)).sort();
+}
+
+/** The contract every quota listing must satisfy: exact parity + scope + exclusions. */
+function assertQuotaContract(expectedIds: string[], actualNames: string[]) {
+  assert.ok(expectedIds.length > 0, "the real pool fixture must auto-mint in-scope quota combos");
+  assert.ok(
+    expectedIds.every((id) => id.startsWith("qtSd/groupdemo/")),
+    "every expected combo must be in this pool's group scope"
+  );
+  // Exact parity with the /v1/models quota contract.
+  assert.deepEqual(actualNames, expectedIds);
+  // The out-of-scope quota combo and the non-quota combo must never leak into the listing.
+  assert.equal(actualNames.includes(OUT_OF_SCOPE_COMBO), false, "out-of-scope combo excluded");
+  assert.equal(actualNames.includes(REGULAR_COMBO), false, "non-quota combo excluded");
+}
+
+test("filterCombosForApiKey: a quota-exclusive key gets exactly the catalog's quota combos", async () => {
+  const poolId = await seedQuotaScope();
+  await seedQuotaCombos();
+  const key = await apiKeysDb.createApiKey("quota-helper", "machine-quota-helper");
+  await apiKeysDb.updateApiKeyPermissions(key.id, { allowedQuotas: [poolId] });
+
+  const all = (await combosDb.getCombos()) as ComboRow[];
+  const actual = (await filterCombosForApiKey(all, key.key))
+    .map((c: ComboRow) => String(c.name))
+    .sort();
+  assertQuotaContract(await expectedQuotaIds(poolId), actual);
+});
+
+test("/v1/combos: a quota-exclusive key's listing matches the quota catalog exactly", async () => {
+  const poolId = await seedQuotaScope();
+  await seedQuotaCombos();
+  const key = await apiKeysDb.createApiKey("quota-route", "machine-quota-route");
+  await apiKeysDb.updateApiKeyPermissions(key.id, { allowedQuotas: [poolId] });
+
+  const response = await combosRoute.GET(bearerRequest("http://localhost/v1/combos", key.key));
+  const body = (await response.json()) as ListBody;
+
+  assert.equal(response.status, 200);
+  // Was empty before the fix: filterListableCombos ran first and dropped the hidden combos.
+  assertQuotaContract(await expectedQuotaIds(poolId), comboNames(body));
+});
+
+test("vscode [token]/combos: a quota-exclusive key's listing matches the quota catalog exactly", async () => {
+  const poolId = await seedQuotaScope();
+  await seedQuotaCombos();
+  const key = await apiKeysDb.createApiKey("quota-vscode", "machine-quota-vscode");
+  await apiKeysDb.updateApiKeyPermissions(key.id, { allowedQuotas: [poolId] });
+
+  const response = await vscodeCombosRoute.GET(
+    new Request(`http://localhost/api/v1/vscode/${encodeURIComponent(key.key)}/combos`),
+    { params: { token: key.key } }
+  );
+  const body = (await response.json()) as ListBody;
+
+  assert.equal(response.status, 200);
+  assertQuotaContract(await expectedQuotaIds(poolId), comboNames(body));
+});
diff --git a/tests/unit/combo-target-node-prefix.test.ts b/tests/unit/combo-target-node-prefix.test.ts
