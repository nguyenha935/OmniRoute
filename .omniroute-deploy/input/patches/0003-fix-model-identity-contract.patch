+
+/**
+ * Apply the per-API-key policy to a combo listing, the same policy `/v1/models` enforces.
+ *
+ * WHY THIS EXISTS
+ * ---------------
+ * `GET /v1/models` scopes the catalog to what the requesting key may use (quota-exclusive
+ * pools, the `blocked_models` deny-list, the `allowed_combos` allow-list), but the endpoints
+ * that list combos directly — `/v1/combos` and both VS Code `…/combos` routes — only applied
+ * `filterListableCombos`. A key could therefore SEE combos it is not allowed to CALL: the
+ * same "visible in one place, blocked in another" split this module exists to prevent.
+ *
+ * Callers pass the ORIGINAL combo list (straight from `getCombos()`), NOT a pre-filtered one:
+ * the quota branch must run BEFORE listability. Every `qtSd/*` combo is auto-minted hidden,
+ * so filtering for listability first would drop them all and hand a quota-exclusive key an
+ * empty listing while `/v1/models` still advertised the pool (#4806). The branches mirror
+ * `catalog.ts` exactly so the two surfaces cannot drift:
+ *  - no key (anonymous, or a dashboard session) → listable combos, no per-key scoping;
+ *  - quota-exclusive key (`allowedQuotas` non-empty) → the pool's `qtSd/*` combos selected
+ *    from the raw list by the same `selectQuotaPoolCombos` the catalog uses (hidden included);
+ *  - env-var master key (valid key, no DB metadata row) → listable combos, no restrictions;
+ *  - any other key → listable combos, minus the `blocked_models` deny-list, then enforcing a
+ *    non-empty `allowed_combos` allow-list through the same `isComboAllowedByKeyRules` the
+ *    request path and the catalog share. A combo's public identifier is its `name`.
+ *
+ * The policy lookups are imported dynamically (as `catalog.ts` does) so this module never
+ * takes a static dependency on the API-key/quota layer.
+ */
+export async function filterCombosForApiKey<T extends ComboLike>(
+  combos: readonly T[],
+  apiKey: string | null | undefined
+): Promise<T[]> {
+  if (!Array.isArray(combos) || combos.length === 0) return [];
+
+  // No key (anonymous read with REQUIRE_API_KEY=false, or a dashboard session): the catalog
+  // applies no per-key scoping either, so the listing is just the listable combos.
+  if (!apiKey) return filterListableCombos(combos);
+
+  const { getApiKeyMetadata, isModelBlockedForKey } = await import("@/lib/db/apiKeys");
+  const keyMeta = await getApiKeyMetadata(apiKey);
+
+  if (keyMeta && keyMeta.allowedQuotas && keyMeta.allowedQuotas.length > 0) {
+    // Quota BEFORE listability: select from the raw list so hidden qtSd/* combos survive.
+    const { selectQuotaPoolCombos } = await import("@/lib/quota/quotaCombos");
+    return selectQuotaPoolCombos(keyMeta.allowedQuotas, combos);
+  }
+
+  // From here on the listing is the listable combos, narrowed by the key's rules.
+  const listable = await filterListableCombos(combos);
+
+  // Valid key with no DB metadata row = env-var master key: auth gates access but does not
+  // scope the listing (same as the catalog's `!keyMeta` branch).
+  if (!keyMeta) return listable;
+
+  const { isComboAllowedByKeyRules } = await import("@/shared/utils/apiKeyPolicy");
+  const filtered: T[] = [];
+  for (const combo of listable) {
+    const name = typeof combo.name === "string" ? combo.name : "";
+    if (await isModelBlockedForKey(apiKey, name)) continue;
+    // Empty `allowed_combos` = no combo restriction; a non-empty list must name the combo.
+    if (keyMeta.allowedCombos?.length && !isComboAllowedByKeyRules(keyMeta.allowedCombos, name)) {
+      continue;
+    }
+    filtered.push(combo);
+  }
+  return filtered;
+}
