+/**
+ * Provider-node prefix policy.
+ *
+ * Create and update validation reserve the union of runtime built-in names and the
+ * wider public/configuration provider-name surface. Existing rows are reported without
+ * changing their published ids. These tests exercise both write anchors and the legacy
+ * reporting path without relying on provider counts or historical routing probes.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+const TEST_DATA_DIR = fs.mkdtempSync(path.join(os.tmpdir(), "omniroute-node-prefix-"));
+process.env.DATA_DIR = TEST_DATA_DIR;
+process.env.API_KEY_SECRET = process.env.API_KEY_SECRET || "node-prefix-test-secret";
+
+const coreDb = await import("../../src/lib/db/core.ts");
+const nodesDb = await import("../../src/lib/db/providers/nodes.ts");
+const readCache = await import("../../src/lib/db/readCache.ts");
+const modelSvc = await import("../../src/sse/services/model.ts");
+const nodesRoute = await import("../../src/app/api/provider-nodes/route.ts");
+const nodeIdRoute = await import("../../src/app/api/provider-nodes/[id]/route.ts");
+const { validateProviderNodePrefix, findProviderNodePrefixConflicts, getReservedNodePrefixes } =
+  await import("../../src/shared/providers/nodePrefix.ts");
+const { REGISTRY } = await import("../../open-sse/config/providerRegistry.ts");
+const { AI_PROVIDERS } = await import("../../src/shared/constants/providers.ts");
+const { SYNTHETIC_MODEL_NAMESPACES } = await import("../../src/shared/providers/identity.ts");
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+
+async function resetStorage() {
+  coreDb.resetDbInstance();
+  for (let attempt = 0; attempt < 10; attempt++) {
+    try {
+      if (fs.existsSync(TEST_DATA_DIR)) fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true });
+      break;
+    } catch (error: unknown) {
+      const err = error as NodeJS.ErrnoException;
+      if ((err?.code === "EBUSY" || err?.code === "EPERM") && attempt < 9) {
+        await new Promise((resolve) => setTimeout(resolve, 50 * (attempt + 1)));
+      } else {
+        throw error;
+      }
+    }
+  }
+  fs.mkdirSync(TEST_DATA_DIR, { recursive: true });
+  readCache.invalidateDbCache?.();
+}
+
+const BASE_NODE = {
+  type: "openai-compatible" as const,
+  apiType: "chat" as const,
+  baseUrl: "https://node.example/v1",
+  name: "Test Node",
+};
+
+async function createViaRoute(prefix: string, overrides: Record<string, unknown> = {}) {
+  const response = await nodesRoute.POST(
+    new Request("http://localhost/api/provider-nodes", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ ...BASE_NODE, prefix, ...overrides }),
+    }) as never
+  );
+  const body = (await response.json()) as {
+    node?: { id?: string; prefix?: string };
+    error?: { code?: string; message?: string };
+  };
+  return { status: response.status, body };
+}
+
+async function updateViaRoute(id: string, prefix: string) {
+  const response = await nodeIdRoute.PUT(
+    new Request(`http://localhost/api/provider-nodes/${id}`, {
+      method: "PUT",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ ...BASE_NODE, prefix }),
+    }) as never,
+    { params: Promise.resolve({ id }) }
+  );
+  const body = (await response.json()) as { error?: { code?: string } };
+  return { status: response.status, body };
+}
+
+/** Write a row straight to the DB, bypassing the route — a pre-fix / legacy node. */
+async function seedLegacyNode(id: string, prefix: string) {
+  await nodesDb.createProviderNode({
+    id,
+    type: "openai-compatible",
+    name: `legacy-${prefix}`,
+    prefix,
+    apiType: "chat",
+    baseUrl: "https://legacy.example/v1",
+  } as never);
+  readCache.invalidateDbCache?.();
+}
+
+test.beforeEach(async () => {
+  await resetStorage();
+});
+
+test.after(async () => {
+  coreDb.resetDbInstance();
+  fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true });
+});
+
+// ---------------------------------------------------------------------------
+// Reserved set policy — runtime names plus the wider public/configuration surface
+// ---------------------------------------------------------------------------
+
+function findPublicOnlyProviderName(): string {
+  const runtimeNames = new Set<string>();
+  for (const entry of Object.values(REGISTRY)) {
+    if (typeof entry?.id === "string") runtimeNames.add(entry.id.toLowerCase());
+    if (typeof entry?.alias === "string") runtimeNames.add(entry.alias.toLowerCase());
+  }
+
+  const publicOnly = Object.keys(AI_PROVIDERS).find(
+    (providerId) =>
+      !runtimeNames.has(providerId.toLowerCase()) && !SYNTHETIC_MODEL_NAMESPACES.has(providerId)
+  );
+  assert.ok(publicOnly, "AI_PROVIDERS must contribute a name beyond the runtime guard");
+  return publicOnly;
+}
+
+test("the create/edit reserved set includes runtime names and the wider public provider surface", () => {
+  const reserved = getReservedNodePrefixes();
+  const runtimeName = Object.values(REGISTRY).find(
+    (entry) => typeof entry?.id === "string" || typeof entry?.alias === "string"
+  );
+  const exactRuntimeName = runtimeName?.id || runtimeName?.alias;
+  assert.ok(exactRuntimeName, "REGISTRY must expose at least one built-in name");
+  assert.ok(reserved.has(exactRuntimeName.toLowerCase()));
+
+  const publicOnly = findPublicOnlyProviderName();
+  assert.ok(reserved.has(publicOnly.toLowerCase()));
+  assert.equal(validateProviderNodePrefix(publicOnly)?.code, "reserved-provider");
+});
+
+// ---------------------------------------------------------------------------
+// Creation is blocked
+// ---------------------------------------------------------------------------
+
+test("creating a node whose prefix shadows a built-in provider is rejected", async () => {
+  for (const prefix of ["openai", "vllm", "lm-studio", "zed"]) {
+    const { status, body } = await createViaRoute(prefix);
+    assert.equal(status, 400, `"${prefix}" must be refused`);
+    assert.equal(body.error?.code, "reserved-provider");
+  }
+});
+
+test("creating a node whose prefix captures a synthetic namespace is rejected", async () => {
+  for (const prefix of ["auto", "combo", "no-think", "qtSd"]) {
+    const { status, body } = await createViaRoute(prefix);
+    assert.equal(status, 400, `"${prefix}" must be refused`);
+    assert.equal(
+      body.error?.code,
+      "reserved-synthetic",
+      `"${prefix}" must be refused as a synthetic namespace, not by shape`
+    );
+  }
+  // Case-folded too: the namespace set itself is mixed-case ("qtSd"), so a lowercase
+  // spelling must not slip through.
+  const lowered = await createViaRoute("qtsd");
+  assert.equal(lowered.body.error?.code, "reserved-synthetic");
+});
+
+test("a duplicate prefix is rejected, case-insensitively", async () => {
+  const first = await createViaRoute("mynode");
+  assert.equal(first.status, 201, "the first claim succeeds");
+
+  const second = await createViaRoute("mynode");
+  assert.equal(second.status, 400);
+  assert.equal(second.body.error?.code, "duplicate");
+
+  const casedVariant = await createViaRoute("MyNode");
+  assert.equal(
+    casedVariant.body.error?.code,
+    "duplicate",
+    "a differently-cased spelling would compete for the same ids"
+  );
+});
+
+test("malformed prefixes are rejected but ordinary and mixed-case ones are accepted", async () => {
+  for (const bad of ["has space", "a/b", "-lead", "trail-", "with?q"]) {
+    const { status, body } = await createViaRoute(bad);
+    assert.equal(status, 400, `"${bad}" must be refused`);
+    assert.equal(body.error?.code, "shape", `"${bad}" should fail on shape`);
+  }
+  // An empty prefix is already caught upstream by the Zod schema ("Prefix is required"),
+  // which reports a field issue rather than one of this validator's codes.
+  const empty = await createViaRoute("");
+  assert.equal(empty.status, 400, "an empty prefix is still refused");
+  // Mixed case IS valid: segment resolution is case-sensitive, so an uppercase prefix
+  // routes fine, and refusing it would lock existing nodes out of the edit form.
+  const ok = await createViaRoute("Pix4K");
+  assert.equal(ok.status, 201, `expected Pix4K to be accepted; got ${JSON.stringify(ok.body)}`);
+  assert.equal(ok.body.node?.prefix, "Pix4K", "the prefix is stored verbatim, not lowercased");
+});
+
+// ---------------------------------------------------------------------------
+// Editing is blocked the same way, but a no-op re-save is not a self-collision
+// ---------------------------------------------------------------------------
+
+test("POST and PUT enforce the same wider reserved-prefix policy", async () => {
+  const publicOnly = findPublicOnlyProviderName();
+  const rejectedCreate = await createViaRoute(publicOnly);
+  assert.equal(rejectedCreate.status, 400);
+  assert.equal(rejectedCreate.body.error?.code, "reserved-provider");
+
+  const created = await createViaRoute("editable-node");
+  const id = created.body.node?.id as string;
+  assert.ok(id, "precondition: ordinary prefix creates a node");
+  const rejectedUpdate = await updateViaRoute(id, publicOnly);
+  assert.equal(rejectedUpdate.status, 400);
+  assert.equal(rejectedUpdate.body.error?.code, "reserved-provider");
+});
+
+test("editing a node onto a synthetic or duplicate prefix is rejected", async () => {
+  const mine = await createViaRoute("mine");
+  const other = await createViaRoute("other");
+  const mineId = mine.body.node?.id as string;
+  assert.ok(mineId && other.status === 201, "precondition: two nodes exist");
+
+  assert.equal((await updateViaRoute(mineId, "auto")).body.error?.code, "reserved-synthetic");
+  assert.equal((await updateViaRoute(mineId, "other")).body.error?.code, "duplicate");
+});
+
+test("re-saving a node with its own prefix unchanged succeeds", async () => {
+  const created = await createViaRoute("keepme");
+  const id = created.body.node?.id as string;
+  assert.ok(id);
+
+  const resaved = await updateViaRoute(id, "keepme");
+  assert.equal(resaved.status, 200, `a no-op re-save must not self-collide: ${JSON.stringify(resaved.body)}`);
+});
+
+// ---------------------------------------------------------------------------
+// Pre-existing rows: warned about, never rewritten
+// ---------------------------------------------------------------------------
+
+test("pre-existing conflicting rows are reported by the listing and left untouched", async () => {
+  await seedLegacyNode("openai-compatible-chat-legacy-builtin", "openai");
+  await seedLegacyNode("openai-compatible-chat-legacy-synthetic", "auto");
+  await seedLegacyNode("openai-compatible-chat-legacy-dup-a", "shared");
+  await seedLegacyNode("openai-compatible-chat-legacy-dup-b", "shared");
+  await seedLegacyNode("openai-compatible-chat-legacy-fine", "fine");
+
+  const response = await nodesRoute.GET(new Request("http://localhost/api/provider-nodes") as never);
+  const body = (await response.json()) as {
+    nodes?: Array<{ id?: string; prefix?: string }>;
+    prefixConflicts?: Array<{ nodeId: string; prefix: string; reason: string }>;
+  };
+
+  const byReason = new Map((body.prefixConflicts ?? []).map((c) => [c.nodeId, c.reason]));
+  assert.equal(byReason.get("openai-compatible-chat-legacy-builtin"), "reserved-provider");
+  assert.equal(byReason.get("openai-compatible-chat-legacy-synthetic"), "reserved-synthetic");
+  assert.equal(byReason.get("openai-compatible-chat-legacy-dup-b"), "duplicate");
+  assert.equal(
+    byReason.has("openai-compatible-chat-legacy-dup-a"),
+    false,
+    "the first holder of a duplicated prefix is the one that works; it is not the conflict"
+  );
+  assert.equal(byReason.has("openai-compatible-chat-legacy-fine"), false, "a valid prefix is clean");
+
+  // Nothing was migrated or rewritten — the ids clients pinned still resolve as before.
+  const stored = (body.nodes ?? []).find((n) => n.id === "openai-compatible-chat-legacy-builtin");
+  assert.equal(stored?.prefix, "openai", "a conflicting prefix must be reported, not repaired");
+});
+
+test("findProviderNodePrefixConflicts ignores rows with no prefix", () => {
+  const conflicts = findProviderNodePrefixConflicts([
+    { id: "n1", prefix: null },
+    { id: "n2", prefix: "   " },
+    { id: "n3", prefix: "openai" },
+  ]);
+  assert.deepEqual(
+    conflicts.map((c) => c.nodeId),
+    ["n3"]
+  );
+});
+
+// ---------------------------------------------------------------------------
+// The behaviour the validation exists to prevent — pinned so the "why" stays visible
+// ---------------------------------------------------------------------------
+
+test("a legacy built-in-shadowing node really is unreachable (why creation is blocked)", async () => {
+  await seedLegacyNode("openai-compatible-chat-shadow", "openai");
+  const info = (await modelSvc.getModelInfo("openai/gpt-4o")) as { provider?: string };
+  assert.equal(
+    info?.provider,
+    "openai",
+    "built-ins win segment resolution, so the node never receives its own published ids"
+  );
+});
+
+test("a legacy synthetic-namespace node really does hijack gateway routing", async () => {
+  await seedLegacyNode("openai-compatible-chat-hijack", "no-think");
+  const info = (await modelSvc.getModelInfo("no-think/openai/gpt-4o")) as { provider?: string };
+  assert.equal(
+    info?.provider,
+    "openai-compatible-chat-hijack",
+    "here the node wins — which is why the prefix must be refused at write time"
+  );
+});
+
+// ---------------------------------------------------------------------------
+// Validator unit contract
+// ---------------------------------------------------------------------------
+
+test("validateProviderNodePrefix returns null only for acceptable prefixes", () => {
+  assert.equal(validateProviderNodePrefix("pix4k"), null);
+  assert.equal(validateProviderNodePrefix("  pix4k  "), null, "surrounding space is trimmed");
+  assert.equal(validateProviderNodePrefix("my.node_1-x"), null);
+
+  assert.equal(validateProviderNodePrefix("")?.code, "empty");
+  assert.equal(validateProviderNodePrefix(null)?.code, "empty");
+  assert.equal(validateProviderNodePrefix("a".repeat(65))?.code, "too-long");
+  assert.equal(validateProviderNodePrefix("openai")?.code, "reserved-provider");
+  assert.equal(validateProviderNodePrefix("auto")?.code, "reserved-synthetic");
+
+  const dup = validateProviderNodePrefix("taken", {
+    existingNodes: [{ id: "node-1", prefix: "taken" }],
+  });
+  assert.equal(dup?.code, "duplicate");
+  assert.equal(dup?.conflictingNodeId, "node-1");
+
+  assert.equal(
+    validateProviderNodePrefix("taken", {
+      existingNodes: [{ id: "node-1", prefix: "taken" }],
+      selfNodeId: "node-1",
+    }),
+    null,
+    "a node keeping its own prefix is not a conflict"
+  );
+});
