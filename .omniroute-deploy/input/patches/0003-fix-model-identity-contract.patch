+// ---------------------------------------------------------------------------
+// Custom compatible node addressed by its PUBLIC prefix (#8330 / W2b).
+//
+// This file covered built-ins, registry aliases and service plugins, but never a
+// `provider_nodes` row — which is the case that was broken: the route resolved the
+// segment against the static registry only, so the operator's prefix (the very name
+// /v1/models advertises the models under) came back "Unknown provider", and the raw
+// node id matched no `owned_by` value and returned an empty list. Both names must
+// work and must return the same roster.
+// ---------------------------------------------------------------------------
+
+async function seedCompatibleNodeWithModel(prefix: string, modelId: string) {
+  const node = (await providersDb.createProviderNode({
+    id: "openai-compatible-chat-3c1f9b52-7a44-4d18-9f0e-2b6d5c8a1e77",
+    type: "openai-compatible",
+    name: "Scoped Compatible Provider",
+    prefix,
+    apiType: "chat",
+    baseUrl: "https://scoped.example.com/v1",
+  })) as Record<string, unknown>;
+  const nodeId = String(node.id);
+
+  const connection = (await seedConnection(nodeId, {
+    name: "scoped-compat",
+  })) as Record<string, unknown>;
+
+  await modelsDb.replaceSyncedAvailableModelsForConnection(nodeId, String(connection.id), [
+    { id: modelId, name: "Scoped Model", source: "imported", supportedEndpoints: ["chat"] },
+  ] as never);
+
+  return nodeId;
+}
+
+async function fetchScoped(segment: string) {
+  // Both the node list and the unified catalog body are cached; drop them so each
+  // call reflects the rows just written.
+  readCache.invalidateDbCache();
+  (
+    v1Catalog as { __resetCatalogBuilderRunsForTest?: () => void }
+  ).__resetCatalogBuilderRunsForTest?.();
+
+  const response = await providerModelsRoute.GET(
+    new Request(`http://localhost/api/v1/providers/${segment}/models`),
+    { params: Promise.resolve({ provider: segment }) }
+  );
+  const body = (await response.json()) as ProviderModelsResponse;
+  return {
+    status: response.status,
+    ids: (body.data ?? []).map((model) => String(model.id)),
+    body,
+  };
+}
+
+test("provider models route resolves a custom node by its PUBLIC prefix", async () => {
+  const nodeId = await seedCompatibleNodeWithModel("scoped-compat", "scoped-model-x");
+
+  const byPrefix = await fetchScoped("scoped-compat");
+  assert.equal(
+    byPrefix.status,
+    200,
+    `the published prefix must be addressable, got ${JSON.stringify(byPrefix.body.error)}`
+  );
+  assert.ok(
+    byPrefix.ids.includes("scoped-model-x"),
+    `expected the bare synced id; got ${JSON.stringify(byPrefix.ids)}`
+  );
+  // The endpoint documents unprefixed ids — a prefixed one here would be
+  // double-prefixed by any client that re-qualifies it.
+  assert.equal(
