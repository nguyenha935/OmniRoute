+
+  // Cross-surface: the unified catalog must keep both the responses row AND the image
+  // row under the same public id codex/gpt-5.6-sol (delegated to image-6457 test for
+  // the full two-row assertion; here we confirm both surfaces are present).
+  const entries = await listEntries();
+  const solEntries = entries.filter((e) => String(e.id) === "codex/gpt-5.6-sol");
+  const types = new Set(solEntries.map((e) => String(e.type ?? "chat")));
+  assert.ok(types.has("image"), `image surface must survive; types: ${[...types].join(", ")}`);
+  // The responses surface is the non-image row (type undefined/"chat" with supported_endpoints).
+  assert.ok(
+    solEntries.some((e) => String(e.type ?? "chat") !== "image"),
