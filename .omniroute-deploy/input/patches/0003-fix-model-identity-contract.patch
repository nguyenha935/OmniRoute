+/** Seed the combos every policy test reasons about. Names are the public identifiers. */
+async function seedCombos() {
+  await combosDb.createCombo({
+    name: "allowed-combo",
+    strategy: "priority",
+    models: [{ kind: "model", model: "codex/gpt-5.6-sol-high", providerId: "codex" }],
+  });
+  await combosDb.createCombo({
+    name: "other-combo",
+    strategy: "priority",
+    models: [{ kind: "model", model: "codex/gpt-5.6-sol-high", providerId: "codex" }],
+  });
+  await combosDb.createCombo({
+    name: "blocked-combo",
+    strategy: "priority",
+    models: [{ kind: "model", model: "codex/gpt-5.6-sol-high", providerId: "codex" }],
+  });
+}
+
+type ComboRow = { name?: unknown };
+type ListBody = { data?: ComboRow[] };
+
+function comboNames(body: ListBody): string[] {
+  return (body?.data || [])
+    .map((entry) => (typeof entry.name === "string" ? entry.name : ""))
+    .filter((name) => name.length > 0)
+    .sort();
+}
+
+function bearerRequest(url: string, key: string): Request {
+  return new Request(url, { headers: { authorization: `Bearer ${key}` } });
+}
+
+test.beforeEach(async () => {
