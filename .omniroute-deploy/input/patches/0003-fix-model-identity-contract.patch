+  // Apply the same filter + dedup the route performs
+  const seen = new Set<string>();
+  const expectedIds: string[] = [];
+  for (const model of catalogBody.data) {
+    if (!isUsableChatModel(model as any)) continue;
+    const id = model.id as string;
+    if (typeof id !== "string" || seen.has(id)) continue;
+    seen.add(id);
+    expectedIds.push(id);
