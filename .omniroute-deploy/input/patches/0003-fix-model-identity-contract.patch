diff --git a/tests/unit/model-select-modal-hidden-leak-7156.test.ts b/tests/unit/model-select-modal-hidden-leak-7156.test.ts
new file mode 100644
index 000000000..2aab3880e
--- /dev/null
+++ b/tests/unit/model-select-modal-hidden-leak-7156.test.ts
@@ -0,0 +1,168 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+/**
+ * Hidden models leaked into the legacy `ModelSelectModal` picker through two
+ * independent paths, and the same two namespaces disagreed inside the DB layer.
+ *
+ * (a) The picker fetched `/api/provider-models` with NO `provider` param. That form
+ *     returned `modelCompatOverrides: []` (it is a per-provider namespace row), and
+ *     the picker filtered on `cm.isHidden` — a field that only exists on
+ *     `customModels` rows. The eye toggle writes `customModels` ONLY when such a row
+ *     already exists (route PATCH: `updateCustomModel` first, else
+ *     `mergeModelCompatOverride`), so for every synced/registry model the flag lived
+ *     exclusively in the override namespace and the picker never saw it. The #7156
+ *     comment claimed this was fixed; it was pointed at the wrong data source.
+ *
+ * (b) Its other source, `GET /api/providers/<connId>/models`, omitted
+ *     `excludeHidden=true`. That flag is opt-IN by design and must stay that way —
+ *     the provider dashboard needs hidden rows to render its eye toggles — so the
+ *     fix belongs in the caller, not the route default.
+ *
+ * And the two hidden-flag readers disagreed: `getHiddenModelsByProvider()` (bulk,
+ * used by auto-combo candidate building) OR-ed both namespaces and keyed the set on
+ * the stored spelling, while `getModelIsHidden()` (per-model, used by /v1/models)
+ * lets an explicit `customModels.isHidden:false` unhide and resolves ids
+ * case-insensitively (#7364). Both divergences made the bulk map hide MORE than the
+ * catalog did.
+ */
+
+const TEST_DATA_DIR = fs.mkdtempSync(path.join(os.tmpdir(), "omniroute-hidden-leak-"));
+process.env.DATA_DIR = TEST_DATA_DIR;
+process.env.API_KEY_SECRET = process.env.API_KEY_SECRET || "hidden-leak-test-secret";
+
+const core = await import("../../src/lib/db/core.ts");
+const modelsDb = await import("../../src/lib/db/models.ts");
+const providerModelsRoute = await import("../../src/app/api/provider-models/route.ts");
+
+const PROVIDER = "openai";
+
+type GetBody = {
+  models?: unknown;
+  modelCompatOverrides?: unknown;
+  hiddenModels?: Record<string, string[]>;
+};
+
+async function get(query = ""): Promise<GetBody> {
+  const response = await providerModelsRoute.GET(
+    new Request(`http://localhost/api/provider-models${query}`)
+  );
+  assert.equal(response.status, 200, "the listing must succeed");
+  return (await response.json()) as GetBody;
+}
+
+/** Hide a model exactly the way the dashboard eye toggle does — through the route. */
+async function hideViaRoute(modelId: string, hidden = true) {
+  const response = await providerModelsRoute.PATCH(
+    new Request(
+      `http://localhost/api/provider-models?provider=${PROVIDER}&modelId=${encodeURIComponent(modelId)}`,
+      {
+        method: "PATCH",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ isHidden: hidden }),
+      }
+    )
+  );
+  assert.equal(response.status, 200, `hiding ${modelId} must succeed`);
+}
+
+test.before(async () => {
+  core.resetDbInstance();
+  fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true });
+  fs.mkdirSync(TEST_DATA_DIR, { recursive: true });
+});
+
+test.after(() => {
+  core.resetDbInstance();
+  fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true });
+});
+
+test("the all-providers listing reports models hidden in EITHER namespace", async () => {
+  await modelsDb.addCustomModel(PROVIDER, "user-added", "User Added");
+  await hideViaRoute("user-added"); // lands on the customModels row
+  await hideViaRoute("gpt-4o"); // no customModels row → modelCompatOverrides
+  await modelsDb.addCustomModel(PROVIDER, "stays-visible", "Stays Visible");
+
+  const body = await get();
+  const hidden = body.hiddenModels?.[PROVIDER] ?? [];
+
+  assert.ok(
+    hidden.includes("user-added"),
+    `a hidden user-added model must be reported; got ${JSON.stringify(hidden)}`
+  );
+  assert.ok(
+    hidden.includes("gpt-4o"),
+    "a hidden registry model is only recorded in modelCompatOverrides — the shape the picker could not see"
+  );
+  assert.ok(!hidden.includes("stays-visible"), "a visible model must not be reported as hidden");
+});
+
+test("the provider-scoped listing narrows the same map to that provider", async () => {
+  await modelsDb.addCustomModel("anthropic", "other-provider-model", "Other");
+  const anthropicPatch = await providerModelsRoute.PATCH(
+    new Request(
+      "http://localhost/api/provider-models?provider=anthropic&modelId=other-provider-model",
+      {
+        method: "PATCH",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ isHidden: true }),
+      }
+    )
+  );
+  assert.equal(anthropicPatch.status, 200);
+
+  const scoped = await get(`?provider=${PROVIDER}`);
+  assert.deepEqual(
+    Object.keys(scoped.hiddenModels ?? {}),
+    [PROVIDER],
+    "asking about one provider must not disclose another provider's model ids"
+  );
+
+  const all = await get();
+  assert.ok(
+    (all.hiddenModels?.anthropic ?? []).includes("other-provider-model"),
+    "the all-providers form still reports every provider"
+  );
+});
+
+test("an explicit customModels unhide outranks a stale override row (bulk == per-model)", () => {
+  // The conflict shape: the operator hid the model (override row written), then a
+  // custom row was created carrying isHidden:false.
+  modelsDb.mergeModelCompatOverride(PROVIDER, "conflict", { isHidden: true } as never);
+  // addCustomModel + explicit unhide, so the custom row owns the flag.
+  void modelsDb.addCustomModel(PROVIDER, "conflict", "Conflict");
+  void modelsDb.updateCustomModel(PROVIDER, "conflict", { isHidden: false } as never);
+
+  const perModel = modelsDb.getModelIsHidden(PROVIDER, "conflict");
+  const bulk = Boolean(modelsDb.getHiddenModelsByProvider().get(PROVIDER)?.has("conflict"));
+
+  assert.equal(perModel, false, "the custom row's explicit false is an unhide");
+  assert.equal(
+    bulk,
+    perModel,
+    "the bulk map is the bulk form of the same predicate — it must not hide more than the catalog does"
+  );
+});
+
+test("the bulk map resolves ids case-insensitively, like getCustomModelRow (#7364)", async () => {
+  // Stored with capitals, which is the case #7364 exists for.
+  const STORED = "GLM-4.6V";
+  await modelsDb.addCustomModel("zai", STORED, "GLM 4.6V");
+  await modelsDb.updateCustomModel("zai", STORED, { isHidden: true } as never);
+
+  assert.equal(
+    modelsDb.getModelIsHidden("zai", STORED.toLowerCase()),
+    true,
+    "sanity: the per-model reader matches regardless of case"
+  );
+
+  const set = modelsDb.getHiddenModelsByProvider().get("zai");
+  assert.ok(set?.has(STORED), "the stored spelling must stay in the set");
+  assert.ok(
+    set?.has(STORED.toLowerCase()),
+    "a caller that normalized the id before probing must not miss — that miss is what let a hidden model back into an auto-combo"
+  );
+});
diff --git a/tests/unit/model-writes-invalidate-catalog-cache.test.ts b/tests/unit/model-writes-invalidate-catalog-cache.test.ts
new file mode 100644
index 000000000..89fffc4a2
--- /dev/null
+++ b/tests/unit/model-writes-invalidate-catalog-cache.test.ts
@@ -0,0 +1,263 @@
+/**
+ * tests/unit/model-writes-invalidate-catalog-cache.test.ts
+ *
+ * #6408 put a request-shape-keyed TTL cache in front of the /v1/models builder and used
+ * `modelCatalogCacheVersion` as the "the DB moved, drop the cache" signal. Writes to
+ * settings, pricing, connections, combos and nodes all bump it via `invalidateDbCache()`.
+ * MODEL writes did not: `src/lib/db/models.ts` contained zero invalidation calls, though
+ * it owns ~12 write functions that feed the catalog directly.
+ *
+ * Measured before the fix, through the real builder: the version stayed at 1 across
+ * hiding a model, adding a custom model and syncing available models, and
+ *
+ *   • a model hidden through the UI was still advertised by /v1/models (147 → 147);
+ *   • a newly added custom model did not appear;
+ *
+ * both only correcting once something else happened to call `invalidateDbCache()` or the
+ * ~1.5s TTL lapsed. That is the mechanism behind screens disagreeing with each other: the
+ * dashboard reads the DB directly and updates instantly, the catalog replays its cache.
+ *
+ * The fix adds a `"models"` scope that bumps only the catalog version (those rows have no
+ * read-through cache of their own) and calls it from every model write, including the
+ * shared `writeCompatList` and the alias CRUD.
+ *
+ * These tests also pin what must NOT change: the #6408 in-flight coalescing and the
+ * `__resetCatalogBuilderRunsForTest` hook that v1-models-concurrent-6408.test.ts uses.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+const TEST_DATA_DIR = fs.mkdtempSync(path.join(os.tmpdir(), "omniroute-model-write-invalidate-"));
+process.env.DATA_DIR = TEST_DATA_DIR;
+process.env.API_KEY_SECRET = process.env.API_KEY_SECRET || "model-write-test-secret";
+
+const coreDb = await import("../../src/lib/db/core.ts");
+const providersDb = await import("../../src/lib/db/providers.ts");
+const modelsDb = await import("../../src/lib/db/models.ts");
+const aliasesDb = await import("../../src/lib/db/models/aliases.ts");
+const readCache = await import("../../src/lib/db/readCache.ts");
+const catalog = await import("../../src/app/api/v1/models/catalog.ts");
+
+async function resetStorage() {
+  coreDb.resetDbInstance();
+  fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true });
+  fs.mkdirSync(TEST_DATA_DIR, { recursive: true });
+  catalog.__resetCatalogBuilderRunsForTest();
+}
+
+/** Ids currently advertised by the unified catalog, cache and all. */
+async function listCatalogIds(): Promise<string[]> {
+  const response = await catalog.getUnifiedModelsResponse(
+    new Request("http://localhost/v1/models")
+  );
+  const body = (await response.json()) as { data?: Array<{ id?: unknown }> };
+  return (body.data ?? [])
+    .map((entry) => entry.id)
+    .filter((id): id is string => typeof id === "string");
+}
+
+async function activeOpenAiConnection(label: string) {
+  return providersDb.createProviderConnection({
+    provider: "openai",
+    authType: "apikey",
+    name: `catalog-invalidate-${label}`,
+    apiKey: `sk-catalog-invalidate-${label}`,
+    isActive: true,
+    testStatus: "active",
+  } as never);
+}
+
+test.beforeEach(async () => {
+  await resetStorage();
+});
+
+test.after(async () => {
+  coreDb.resetDbInstance();
+  fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true });
+});
+
+// ---------------------------------------------------------------------------
+// Hiding a model takes effect on the very next read
+// ---------------------------------------------------------------------------
+
+test("hiding a model removes it from the catalog immediately, without waiting out the TTL", async () => {
+  await activeOpenAiConnection("hide");
+
+  const before = await listCatalogIds();
+  const target = before.find((id) => id.startsWith("openai/"));
+  assert.ok(target, `precondition: the catalog must advertise an openai model; got ${before.length}`);
+  const bareId = target.slice(target.indexOf("/") + 1);
+
+  const versionBefore = readCache.getModelCatalogCacheVersion();
+  modelsDb.setModelIsHidden("openai", bareId, true);
+  assert.ok(
+    readCache.getModelCatalogCacheVersion() > versionBefore,
+    "a model write must move the catalog cache version"
+  );
+
+  // No invalidateDbCache(), no TTL wait, no builder reset — exactly what the UI does.
+  const after = await listCatalogIds();
+  assert.equal(
+    after.includes(target),
+    false,
+    `${target} was hidden but the catalog still advertises it (cached body replayed)`
+  );
+  assert.equal(after.length, before.length - 1, "exactly one entry should disappear");
+});
+
+test("un-hiding a model brings it back immediately too", async () => {
+  await activeOpenAiConnection("unhide");
+  const before = await listCatalogIds();
+  const target = before.find((id) => id.startsWith("openai/")) as string;
+  const bareId = target.slice(target.indexOf("/") + 1);
+
+  modelsDb.setModelIsHidden("openai", bareId, true);
+  assert.equal((await listCatalogIds()).includes(target), false, "precondition: now hidden");
+
+  modelsDb.setModelIsHidden("openai", bareId, false);
+  assert.ok(
+    (await listCatalogIds()).includes(target),
+    "un-hiding must be visible on the next read as well — the signal is not hide-only"
+  );
+});
+
+// ---------------------------------------------------------------------------
+// Adding / removing a custom model
+// ---------------------------------------------------------------------------
+
+test("a newly added custom model appears in the catalog immediately", async () => {
+  await activeOpenAiConnection("add");
+  const before = await listCatalogIds();
+  assert.equal(
+    before.some((id) => id.includes("probe-fresh-model")),
+    false,
+    "precondition: the id must not already exist"
+  );
+
+  const versionBefore = readCache.getModelCatalogCacheVersion();
+  await modelsDb.addCustomModel("openai", "probe-fresh-model", "Probe Fresh");
+  assert.ok(
+    readCache.getModelCatalogCacheVersion() > versionBefore,
+    "addCustomModel must move the catalog cache version"
+  );
+
+  const after = await listCatalogIds();
+  assert.ok(
+    after.includes("openai/probe-fresh-model"),
+    `a custom model added through the UI must be advertised at once; got ${after.length} ids`
+  );
+});
+
+test("removing a custom model drops it from the catalog immediately", async () => {
+  await activeOpenAiConnection("remove");
+  await modelsDb.addCustomModel("openai", "probe-doomed-model", "Probe Doomed");
+  assert.ok(
+    (await listCatalogIds()).includes("openai/probe-doomed-model"),
+    "precondition: the custom model is advertised"
+  );
+
+  const versionBefore = readCache.getModelCatalogCacheVersion();
+  await modelsDb.removeCustomModel("openai", "probe-doomed-model");
+  assert.ok(
+    readCache.getModelCatalogCacheVersion() > versionBefore,
+    "removeCustomModel must move the catalog cache version"
+  );
+  assert.equal(
+    (await listCatalogIds()).includes("openai/probe-doomed-model"),
+    false,
+    "a removed custom model must not linger in a cached body"
+  );
+});
+
+// ---------------------------------------------------------------------------
+// The remaining write paths must signal too — checked at the version level,
+// because whether a given row becomes a published id depends on registry
+// support, which is a separate concern from cache freshness.
+// ---------------------------------------------------------------------------
+
+test("synced-available-model writes move the catalog cache version", async () => {
+  const connection = await activeOpenAiConnection("sync");
+  const connectionId = (connection as Record<string, unknown>).id as string;
+
+  const beforeReplace = readCache.getModelCatalogCacheVersion();
+  await modelsDb.replaceSyncedAvailableModelsForConnection(connectionId, "openai", [
+    { id: "gpt-4o", name: "GPT-4o" },
+  ] as never);
+  const afterReplace = readCache.getModelCatalogCacheVersion();
+  assert.ok(afterReplace > beforeReplace, "replaceSyncedAvailableModelsForConnection must signal");
+
+  await modelsDb.deleteSyncedAvailableModelsForConnection(connectionId, "openai");
+  assert.ok(
+    readCache.getModelCatalogCacheVersion() > afterReplace,
+    "deleteSyncedAvailableModelsForConnection must signal"
+  );
+});
+
+test("model-alias writes move the catalog cache version", async () => {
+  const beforeSet = readCache.getModelCatalogCacheVersion();
+  await aliasesDb.setModelAlias("probe-alias", "openai/gpt-4o");
+  const afterSet = readCache.getModelCatalogCacheVersion();
+  assert.ok(afterSet > beforeSet, "setModelAlias must signal: aliases are a publishing input");
+
+  await aliasesDb.deleteModelAlias("probe-alias");
+  assert.ok(
+    readCache.getModelCatalogCacheVersion() > afterSet,
+    "deleteModelAlias must signal as well"
+  );
+});
+
+test("compat-override writes move the catalog cache version", async () => {
+  const before = readCache.getModelCatalogCacheVersion();
+  modelsDb.mergeModelCompatOverride("openai", "gpt-4o", { normalizeToolCallId: true } as never);
+  assert.ok(
+    readCache.getModelCatalogCacheVersion() > before,
+    "writeCompatList is the single write point for modelCompatOverrides and must signal"
+  );
+});
+
+// ---------------------------------------------------------------------------
+// What must NOT change: #6408 coalescing and its test hook
+// ---------------------------------------------------------------------------
+
+test("concurrent identical GETs still collapse to one builder run (#6408)", async () => {
+  await activeOpenAiConnection("coalesce");
+  catalog.__resetCatalogBuilderRunsForTest();
+
+  await Promise.all([listCatalogIds(), listCatalogIds(), listCatalogIds(), listCatalogIds()]);
+  assert.equal(
+    catalog.__getCatalogBuilderRunsForTest(),
+    1,
+    "the in-flight coalescing must survive the added invalidation"
+  );
+});
+
+test("repeated reads with no write in between still hit the cache", async () => {
+  await activeOpenAiConnection("cachehit");
+  await listCatalogIds();
+  catalog.__resetCatalogBuilderRunsForTest();
+
+  await listCatalogIds();
+  await listCatalogIds();
+  assert.equal(
+    catalog.__getCatalogBuilderRunsForTest(),
+    1,
+    "invalidating on writes must not turn every read into a rebuild"
+  );
+});
+
+test("__resetCatalogBuilderRunsForTest still resyncs the seen version", async () => {
+  await activeOpenAiConnection("resethook");
+  await listCatalogIds();
+  await modelsDb.addCustomModel("openai", "probe-reset-hook", "Probe Reset");
+
+  // The hook clears counters, in-flight entries and the last-seen version together, so a
+  // test that resets and then reads gets exactly one build — not one for the reset plus
+  // one for the pending version change.
+  catalog.__resetCatalogBuilderRunsForTest();
+  await listCatalogIds();
+  assert.equal(catalog.__getCatalogBuilderRunsForTest(), 1);
+});
