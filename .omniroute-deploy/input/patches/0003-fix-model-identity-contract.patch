+}
+
+async function activeOpenAiConnection(label: string) {
+  return providersDb.createProviderConnection({
+    provider: "openai",
+    authType: "apikey",
+    name: `fail-open-${label}`,
+    apiKey: `sk-fail-open-${label}`,
+    isActive: true,
+    testStatus: "active",
+  } as never);
+}
+
+/** Model ids advertised by /v1/models for `apiKey` (omit for the anonymous list). */
+async function listCatalogIds(label: string, apiKey?: string): Promise<string[]> {
+  readCache.invalidateDbCache?.();
+  const catalog = await loadCatalog(label);
+  const response = await catalog.getUnifiedModelsResponse(
+    new Request(
+      "http://localhost/v1/models",
+      apiKey ? { headers: { Authorization: `Bearer ${apiKey}` } } : undefined
+    )
+  );
+  const body = (await response.json()) as { data?: Array<{ id?: unknown }> };
+  return (body.data ?? [])
+    .map((entry) => entry.id)
+    .filter((id): id is string => typeof id === "string");
+}
+
+// ---------------------------------------------------------------------------
+// Lifecycle
+// ---------------------------------------------------------------------------
+
+test.beforeEach(async () => {
+  await resetStorage();
+});
+
+test.after(async () => {
+  apiKeysDb.resetApiKeyState();
+  coreDb.resetDbInstance();
+  fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true });
+});
+
+// ---------------------------------------------------------------------------
+// 1 — group DENY must survive an empty per-key allow-list
+// ---------------------------------------------------------------------------
+
+test("group DENY rule applies to a key whose own allow-list is empty", async () => {
+  const key = await makeKey("group-deny-empty-allowlist");
+  const group = groupsDb.createKeyGroup("deny-openai");
+  groupsDb.addGroupPermission(group.id, "openai/*", "deny");
+  groupsDb.addKeyToGroup(key.id, group.id);
+  apiKeysDb.clearApiKeyCaches();
+
+  // Precondition — the group layer itself denies, and the key has NO allow-list.
+  // Without both, the assertion below could pass for the wrong reason.
+  assert.equal(
+    groupsDb.checkKeyModelAccess(key.id, "openai/gpt-4o").allowed,
+    false,
+    "precondition: the group rule must deny openai/*"
+  );
+  const meta = await apiKeysDb.getApiKeyMetadata(key.key);
+  assert.equal(
+    meta?.allowedModels?.length ?? 0,
+    0,
+    "precondition: the key must have an empty allow-list (the default)"
+  );
+
+  assert.equal(
+    await apiKeysDb.isModelAllowedForKey(key.key, "openai/gpt-4o"),
+    false,
+    "an empty allow-list means 'no per-key allow-list', not 'bypass the group DENY'"
+  );
+
+  const policy = await loadPolicy("group-deny-empty-allowlist");
+  const result = await policy.enforceApiKeyPolicy(makeRequest(key.key), "openai/gpt-4o");
+  assert.ok(result.rejection, "the request gate must reject a group-denied model");
+  assert.equal(result.rejection.status, 403);
+});
+
+test("a key in no group keeps unrestricted access (fix must not over-tighten)", async () => {
+  const key = await makeKey("no-group-unrestricted");
+
+  assert.equal(
+    await apiKeysDb.isModelAllowedForKey(key.key, "openai/gpt-4o"),
+    true,
+    "checkKeyModelAccess is allow-by-default for keys in no group"
+  );
+
+  const policy = await loadPolicy("no-group-unrestricted");
+  const result = await policy.enforceApiKeyPolicy(makeRequest(key.key), "openai/gpt-4o");
+  assert.equal(result.rejection, null, "an unrestricted key must stay unrestricted");
+});
+
+// ---------------------------------------------------------------------------
+// 2 — a quota-allocated key still honours its own deny-list
+// ---------------------------------------------------------------------------
+
+test("quota-allocated key cannot call a model its own blocked_models names", async () => {
+  const connection = await activeOpenAiConnection("quota-deny");
+  const connectionId = (connection as Record<string, unknown>).id as string;
+  const group = quotaGroupsDb.createGroup("Blocked Pool");
+  const pool = poolsDb.createPool({
+    connectionId,
+    name: "Blocked Pool",
+    groupId: group.id,
+  } as never);
+
+  const virtualModel = quotaModelName("Blocked Pool", "openai", "gpt-4o");
+  const key = await makeKey("quota-blocked", {
+    allowedQuotas: [pool.id],
+    blockedModels: [virtualModel],
+  });
+
+  const policy = await loadPolicy("quota-blocked");
+  const result = await policy.enforceApiKeyPolicy(makeRequest(key.key), virtualModel);
+  assert.ok(
+    result.rejection,
+    "the deny-list is unconditional: delegating the ALLOW decision to the quota scope must not drop the DENY decision"
+  );
+  assert.equal(result.rejection.status, 403);
+});
+
+test("quota-allocated key without a deny-list still reaches its own pool model", async () => {
+  const connection = await activeOpenAiConnection("quota-allow");
+  const connectionId = (connection as Record<string, unknown>).id as string;
+  const group = quotaGroupsDb.createGroup("Open Pool");
+  const pool = poolsDb.createPool({
+    connectionId,
+    name: "Open Pool",
+    groupId: group.id,
+  } as never);
+
+  const virtualModel = quotaModelName("Open Pool", "openai", "gpt-4o");
+  const key = await makeKey("quota-open", { allowedQuotas: [pool.id] });
+
+  const policy = await loadPolicy("quota-open");
+  const result = await policy.enforceApiKeyPolicy(makeRequest(key.key), virtualModel);
+  assert.equal(result.rejection, null, "deny-first must not block a model the pool allows");
+});
+
+// ---------------------------------------------------------------------------
+// 3 — a deny-list is effective on its own
+// ---------------------------------------------------------------------------
+
+test("blocked_models alone rejects, with no allow-list present", async () => {
+  const key = await makeKey("deny-only", { blockedModels: ["openai/gpt-4o"] });
+
+  const meta = await apiKeysDb.getApiKeyMetadata(key.key);
+  assert.equal(
+    meta?.allowedModels?.length ?? 0,
+    0,
+    "precondition: no allow-list, so `hasModelRestrictions` is false"
+  );
+  assert.equal(meta?.disableNonPublicModels ?? false, false, "precondition: flag off");
+
+  const policy = await loadPolicy("deny-only");
+  const blocked = await policy.enforceApiKeyPolicy(makeRequest(key.key), "openai/gpt-4o");
+  assert.ok(blocked.rejection, "a deny-list must not need an allow-list to take effect");
+  assert.equal(blocked.rejection.status, 403);
+
+  const other = await policy.enforceApiKeyPolicy(makeRequest(key.key), "openai/gpt-4.1");
+  assert.equal(other.rejection, null, "only the named model is denied");
+});
+
+test("deny-list wildcards apply on their own too", async () => {
+  const key = await makeKey("deny-wildcard", { blockedModels: ["openai/*"] });
+  const policy = await loadPolicy("deny-wildcard");
+
+  const blocked = await policy.enforceApiKeyPolicy(makeRequest(key.key), "openai/gpt-4o");
+  assert.ok(blocked.rejection, "openai/* must deny openai/gpt-4o");
+  assert.equal(blocked.rejection.status, 403);
+});
+
+// ---------------------------------------------------------------------------
+// 4 — a combo allowed via allowed_combos is advertised by /v1/models
+// ---------------------------------------------------------------------------
+
+test("combo permitted via allowed_combos is listed even when the key has an allow-list", async () => {
+  await activeOpenAiConnection("combo-visibility");
+  await combosDb.createCombo({
+    name: "my-combo",
+    strategy: "failover",
+    models: [{ provider: "openai", modelStr: "openai/gpt-4o" }],
+  } as never);
+  await combosDb.createCombo({
+    name: "other-combo",
+    strategy: "failover",
+    models: [{ provider: "openai", modelStr: "openai/gpt-4o" }],
+  } as never);
+
+  const key = await makeKey("combo-visible", {
+    allowedCombos: ["my-combo"],
+    allowedModels: ["openai/gpt-4o"],
+  });
+
+  // Precondition — the combo IS callable. That asymmetry (callable but invisible)
+  // is the defect; if the call were rejected too, hiding it would be correct.
+  const policy = await loadPolicy("combo-visible");
+  const call = await policy.enforceApiKeyPolicy(makeRequest(key.key), "my-combo");
+  assert.equal(call.rejection, null, "precondition: allowed_combos makes the combo callable");
+
+  const listed = await listCatalogIds("combo-visible", key.key);
+  assert.ok(
+    listed.includes("my-combo"),
+    `a callable combo must appear in /v1/models; got ${JSON.stringify(listed)}`
+  );
+  assert.ok(listed.includes("openai/gpt-4o"), "the allow-listed raw model is still listed");
+
+  // The tightening half: a combo the key was NOT granted stays hidden and uncallable.
+  assert.equal(
+    listed.includes("other-combo"),
+    false,
+    "a combo outside allowed_combos must not be advertised"
+  );
+  const otherCall = await policy.enforceApiKeyPolicy(makeRequest(key.key), "other-combo");
+  assert.ok(otherCall.rejection, "a combo outside allowed_combos must stay uncallable");
+});
+
+test("blocked_models still removes a combo from the catalog", async () => {
+  await activeOpenAiConnection("combo-blocked");
+  await combosDb.createCombo({
+    name: "banned-combo",
+    strategy: "failover",
+    models: [{ provider: "openai", modelStr: "openai/gpt-4o" }],
+  } as never);
+
+  const key = await makeKey("combo-blocked", {
+    allowedCombos: ["banned-combo"],
+    allowedModels: ["openai/gpt-4o"],
+    blockedModels: ["banned-combo"],
+  });
+
+  const listed = await listCatalogIds("combo-blocked", key.key);
+  assert.equal(
+    listed.includes("banned-combo"),
+    false,
+    "the deny-list outranks allowed_combos in the catalog, as it does on the request path"
+  );
+
+  const policy = await loadPolicy("combo-blocked");
+  const call = await policy.enforceApiKeyPolicy(makeRequest(key.key), "banned-combo");
+  assert.ok(call.rejection, "and the same combo must be uncallable");
+});
