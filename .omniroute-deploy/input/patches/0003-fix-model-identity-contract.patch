+test("/api/models: exact ID sequence equals filtered v1 catalog, multi-provider blocks contiguous", async () => {
+  await seedConnection("openai");
+  await seedConnection("anthropic");
+
+  // Authoritative catalog
+  const catalogRes = await v1ModelsCatalog.getUnifiedModelsResponse(
+    new Request("http://localhost/api/v1/models?configuredOnly=true")
+  );
+  assert.equal(catalogRes.status, 200);
+  const catalogBody = (await catalogRes.json()) as { data: Array<Record<string, unknown>> };
