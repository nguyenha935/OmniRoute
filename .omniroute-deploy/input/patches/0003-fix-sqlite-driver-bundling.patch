+  // same-tick exit that lost the race still counts. Timer is always cleared.
+  const waitForExit = (ms) => {
+    let timer;
+    return Promise.race([
+      exited,
+      new Promise((resolve) => {
+        timer = setTimeout(resolve, ms);
+      }),
+    ])
+      .finally(() => clearTimeout(timer))
+      .then(() => hasExited(child));
+  };
