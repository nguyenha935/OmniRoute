--- /dev/null
+++ b/src/lib/models/comboVisibility.ts
@@ -0,0 +1,134 @@
+/**
+ * The ONE definition of "is this combo listable?", shared by every surface that lists
+ * combos.
+ *
+ * WHY THIS FILE EXISTS
+ * --------------------
+ * `GET /v1/models` suppresses a combo when the combo itself is inactive/hidden OR when any
+ * model it resolves to is eye-hidden. That rule lived inline in `catalog.ts` and nowhere
+ * else, so the endpoints that list combos directly from `getCombos()` — `/v1/combos` and
+ * both VS Code `…/combos` routes — applied no rule at all. Hiding a model that a combo
+ * targets therefore removed the model from `/v1/models` while the combo pointing at it
+ * stayed listed everywhere else: the same "hidden in one place, visible in another" split
+ * the operator sees in the UI.
+ *
+ * Keeping the predicate in one module means a change to the rule cannot land on some
+ * surfaces and miss others. Callers pass the combo list they already have; this module
+ * does the target resolution and the hidden lookup.
+ *
+ * WHY IT IS ASYNC
+ * ---------------
+ * Resolving a combo step to a (providerId, modelId) pair needs the same three inputs the
+ * catalog uses: the alias maps, and — for compatible-provider nodes — that node's
+ * `provider_nodes.prefix`. A combo step persists `provider` as the raw node id while its
+ * `modelStr` is prefix-qualified ("pix4k/claude-opus-5"), so without the prefix map the
+ * strip cannot recognize the qualified form and the hidden lookup misses. The prefix map
+ * comes from the (cached) provider-nodes read, hence the await.
+ *
+ * Note the asymmetry with `isDeleted`: eye-hidden (`isHidden`) and trashed (`isDeleted`)
+ * are deliberately distinct in storage, and this predicate is about the eye only.
+ */
+
+import { getModelIsHidden } from "@/lib/db/models";
+import { getCachedProviderNodes } from "@/lib/localDb";
+import {
+  buildAliasMaps,
+  getComboTargetModelId,
+  resolveCanonicalProviderId,
+  type AliasMaps,
+} from "@/app/api/v1/models/catalogProviderMaps";
+import { resolveNestedComboTargets } from "@omniroute/open-sse/services/combo/comboStructure.ts";
+
+type ComboLike = Record<string, unknown>;
+
+/** The resolution inputs `catalog.ts` builds inline; built once per listing call. */
+type ComboResolutionContext = {
+  aliasMaps: AliasMaps;
+  providerIdToPrefix: Record<string, string>;
+};
+
+async function buildComboResolutionContext(): Promise<ComboResolutionContext> {
+  const providerIdToPrefix: Record<string, string> = {};
+  try {
+    const nodes = await getCachedProviderNodes();
+    for (const node of Array.isArray(nodes) ? nodes : []) {
+      // Narrow rather than cast: the cache is typed `Record<string, unknown>[]`, so a
+      // cast would only be a promise that these are strings — and a non-string prefix
+      // would then silently become a broken map key.
+      const nodeId = typeof node?.id === "string" ? node.id : null;
+      const nodePrefix = typeof node?.prefix === "string" ? node.prefix : null;
+      if (nodeId && nodePrefix) providerIdToPrefix[nodeId] = nodePrefix;
+    }
+  } catch {
+    // No node prefixes available → registry providers still resolve; compatible nodes
+    // fall back to the unstripped modelStr, which is the pre-existing behavior.
+  }
+  return { aliasMaps: buildAliasMaps(), providerIdToPrefix };
+}
+
+/**
+ * True when every model this combo resolves to is visible.
+ *
+ * Resolution goes through `resolveNestedComboTargets` so a combo that nests another combo
+ * is judged by the models it ultimately reaches, not by its immediate steps — a nested
+ * combo whose leaf model is hidden must not slip through. Targets that cannot be resolved
+ * to a provider+model pair are treated as visible: an unresolvable step is a separate
+ * (configuration) problem and must not silently delete a combo from every listing.
+ */
+export function comboTargetsAllVisible(
+  combo: ComboLike,
+  allCombos: readonly ComboLike[],
+  context: ComboResolutionContext
+): boolean {
+  let targets: Array<Record<string, unknown>>;
+  try {
+    targets = resolveNestedComboTargets(
+      combo as Parameters<typeof resolveNestedComboTargets>[0],
+      allCombos as Parameters<typeof resolveNestedComboTargets>[1]
+    ) as Array<Record<string, unknown>>;
+  } catch {
+    // A malformed/cyclic combo structure is not a visibility decision — leave it listed
+    // and let the combo's own validation surface the problem.
+    return true;
+  }
+
+  return !targets.some((target) => {
+    // Same prefix lookup `catalog.ts` does: try the canonical id first, then the raw
+    // provider string, because a compatible node's prefix is keyed by its raw node id.
+    const providerValue = (target as { provider?: unknown }).provider;
+    const rawProvider = typeof providerValue === "string" ? providerValue.trim() : "";
+    const canonical = rawProvider
+      ? resolveCanonicalProviderId(context.aliasMaps.aliasToProviderId, rawProvider)
+      : rawProvider;
+    const resolved = getComboTargetModelId(
+      context.aliasMaps,
+      target as Parameters<typeof getComboTargetModelId>[1],
+      context.providerIdToPrefix[canonical] || context.providerIdToPrefix[rawProvider]
+    );
+    return resolved ? getModelIsHidden(resolved.providerId, resolved.modelId) : false;
+  });
+}
+
+/**
+ * The full listability rule: the combo is enabled, not eye-hidden, and no model it
+ * resolves to is eye-hidden. This is what `/v1/models` enforces; every other combo
+ * listing must enforce the same thing.
+ */
+export function isComboListable(
+  combo: ComboLike,
+  allCombos: readonly ComboLike[],
+  context: ComboResolutionContext
+): boolean {
+  if (combo?.isActive === false) return false;
+  if (combo?.isHidden === true) return false;
+  return comboTargetsAllVisible(combo, allCombos, context);
+}
+
+/** Filter a combo list down to the listable ones, preserving order. */
+export async function filterListableCombos<T extends ComboLike>(
+  combos: readonly T[]
+): Promise<T[]> {
+  if (!Array.isArray(combos) || combos.length === 0) return [];
+  const context = await buildComboResolutionContext();
+  return combos.filter((combo) => isComboListable(combo, combos, context));
+}
