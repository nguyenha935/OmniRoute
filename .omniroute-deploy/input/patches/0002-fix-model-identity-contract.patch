+/**
+ * Whether `<aliasOrId>/<modelId>` is a GATEWAY-SYNTHESIZED effort variant — i.e. an id
+ * the catalog minted (`appendClaudeEffortVariants`) rather than one the upstream provider
+ * actually serves — and therefore must have its suffix stripped before dispatch.
+ *
+ * Why this exists: minting and stripping were gated on different things. The catalog mints
+ * per MODEL (any thinking-capable Claude model, whatever hosts it), while the strip was
+ * gated per PROVIDER (`claude` + the CC-compatible bridges only). So 34 providers that host
+ * Claude models advertised `<provider>/claude-…-high` and then forwarded `-high` verbatim
+ * upstream, where no such model exists — a 404 on an id OmniRoute itself published.
+ *
+ * Why it is not simply "strip everywhere": 173 registry ids END in an effort word while
+ * being real, distinct upstream models whose base id is NOT offered — Cursor's
+ * `claude-opus-4-8-low` is a different SKU from `claude-opus-4-8`, and lmarena's
+ * `gpt-5.2-high` has no `gpt-5.2`. Blind stripping would silently reroute those requests to
+ * a model the provider does not have. So the registry is the arbiter: if the provider serves
+ * the suffixed id itself, it is a real model and is left alone; only ids absent from the
+ * provider's roster are treated as gateway variants.
+ *
+ * Passthrough providers (dynamic rosters, empty static list) keep the old provider-based
+ * answer: nothing can be proven from an empty roster, so only `claude` / CC bridges strip.
+ */
+export function isSynthesizedClaudeEffortVariant(
+  aliasOrId: string | null | undefined,
+  modelId: string | null | undefined
+): boolean {
+  if (typeof modelId !== "string" || !modelId) return false;
+  const { baseModel, effort } = splitClaudeEffortSuffix(modelId);
+  if (!effort) return false;
+
+  // Only Claude-family ids: those are the only ones the catalog mints effort variants
+  // for (`shouldExposeClaudeEffortVariants` requires a Claude name). Widening past that
+  // would strip suffixes off ids nothing synthesized — `openai/gpt-5-high` must reach
+  // upstream verbatim, which is what chatcore-claude-effort-variant.test.ts pins.
+  if (!CLAUDE_MODEL_PATTERN.test(baseModel.toLowerCase())) return false;
+
+  const provider = typeof aliasOrId === "string" ? aliasOrId : "";
+  const models = getProviderModels(provider);
+  // Unknown/passthrough provider: no roster to reason about. Caller falls back to its
+  // own provider check rather than guessing.
+  if (models.length === 0) return false;
+
+  // The provider serves this exact id → a real model, never a synthesized variant.
+  return !models.some((entry) => entry.id === modelId);
+}
