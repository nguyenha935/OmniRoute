diff --git a/tests/unit/claude-effort-variant-round-trip-contract.test.ts b/tests/unit/claude-effort-variant-round-trip-contract.test.ts
new file mode 100644
index 000000000..7608ae887
--- /dev/null
+++ b/tests/unit/claude-effort-variant-round-trip-contract.test.ts
@@ -0,0 +1,259 @@
+/**
+ * tests/unit/claude-effort-variant-round-trip-contract.test.ts
+ *
+ * The catalog and the dispatcher must agree on which `<provider>/<model>-<level>` ids
+ * exist. They did not:
+ *
+ *   MINT was per-MODEL — `shouldExposeClaudeEffortVariants` accepts any thinking-capable
+ *   Claude model, whatever provider hosts it, so 34 providers advertised
+ *   `<provider>/claude-…-high`.
+ *
+ *   STRIP was per-PROVIDER — `applyClaudeEffortVariant` only ran for `claude` and the
+ *   `anthropic-compatible-cc-*` bridges, so every other provider forwarded `-high`
+ *   verbatim to an upstream that has no such model: a 404 on an id OmniRoute published.
+ *
+ * The fix makes the strip provider-agnostic but registry-arbitrated, because "strip
+ * everywhere" is also wrong: 173 registry ids END in an effort word while being real,
+ * distinct upstream SKUs whose base id is not offered at all (Cursor serves
+ * `claude-opus-4-8-low` and `claude-opus-4-8-max` as separate models; lmarena serves
+ * `gpt-5.2-high` with no `gpt-5.2`). Blind stripping would silently reroute those to a
+ * model the provider does not have.
+ *
+ * A third defect fell out of the same asymmetry: the mint-side suffix guard was a
+ * hand-written alternation missing `max`, so real `*-max` SKUs passed the gate and minted
+ * double-suffixed nonsense (`claude-opus-4-8-max-low`).
+ *
+ * The invariant these tests pin, swept over the WHOLE registry rather than a sample:
+ * every id the catalog mints must strip back to a real base model, and every id the
+ * provider actually serves must reach upstream untouched.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+
+const {
+  PROVIDER_MODELS,
+  CLAUDE_EFFORT_SUFFIXES,
+  splitClaudeEffortSuffix,
+  isSynthesizedClaudeEffortVariant,
+} = await import("../../open-sse/config/providerModels.ts");
+const { appendClaudeEffortVariants, shouldExposeClaudeEffortVariants, claudeEffortLevelsFor } =
+  await import("../../open-sse/utils/claudeEffortVariants.ts");
+const { applyClaudeEffortVariant } = await import(
+  "../../open-sse/handlers/chatCore/claudeEffortVariant.ts"
+);
+
+const EFFORT_SUFFIX_RE = new RegExp(`-(?:${CLAUDE_EFFORT_SUFFIXES.join("|")})$`, "i");
+const DOUBLE_SUFFIX_RE = new RegExp(
+  `-(?:${CLAUDE_EFFORT_SUFFIXES.join("|")})-(?:${CLAUDE_EFFORT_SUFFIXES.join("|")})$`,
+  "i"
+);
+
+type RosterEntry = { id?: unknown };
+
+function providerRoster(alias: string): string[] {
+  const models = (PROVIDER_MODELS as Record<string, RosterEntry[]>)[alias];
+  if (!Array.isArray(models)) return [];
+  return models.map((m) => String(m?.id ?? "")).filter((id) => id.length > 0);
+}
+
+/** Every id the catalog would mint, as {alias, publishedId, bareId}. */
+function allMintedVariants(): Array<{ alias: string; publishedId: string; bareId: string }> {
+  const out: Array<{ alias: string; publishedId: string; bareId: string }> = [];
+  for (const alias of Object.keys(PROVIDER_MODELS as Record<string, unknown>)) {
+    const ids = providerRoster(alias);
+    const entries = ids.map((id) => ({ id: `${alias}/${id}`, owned_by: alias, root: id }));
+    const withVariants = appendClaudeEffortVariants(entries);
+    for (const entry of withVariants.slice(entries.length)) {
+      const publishedId = String(entry.id);
+      out.push({
+        alias,
+        publishedId,
+        bareId: publishedId.slice(publishedId.indexOf("/") + 1),
+      });
+    }
+  }
+  return out;
+}
+
+/** What the dispatcher would actually send upstream for `bareId` on `alias`. */
+function dispatch(alias: string, bareId: string) {
+  const body: Record<string, unknown> = { model: bareId };
+  const result = applyClaudeEffortVariant({
+    provider: alias,
+    effectiveModel: bareId,
+    body,
+    sourceFormat: "openai",
+  });
+  return { sent: result.effectiveModel, effort: body.reasoning_effort ?? null };
+}
+
+// ---------------------------------------------------------------------------
+// The round-trip invariant, swept over the whole registry
+// ---------------------------------------------------------------------------
+
+test("every effort variant the catalog mints strips back to a real base model", () => {
+  const minted = allMintedVariants();
+  // Non-vacuous: the sweep must actually cover a large, multi-provider surface.
+  assert.ok(minted.length > 200, `expected the registry to mint many variants; got ${minted.length}`);
+  const aliases = new Set(minted.map((m) => m.alias));
+  assert.ok(aliases.size > 20, `expected many providers to mint variants; got ${aliases.size}`);
+
+  const unstripped: string[] = [];
+  for (const { alias, publishedId, bareId } of minted) {
+    const { sent, effort } = dispatch(alias, bareId);
+    if (EFFORT_SUFFIX_RE.test(sent) || effort === null) {
+      unstripped.push(`${publishedId} → sent "${sent}" (effort=${String(effort)})`);
+    }
+  }
+  assert.deepEqual(
+    unstripped.slice(0, 8),
+    [],
+    `${unstripped.length} published effort ids would 404 upstream (suffix forwarded verbatim)`
+  );
+});
+
+test("no minted id carries two effort suffixes", () => {
+  const doubled = allMintedVariants()
+    .filter((m) => DOUBLE_SUFFIX_RE.test(m.bareId))
+    .map((m) => m.publishedId);
+  assert.deepEqual(
+    doubled.slice(0, 8),
+    [],
+    `${doubled.length} ids were minted on top of an existing effort suffix`
+  );
+});
+
+test("the catalog never mints an id the provider already serves as a real model", () => {
+  const clashes: string[] = [];
+  for (const { alias, publishedId, bareId } of allMintedVariants()) {
+    if (providerRoster(alias).includes(bareId)) clashes.push(publishedId);
+  }
+  assert.deepEqual(
+    clashes.slice(0, 8),
+    [],
+    `${clashes.length} minted ids collide with a real upstream SKU of a different meaning`
+  );
+});
+
+// ---------------------------------------------------------------------------
+// The tightening half: real suffixed SKUs must survive untouched
+// ---------------------------------------------------------------------------
+
+test("a real suffixed SKU is never rewritten, even though it looks like a variant", () => {
+  const rewritten: string[] = [];
+  let checked = 0;
+  for (const alias of Object.keys(PROVIDER_MODELS as Record<string, unknown>)) {
+    for (const id of providerRoster(alias)) {
+      if (!EFFORT_SUFFIX_RE.test(id)) continue;
+      checked += 1;
+      const { sent } = dispatch(alias, id);
+      if (sent !== id) rewritten.push(`${alias}/${id} → ${sent}`);
+    }
+  }
+  // Non-vacuous: there ARE such ids in the registry (Cursor, lmarena, devin, windsurf…).
+  assert.ok(checked > 100, `expected many real suffixed SKUs in the registry; got ${checked}`);
+  assert.deepEqual(
+    rewritten.slice(0, 8),
+    [],
+    `${rewritten.length} real upstream models were rerouted to a base id the provider does not serve`
+  );
+});
+
+test("Cursor's five distinct claude-opus-4-8 effort SKUs stay five distinct models", () => {
+  const cursorIds = providerRoster("cu");
+  const skus = ["low", "medium", "high", "xhigh", "max"].map((l) => `claude-opus-4-8-${l}`);
+  for (const sku of skus) {
+    assert.ok(cursorIds.includes(sku), `precondition: cursor must serve ${sku}`);
+    assert.equal(
+      isSynthesizedClaudeEffortVariant("cu", sku),
+      false,
+      `${sku} is a real cursor model, not a gateway variant`
+    );
+    assert.equal(dispatch("cu", sku).sent, sku, `${sku} must reach upstream unchanged`);
+  }
+  // And the base id genuinely is NOT offered — which is why stripping would break it.
+  assert.equal(
+    cursorIds.includes("claude-opus-4-8"),
+    false,
+    "precondition: cursor does not serve the unsuffixed base id"
+  );
+});
+
+// ---------------------------------------------------------------------------
+// Named regressions for the two ends of the bug
+// ---------------------------------------------------------------------------
+
+test("a non-Anthropic provider hosting Claude strips the suffix it published", () => {
+  const entry = { id: "anthropic/claude-fable-5", owned_by: "anthropic", root: "claude-fable-5" };
+  const published = appendClaudeEffortVariants([entry]).map((m) => String(m.id));
+  assert.ok(
+    published.includes("anthropic/claude-fable-5-high"),
+    `precondition: the catalog must publish this id; got ${JSON.stringify(published)}`
+  );
+
+  const { sent, effort } = dispatch("anthropic", "claude-fable-5-high");
+  assert.equal(sent, "claude-fable-5", "the suffix must be stripped before dispatch");
+  assert.equal(effort, "high", "and surfaced as reasoning_effort");
+});
+
+test("native claude passthrough still keeps its own thinking config", () => {
+  const body: Record<string, unknown> = { model: "claude-fable-5-high" };
+  const result = applyClaudeEffortVariant({
+    provider: "claude",
+    effectiveModel: "claude-fable-5-high",
+    body,
+    sourceFormat: "claude",
+  });
+  assert.equal(result.effectiveModel, "claude-fable-5", "the id is still normalized");
+  assert.equal(
+    body.reasoning_effort,
+    undefined,
+    "but a native Claude request carries `thinking` and must not gain reasoning_effort"
+  );
+});
+
+test("an explicit client-supplied effort outranks the stripped suffix", () => {
+  const body: Record<string, unknown> = { model: "claude-fable-5-high", reasoning_effort: "low" };
+  applyClaudeEffortVariant({
+    provider: "anthropic",
+    effectiveModel: "claude-fable-5-high",
+    body,
+    sourceFormat: "openai",
+  });
+  assert.equal(body.reasoning_effort, "low", "the client's own choice wins");
+});
+
+test("splitClaudeEffortSuffix and the mint gate share one suffix list", () => {
+  // The mint gate used a hand-written alternation that omitted "max". Prove both ends
+  // now agree for every suffix, using a model the gate would otherwise accept.
+  for (const level of CLAUDE_EFFORT_SUFFIXES) {
+    const suffixed = `claude-fable-5-${level}`;
+    assert.equal(
+      splitClaudeEffortSuffix(suffixed).effort,
+      level,
+      `strip must recognize -${level}`
+    );
+    assert.equal(
+      shouldExposeClaudeEffortVariants({
+        id: `anthropic/${suffixed}`,
+        owned_by: "anthropic",
+        root: suffixed,
+      }),
+      false,
+      `mint must refuse to double-suffix an id already ending in -${level}`
+    );
+  }
+});
+
+test("claudeEffortLevelsFor still gates xhigh on model support", () => {
+  assert.ok(
+    claudeEffortLevelsFor("anthropic", "claude-fable-5").includes("xhigh"),
+    "fable 5 supports extra-high effort"
+  );
+  assert.deepEqual(
+    claudeEffortLevelsFor("anthropic", "claude-haiku-4-5"),
+    ["low", "medium", "high"],
+    "haiku does not"
+  );
+});
diff --git a/tests/unit/combo-target-node-prefix.test.ts b/tests/unit/combo-target-node-prefix.test.ts
new file mode 100644
index 000000000..76b4d1813
--- /dev/null
+++ b/tests/unit/combo-target-node-prefix.test.ts
@@ -0,0 +1,104 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+
+/**
+ * A combo step that targets a CUSTOM compatible provider must resolve to the bare
+ * upstream model id.
+ *
+ * Combo steps persist `provider` as the raw node id (storage shape) while `modelStr`
+ * carries whatever the catalog published — i.e. `<nodePrefix>/<model>`. The strip in
+ * `getComboTargetModelId()` accepts a prefix only when `prefixRoutesToProvider()`
+ * says it routes to the provider, and that check is a `parseModel()` probe.
+ * `parseModel()` only knows the STATIC registry, so an operator-configured
+ * `provider_nodes.prefix` never matched: the only accepted prefix for such a
+ * provider was its own raw node id.
+ *
+ * Consequence: `"pix4k/claude-opus-5"` was returned verbatim as the *model id*, so
+ * every downstream lookup keyed by the bare id (registry model, model spec, synced
+ * capability, pricing) missed. In `computeComboContextLength` that member then fails
+ * the source check and contributes nothing to the min() — the combo silently reports
+ * a context window computed from its OTHER members only, or `undefined` when the
+ * compatible provider is its only member.
+ *
+ * The existing combo-context test uses `glm/glm-5.2`, a STATIC registry alias, so it
+ * passed throughout.
+ */
+
+const maps = await import("../../src/app/api/v1/models/catalogProviderMaps.ts");
+
+const NODE_ID = "anthropic-compatible-abababab-cdcd-efef-0101-232323232323";
+const NODE_PREFIX = "pix4k";
+const MODEL = "claude-opus-5";
+
+const aliasMaps = maps.buildAliasMaps();
+
+test("a prefix-qualified modelStr on a compatible node resolves to the bare model id", () => {
+  const resolved = maps.getComboTargetModelId(
+    aliasMaps,
+    { provider: NODE_ID, modelStr: `${NODE_PREFIX}/${MODEL}` },
+    NODE_PREFIX
+  );
+
+  assert.deepEqual(resolved, { providerId: NODE_ID, modelId: MODEL });
+});
+
+test("without the node prefix the same input keeps the prefix glued on (the defect)", () => {
+  // Pinning the old behaviour so the reason the parameter exists stays visible:
+  // this is exactly what every lookup downstream received.
+  const resolved = maps.getComboTargetModelId(aliasMaps, {
+    provider: NODE_ID,
+    modelStr: `${NODE_PREFIX}/${MODEL}`,
+  });
+
+  assert.equal(
+    resolved?.modelId,
+    `${NODE_PREFIX}/${MODEL}`,
+    "with no prefix supplied the strip cannot fire — callers must pass provider_nodes.prefix"
+  );
+});
+
+test("the node-id-qualified shape keeps resolving (combo steps also store this)", () => {
+  const resolved = maps.getComboTargetModelId(
+    aliasMaps,
+    { provider: NODE_ID, modelStr: `${NODE_ID}/${MODEL}` },
+    NODE_PREFIX
+  );
+
+  assert.deepEqual(resolved, { providerId: NODE_ID, modelId: MODEL });
+});
+
+test("getProviderPrefixes reports the operator prefix as a routable prefix", () => {
+  const prefixes = maps.getProviderPrefixes(aliasMaps, NODE_ID, NODE_ID, NODE_PREFIX);
+
+  assert.ok(
+    prefixes.includes(NODE_PREFIX),
+    `the configured prefix must be accepted; got ${JSON.stringify(prefixes)}`
+  );
+  assert.ok(prefixes.includes(NODE_ID), "the raw node id must stay accepted");
+});
+
+test("a prefix that is NOT this node's is still rejected", () => {
+  // Widening must not turn the strip into 'peel any leading segment', which would
+  // corrupt ids that legitimately contain a slash.
+  const resolved = maps.getComboTargetModelId(
+    aliasMaps,
+    { provider: NODE_ID, modelStr: `someone-elses-prefix/${MODEL}` },
+    NODE_PREFIX
+  );
+
+  assert.equal(
+    resolved?.modelId,
+    `someone-elses-prefix/${MODEL}`,
+    "only this provider's own names may be stripped"
+  );
+});
+
+test("a bare modelStr is passed through untouched", () => {
+  const resolved = maps.getComboTargetModelId(
+    aliasMaps,
+    { provider: NODE_ID, modelStr: MODEL },
+    NODE_PREFIX
+  );
+
+  assert.deepEqual(resolved, { providerId: NODE_ID, modelId: MODEL });
+});
