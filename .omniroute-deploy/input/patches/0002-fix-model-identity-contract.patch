+/**
+ * Fallback model roster for *compatible* provider nodes.
+ *
+ * A compatible node normally gets its roster from a live models-endpoint sync.
+ * Two kinds cannot: OpenRouter hands its own list to the caller, and a CC
+ * (claude-code-compatible) node has no models endpoint at all and serves the
+ * Claude roster. These two helpers answer "what do I show when there is nothing
+ * synced" and "may this node be synced at all".
+ *
+ * Renamed from `managedAvailableModels.ts`, which collided by name with
+ * `src/lib/providerModels/managedAvailableModels.ts` — a completely different
+ * module (alias bookkeeping for managed available models). Two files with one
+ * name and no shared exports meant an import could only be told apart by its
+ * directory, and `@/lib/providers/…` vs `@/lib/providerModels/…` differ by three
+ * characters.
+ *
+ * @module lib/providers/compatibleFallbackModels
+ */
+
+import { getModelsByProviderId } from "@/shared/constants/models";
+import { isClaudeCodeCompatibleProvider } from "@/shared/constants/providers";
+
+type CompatibleFallbackModel = {
+  id?: string;
+  name?: string;
+  contextLength?: number;
+};
+
+export function getCompatibleFallbackModels(
+  providerId: string,
+  fallbackModels: CompatibleFallbackModel[] = []
+): CompatibleFallbackModel[] | undefined {
+  if (providerId === "openrouter") return fallbackModels;
+  if (isClaudeCodeCompatibleProvider(providerId)) return getModelsByProviderId("claude");
+  return undefined;
+}
+
+export function compatibleProviderSupportsModelImport(providerId: string): boolean {
+  return !isClaudeCodeCompatibleProvider(providerId);
+}
