index 000000000..c992d0241
--- /dev/null
+++ b/tests/unit/provider-identity-resolver.test.ts
@@ -0,0 +1,145 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+
+import {
+  resolveProviderIdentity,
+  resolveProviderSegment,
+  splitProviderSegment,
+  getPublicProviderPrefix,
+  isPublishableProviderSegment,
+  isSyntheticModelNamespace,
+} from "../../src/shared/providers/identity.ts";
+
+/**
+ * Canonical provider-identity resolver.
+ *
+ * The defect class this replaces: a dozen call sites did `split("/")[0]` and used
+ * segment 0 as a provider *node id*. That holds for exactly one of the five id
+ * shapes the catalog publishes, so every other shape resolved to a provider that
+ * does not exist — and because the api-key gate does this on the inference path,
+ * an advertised id became uncallable, not merely invisible.
+ *
+ * Each test below pins one shape that used to break.
+ */
+
+const NODE_ID = "anthropic-compatible-675899fb-8be4-41a4-8c75-1af39c62b044";
+
+const NODES = [
+  { id: NODE_ID, prefix: "pix4k", type: "anthropic-compatible", name: "Pix4k" },
+  { id: "openai-compatible-chat-1111", prefix: "  ", type: "openai-compatible", name: "NoPrefix" },
+];
+
+// A trimmed stand-in for the registry-derived maps.
+const ALIAS_TO_PROVIDER_ID = {
+  antigravity: "antigravity",
+  ag: "antigravity",
+  codex: "codex",
+  cx: "codex",
+  openai: "openai",
+};
+const PROVIDER_ID_TO_ALIAS = {
+  antigravity: "ag",
+  codex: "cx",
+  openai: "openai",
+};
+
+const OPTS = {
+  nodes: NODES,
+  aliasToProviderId: ALIAS_TO_PROVIDER_ID,
+  providerIdToAlias: PROVIDER_ID_TO_ALIAS,
+};
+
+test("splitProviderSegment splits on the FIRST slash only", () => {
+  // `split("/")[1]` truncated every namespaced model id — openrouter/<vendor>/<model>
+  // lost its tail, which is why such ids could be published but never called back.
+  assert.deepEqual(splitProviderSegment("openrouter/vendor/model-x"), {
+    segment: "openrouter",
+    rest: "vendor/model-x",
+  });
+  assert.deepEqual(splitProviderSegment("gpt-5.6"), { segment: null, rest: "gpt-5.6" });
+  assert.deepEqual(splitProviderSegment("  cx/gpt-5.6  "), { segment: "cx", rest: "gpt-5.6" });
+});
+
+test("a node PREFIX resolves to the node id, not to itself", () => {
+  // The original bug: `pix4k/<model>` was looked up under provider "pix4k", which
+  // is not a key in syncedAvailableModels, so the model read as non-public.
+  const resolved = resolveProviderIdentity("pix4k/claude-opus-5", OPTS);
+  assert.equal(resolved.providerId, NODE_ID, "storage lookups must use the node id");
+  assert.equal(resolved.modelId, "claude-opus-5");
+  assert.equal(resolved.kind, "nodePrefix");
+});
+
+test("a raw node id still resolves (combo steps store this shape)", () => {
+  const resolved = resolveProviderIdentity(`${NODE_ID}/claude-opus-5`, OPTS);
+  assert.equal(resolved.providerId, NODE_ID);
+  assert.equal(resolved.modelId, "claude-opus-5");
+  assert.equal(resolved.kind, "nodeId");
+});
+
+test("a registry alias resolves to the canonical provider id", () => {
+  // `cx/gpt-5.6` is the id the catalog publishes by default (dual prefix mode), so
+  // a client copying it verbatim must not be denied.
+  const byAlias = resolveProviderIdentity("cx/gpt-5.6", OPTS);
+  assert.equal(byAlias.providerId, "codex");
+  assert.equal(byAlias.kind, "alias");
+
+  const byId = resolveProviderIdentity("codex/gpt-5.6", OPTS);
+  assert.equal(byId.providerId, "codex");
+  assert.equal(byId.kind, "providerId", "an already-canonical segment is not an alias");
+});
+
+test("a bare model id yields no provider rather than a bogus one", () => {
+  // Inference is a routing policy, not an identity fact — the resolver must not
+  // invent a provider. The old code produced shortModelId "" and denied outright.
+  const resolved = resolveProviderIdentity("gpt-5.6", OPTS);
+  assert.equal(resolved.providerId, null);
+  assert.equal(resolved.modelId, "gpt-5.6");
+});
+
+test("synthetic namespaces are recognized and see through to the real provider", () => {
+  assert.ok(isSyntheticModelNamespace("no-think"));
+  assert.ok(isSyntheticModelNamespace("qtSd"));
+  assert.ok(!isSyntheticModelNamespace("pix4k"));
+
+  // `no-think/pix4k/<model>` must resolve to the pix4k node, NOT to "no-think".
+  const seen = resolveProviderIdentity("no-think/pix4k/claude-opus-5", OPTS);
+  assert.equal(seen.providerId, NODE_ID);
+  assert.equal(seen.modelId, "claude-opus-5");
+
+  // A synthetic segment with nothing provider-shaped behind it stays synthetic.
+  const bare = resolveProviderSegment("auto", OPTS);
+  assert.equal(bare.kind, "synthetic");
+});
+
+test("a built-in id/alias wins over a colliding node prefix", () => {
+  // A node whose prefix shadows a built-in must not hijack it. Prefix collisions
+  // are rejected at write time, but pre-existing rows and direct-DB edits exist.
+  const hijacker = [{ id: "openai-compatible-chat-9999", prefix: "openai" }];
+  const resolved = resolveProviderSegment("openai", { ...OPTS, nodes: hijacker });
+  assert.equal(resolved.providerId, "openai");
+  assert.equal(resolved.kind, "providerId");
+});
+
+test("an unknown segment passes through unchanged", () => {
+  const resolved = resolveProviderSegment("totally-unknown", OPTS);
+  assert.equal(resolved.providerId, "totally-unknown");
+  assert.equal(resolved.kind, "unknown");
+});
+
+test("getPublicProviderPrefix prefers node prefix, then alias, then the id", () => {
+  assert.equal(getPublicProviderPrefix(NODE_ID, OPTS), "pix4k", "operator prefix wins");
+  assert.equal(getPublicProviderPrefix("codex", OPTS), "cx", "registry alias next");
+  assert.equal(
+    getPublicProviderPrefix("openai-compatible-chat-1111", OPTS),
+    "openai-compatible-chat-1111",
+    "a blank prefix must not publish an empty segment; fall back to the id"
+  );
+});
+
+test("isPublishableProviderSegment rejects raw compatible-node ids", () => {
+  // A raw UUID node id is a storage detail. Clients group by the segment and
+  // render it verbatim, so leaking it produced UUID-named pseudo-providers.
+  assert.ok(!isPublishableProviderSegment(NODE_ID));
+  assert.ok(isPublishableProviderSegment("pix4k"));
+  assert.ok(isPublishableProviderSegment("cx"));
+});
diff --git a/tests/unit/provider-node-prefix-validation.test.ts b/tests/unit/provider-node-prefix-validation.test.ts
new file mode 100644
index 000000000..08e16e53f
--- /dev/null
+++ b/tests/unit/provider-node-prefix-validation.test.ts
@@ -0,0 +1,328 @@
+/**
+ * tests/unit/provider-node-prefix-validation.test.ts
+ *
+ * A provider node's `prefix` becomes the first segment of every model id it publishes,
+ * and the request path resolves that segment back to a provider. Nothing validated it —
+ * the schema only did `.trim().min(1)` and the column has no UNIQUE constraint — so three
+ * shapes of permanently-broken configuration saved cleanly through the normal UI. All
+ * three were reproduced against the real routes before the fix:
+ *
+ *   • prefix shadowing a BUILT-IN id/alias ("openai", "vllm", "lm-studio", "zed"):
+ *     `getModelInfo("openai/gpt-4o")` still resolved to the built-in, so the node was
+ *     unreachable. The reserved set the router consulted was built from REGISTRY alone
+ *     (328 names) and missed the 122 ids that live only in AI_PROVIDERS.
+ *
+ *   • prefix shadowing a SYNTHETIC namespace ("auto", "combo", "no-think", "qtSd"):
+ *     here the node WINS — verified that a node with prefix `auto` captured
+ *     `auto/best` and one with prefix `no-think` captured `no-think/openai/gpt-4o`, so a
+ *     single node silently took over auto-routing and the no-thinking alias namespace.
+ *
+ *   • DUPLICATE prefix: both nodes saved, and the first one won every lookup, leaving the
+ *     second permanently dead.
+ *
+ * Policy (operator's decision): block new/edited nodes, only WARN about pre-existing rows.
+ * A hard UNIQUE constraint was rejected because migrations are all-or-nothing and a
+ * failure stops the DB from starting, which would brick any install that already has a
+ * duplicate. So these tests also pin that existing rows are REPORTED and never rewritten.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+const TEST_DATA_DIR = fs.mkdtempSync(path.join(os.tmpdir(), "omniroute-node-prefix-"));
+process.env.DATA_DIR = TEST_DATA_DIR;
+process.env.API_KEY_SECRET = process.env.API_KEY_SECRET || "node-prefix-test-secret";
+
+const coreDb = await import("../../src/lib/db/core.ts");
+const nodesDb = await import("../../src/lib/db/providers/nodes.ts");
+const readCache = await import("../../src/lib/db/readCache.ts");
+const modelSvc = await import("../../src/sse/services/model.ts");
+const nodesRoute = await import("../../src/app/api/provider-nodes/route.ts");
+const nodeIdRoute = await import("../../src/app/api/provider-nodes/[id]/route.ts");
+const { validateProviderNodePrefix, findProviderNodePrefixConflicts, getReservedNodePrefixes } =
+  await import("../../src/shared/providers/nodePrefix.ts");
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+
+async function resetStorage() {
+  coreDb.resetDbInstance();
+  for (let attempt = 0; attempt < 10; attempt++) {
+    try {
+      if (fs.existsSync(TEST_DATA_DIR)) fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true });
+      break;
+    } catch (error: unknown) {
+      const err = error as NodeJS.ErrnoException;
+      if ((err?.code === "EBUSY" || err?.code === "EPERM") && attempt < 9) {
+        await new Promise((resolve) => setTimeout(resolve, 50 * (attempt + 1)));
+      } else {
+        throw error;
+      }
+    }
+  }
+  fs.mkdirSync(TEST_DATA_DIR, { recursive: true });
+  readCache.invalidateDbCache?.();
+}
+
+const BASE_NODE = {
+  type: "openai-compatible" as const,
+  apiType: "chat" as const,
+  baseUrl: "https://node.example/v1",
+  name: "Test Node",
+};
+
+async function createViaRoute(prefix: string, overrides: Record<string, unknown> = {}) {
+  const response = await nodesRoute.POST(
+    new Request("http://localhost/api/provider-nodes", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ ...BASE_NODE, prefix, ...overrides }),
+    }) as never
+  );
+  const body = (await response.json()) as {
+    node?: { id?: string; prefix?: string };
+    error?: { code?: string; message?: string };
+  };
+  return { status: response.status, body };
+}
+
+async function updateViaRoute(id: string, prefix: string) {
+  const response = await nodeIdRoute.PUT(
+    new Request(`http://localhost/api/provider-nodes/${id}`, {
+      method: "PUT",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ ...BASE_NODE, prefix }),
+    }) as never,
+    { params: Promise.resolve({ id }) }
+  );
+  const body = (await response.json()) as { error?: { code?: string } };
+  return { status: response.status, body };
+}
+
+/** Write a row straight to the DB, bypassing the route — a pre-fix / legacy node. */
+async function seedLegacyNode(id: string, prefix: string) {
+  await nodesDb.createProviderNode({
+    id,
+    type: "openai-compatible",
+    name: `legacy-${prefix}`,
+    prefix,
+    apiType: "chat",
+    baseUrl: "https://legacy.example/v1",
+  } as never);
+  readCache.invalidateDbCache?.();
+}
+
+test.beforeEach(async () => {
+  await resetStorage();
+});
+
+test.after(async () => {
+  coreDb.resetDbInstance();
+  fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true });
+});
+
+// ---------------------------------------------------------------------------
+// Reserved set completeness — the root cause of the built-in shadowing
+// ---------------------------------------------------------------------------
+
+test("the reserved set covers AI_PROVIDERS ids, not just the REGISTRY", async () => {
+  const reserved = getReservedNodePrefixes();
+  // Present in AI_PROVIDERS but absent from REGISTRY — the gap a node could shadow.
+  for (const providerId of ["vllm", "lm-studio", "zed", "azure", "copilot", "cliproxyapi"]) {
+    assert.ok(reserved.has(providerId), `"${providerId}" must be reserved`);
+  }
+  // And the registry half still applies.
+  for (const providerId of ["openai", "claude", "codex"]) {
+    assert.ok(reserved.has(providerId), `"${providerId}" must be reserved`);
+  }
+  assert.ok(reserved.size > 400, `expected both sources merged; got ${reserved.size} names`);
+});
+
+// ---------------------------------------------------------------------------
+// Creation is blocked
+// ---------------------------------------------------------------------------
+
+test("creating a node whose prefix shadows a built-in provider is rejected", async () => {
+  for (const prefix of ["openai", "vllm", "lm-studio", "zed"]) {
+    const { status, body } = await createViaRoute(prefix);
+    assert.equal(status, 400, `"${prefix}" must be refused`);
+    assert.equal(body.error?.code, "reserved-provider");
+  }
+});
+
+test("creating a node whose prefix captures a synthetic namespace is rejected", async () => {
+  for (const prefix of ["auto", "combo", "no-think", "qtSd"]) {
+    const { status, body } = await createViaRoute(prefix);
+    assert.equal(status, 400, `"${prefix}" must be refused`);
+    assert.equal(
+      body.error?.code,
+      "reserved-synthetic",
+      `"${prefix}" must be refused as a synthetic namespace, not by shape`
+    );
+  }
+  // Case-folded too: the namespace set itself is mixed-case ("qtSd"), so a lowercase
+  // spelling must not slip through.
+  const lowered = await createViaRoute("qtsd");
+  assert.equal(lowered.body.error?.code, "reserved-synthetic");
+});
+
+test("a duplicate prefix is rejected, case-insensitively", async () => {
+  const first = await createViaRoute("mynode");
+  assert.equal(first.status, 201, "the first claim succeeds");
+
+  const second = await createViaRoute("mynode");
+  assert.equal(second.status, 400);
+  assert.equal(second.body.error?.code, "duplicate");
+
+  const casedVariant = await createViaRoute("MyNode");
+  assert.equal(
+    casedVariant.body.error?.code,
+    "duplicate",
+    "a differently-cased spelling would compete for the same ids"
+  );
+});
+
+test("malformed prefixes are rejected but ordinary and mixed-case ones are accepted", async () => {
+  for (const bad of ["has space", "a/b", "-lead", "trail-", "with?q"]) {
+    const { status, body } = await createViaRoute(bad);
+    assert.equal(status, 400, `"${bad}" must be refused`);
+    assert.equal(body.error?.code, "shape", `"${bad}" should fail on shape`);
+  }
+  // An empty prefix is already caught upstream by the Zod schema ("Prefix is required"),
+  // which reports a field issue rather than one of this validator's codes.
+  const empty = await createViaRoute("");
+  assert.equal(empty.status, 400, "an empty prefix is still refused");
+  // Mixed case IS valid: segment resolution is case-sensitive, so an uppercase prefix
+  // routes fine, and refusing it would lock existing nodes out of the edit form.
+  const ok = await createViaRoute("Pix4K");
+  assert.equal(ok.status, 201, `expected Pix4K to be accepted; got ${JSON.stringify(ok.body)}`);
+  assert.equal(ok.body.node?.prefix, "Pix4K", "the prefix is stored verbatim, not lowercased");
+});
+
+// ---------------------------------------------------------------------------
+// Editing is blocked the same way, but a no-op re-save is not a self-collision
+// ---------------------------------------------------------------------------
+
+test("editing a node onto a reserved or duplicate prefix is rejected", async () => {
+  const mine = await createViaRoute("mine");
+  const other = await createViaRoute("other");
+  const mineId = mine.body.node?.id as string;
+  assert.ok(mineId && other.status === 201, "precondition: two nodes exist");
+
+  assert.equal((await updateViaRoute(mineId, "openai")).body.error?.code, "reserved-provider");
+  assert.equal((await updateViaRoute(mineId, "auto")).body.error?.code, "reserved-synthetic");
+  assert.equal((await updateViaRoute(mineId, "other")).body.error?.code, "duplicate");
+});
+
+test("re-saving a node with its own prefix unchanged succeeds", async () => {
+  const created = await createViaRoute("keepme");
+  const id = created.body.node?.id as string;
+  assert.ok(id);
+
+  const resaved = await updateViaRoute(id, "keepme");
+  assert.equal(resaved.status, 200, `a no-op re-save must not self-collide: ${JSON.stringify(resaved.body)}`);
+});
+
+// ---------------------------------------------------------------------------
+// Pre-existing rows: warned about, never rewritten
+// ---------------------------------------------------------------------------
+
+test("pre-existing conflicting rows are reported by the listing and left untouched", async () => {
+  await seedLegacyNode("openai-compatible-chat-legacy-builtin", "openai");
+  await seedLegacyNode("openai-compatible-chat-legacy-synthetic", "auto");
+  await seedLegacyNode("openai-compatible-chat-legacy-dup-a", "shared");
+  await seedLegacyNode("openai-compatible-chat-legacy-dup-b", "shared");
+  await seedLegacyNode("openai-compatible-chat-legacy-fine", "fine");
+
+  const response = await nodesRoute.GET(new Request("http://localhost/api/provider-nodes") as never);
+  const body = (await response.json()) as {
+    nodes?: Array<{ id?: string; prefix?: string }>;
+    prefixConflicts?: Array<{ nodeId: string; prefix: string; reason: string }>;
+  };
+
+  const byReason = new Map((body.prefixConflicts ?? []).map((c) => [c.nodeId, c.reason]));
+  assert.equal(byReason.get("openai-compatible-chat-legacy-builtin"), "reserved-provider");
+  assert.equal(byReason.get("openai-compatible-chat-legacy-synthetic"), "reserved-synthetic");
+  assert.equal(byReason.get("openai-compatible-chat-legacy-dup-b"), "duplicate");
+  assert.equal(
+    byReason.has("openai-compatible-chat-legacy-dup-a"),
+    false,
+    "the first holder of a duplicated prefix is the one that works; it is not the conflict"
+  );
+  assert.equal(byReason.has("openai-compatible-chat-legacy-fine"), false, "a valid prefix is clean");
+
+  // Nothing was migrated or rewritten — the ids clients pinned still resolve as before.
+  const stored = (body.nodes ?? []).find((n) => n.id === "openai-compatible-chat-legacy-builtin");
+  assert.equal(stored?.prefix, "openai", "a conflicting prefix must be reported, not repaired");
+});
+
+test("findProviderNodePrefixConflicts ignores rows with no prefix", () => {
+  const conflicts = findProviderNodePrefixConflicts([
+    { id: "n1", prefix: null },
+    { id: "n2", prefix: "   " },
+    { id: "n3", prefix: "openai" },
+  ]);
+  assert.deepEqual(
+    conflicts.map((c) => c.nodeId),
+    ["n3"]
+  );
+});
+
+// ---------------------------------------------------------------------------
+// The behaviour the validation exists to prevent — pinned so the "why" stays visible
+// ---------------------------------------------------------------------------
+
+test("a legacy built-in-shadowing node really is unreachable (why creation is blocked)", async () => {
+  await seedLegacyNode("openai-compatible-chat-shadow", "openai");
+  const info = (await modelSvc.getModelInfo("openai/gpt-4o")) as { provider?: string };
+  assert.equal(
+    info?.provider,
+    "openai",
+    "built-ins win segment resolution, so the node never receives its own published ids"
+  );
+});
+
+test("a legacy synthetic-namespace node really does hijack gateway routing", async () => {
+  await seedLegacyNode("openai-compatible-chat-hijack", "no-think");
+  const info = (await modelSvc.getModelInfo("no-think/openai/gpt-4o")) as { provider?: string };
+  assert.equal(
+    info?.provider,
+    "openai-compatible-chat-hijack",
+    "here the node wins — which is why the prefix must be refused at write time"
+  );
+});
+
+// ---------------------------------------------------------------------------
+// Validator unit contract
+// ---------------------------------------------------------------------------
+
+test("validateProviderNodePrefix returns null only for acceptable prefixes", () => {
+  assert.equal(validateProviderNodePrefix("pix4k"), null);
+  assert.equal(validateProviderNodePrefix("  pix4k  "), null, "surrounding space is trimmed");
+  assert.equal(validateProviderNodePrefix("my.node_1-x"), null);
+
+  assert.equal(validateProviderNodePrefix("")?.code, "empty");
+  assert.equal(validateProviderNodePrefix(null)?.code, "empty");
+  assert.equal(validateProviderNodePrefix("a".repeat(65))?.code, "too-long");
+  assert.equal(validateProviderNodePrefix("openai")?.code, "reserved-provider");
+  assert.equal(validateProviderNodePrefix("auto")?.code, "reserved-synthetic");
+
+  const dup = validateProviderNodePrefix("taken", {
+    existingNodes: [{ id: "node-1", prefix: "taken" }],
+  });
+  assert.equal(dup?.code, "duplicate");
+  assert.equal(dup?.conflictingNodeId, "node-1");
+
+  assert.equal(
+    validateProviderNodePrefix("taken", {
+      existingNodes: [{ id: "node-1", prefix: "taken" }],
+      selfNodeId: "node-1",
+    }),
+    null,
+    "a node keeping its own prefix is not a conflict"
+  );
+});
diff --git a/tests/unit/provider-scoped-models-compatible.test.ts b/tests/unit/provider-scoped-models-compatible.test.ts
new file mode 100644
index 000000000..5816c2435
--- /dev/null
+++ b/tests/unit/provider-scoped-models-compatible.test.ts
@@ -0,0 +1,152 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+/**
+ * `GET /v1/providers/{provider}/models` for a CUSTOM compatible provider.
+ *
+ * This endpoint feeds the provider-detail Playground and the "test model" dialog.
+ * Both showed no selectable model for a custom provider, and the endpoint was in
+ * fact returning `{"object":"list","data":[]}` — verified against a live install.
+ *
+ * Two independent causes, both about the same identity mismatch:
+ *
+ *   1. the route matched `model.owned_by === providerId` (the raw node id), but
+ *      #8327 deliberately made the PUBLIC `owned_by` the operator's prefix via
+ *      resolvePublicOwnerId(). node id !== prefix, so every row was filtered out;
+ *   2. the route accepted only the node id in the URL, so the prefix — the very
+ *      name the catalog advertises — answered `400 Unknown provider`. The provider
+ *      was therefore unreachable under BOTH of its names.
+ *
+ * The pre-existing provider-scoped test covers built-in providers only, where the
+ * alias and the canonical id coincide, so it passed throughout.
+ */
+
+const TEST_DATA_DIR = fs.mkdtempSync(path.join(os.tmpdir(), "omniroute-provider-models-compat-"));
+process.env.DATA_DIR = TEST_DATA_DIR;
+
+const core = await import("../../src/lib/db/core.ts");
+const providersDb = await import("../../src/lib/db/providers.ts");
+const modelsDb = await import("../../src/lib/db/models.ts");
+const readCache = await import("../../src/lib/db/readCache.ts");
+const v1Catalog = await import("../../src/app/api/v1/models/catalog.ts");
+const providerModelsRoute =
+  await import("../../src/app/api/v1/providers/[provider]/models/route.ts");
+
+const NODE_ID = "anthropic-compatible-aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee";
+const NODE_PREFIX = "pix4k";
+const VISIBLE_MODEL = "claude-opus-5";
+const HIDDEN_MODEL = "claude-sonnet-4";
+
+type ModelsResponse = {
+  object?: string;
+  data?: Array<Record<string, unknown>>;
+  error?: { message?: string; code?: string };
+};
+
+async function resetStorage() {
+  core.resetDbInstance();
+  fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true });
+  fs.mkdirSync(TEST_DATA_DIR, { recursive: true });
+}
+
+async function seedCompatibleProvider() {
+  await providersDb.createProviderNode({
+    id: NODE_ID,
+    type: "anthropic-compatible",
+    name: "Pix4k",
+    prefix: NODE_PREFIX,
+    baseUrl: "https://example.invalid/v1",
+  } as never);
+
+  const connection = await providersDb.createProviderConnection({
+    provider: NODE_ID,
+    authType: "apikey",
+    name: "pix4k-main",
+    apiKey: "sk-test",
+    isActive: true,
+    testStatus: "active",
+    providerSpecificData: {},
+  } as never);
+
+  await modelsDb.replaceSyncedAvailableModelsForConnection(
+    NODE_ID,
+    (connection as { id: string }).id,
+    [{ id: VISIBLE_MODEL }, { id: HIDDEN_MODEL }] as never
+  );
+
+  // provider_nodes and the catalog payload are both cached; clear them so the
+  // route sees the rows this test just wrote.
+  readCache.invalidateReadCaches?.();
+  v1Catalog.__resetCatalogBuilderRunsForTest?.();
+  return connection as { id: string };
+}
+
+const call = async (provider: string): Promise<ModelsResponse> => {
+  const response = await providerModelsRoute.GET(
+    new Request(`http://localhost/v1/providers/${provider}/models`),
+    { params: Promise.resolve({ provider }) }
+  );
+  return (await response.json()) as ModelsResponse;
+};
+
+test.beforeEach(async () => {
+  await resetStorage();
+});
+
+test.after(async () => {
+  core.resetDbInstance();
+  fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true });
+});
+
+test("addressing a compatible provider by its PREFIX returns its models", async () => {
+  await seedCompatibleProvider();
+
+  const body = await call(NODE_PREFIX);
+  assert.equal(body.error, undefined, `prefix must be accepted, got: ${body.error?.message}`);
+  const ids = (body.data ?? []).map((m) => m.id);
+  assert.ok(
+    ids.includes(VISIBLE_MODEL),
+    `expected the synced model with an unprefixed id; got ${JSON.stringify(ids)}`
+  );
+});
+
+test("addressing the same provider by its NODE ID also returns its models", async () => {
+  await seedCompatibleProvider();
+
