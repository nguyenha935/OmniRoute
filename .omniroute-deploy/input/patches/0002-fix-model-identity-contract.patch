diff --git a/tests/unit/no-thinking-alias-root-contract.test.ts b/tests/unit/no-thinking-alias-root-contract.test.ts
new file mode 100644
index 000000000..beac651ed
--- /dev/null
+++ b/tests/unit/no-thinking-alias-root-contract.test.ts
@@ -0,0 +1,94 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+
+/**
+ * `root` on a catalog entry is the UNPREFIXED base model id — the id every metadata
+ * consumer keys off. `appendNoThinkingVariants` was the one variant helper that set
+ * `root` to its own synthetic id instead:
+ *
+ *     const variant = { ...model, id: aliasId, root: aliasId };   // "no-think/claude/claude-opus-4-6"
+ *
+ * `enrichCatalogModelEntry()` reads `asNonEmptyString(entry.root)` FIRST when deciding
+ * which model to look up (modelMetadataRegistry.ts), so the registry lookup missed and
+ * the published no-thinking entry lost `context_length`, `max_input_tokens` and
+ * `max_output_tokens` — a client saw the variant advertise no context window at all
+ * while the real model advertises 1M. The sibling helper `appendClaudeEffortVariants`
+ * already documents and honours the unprefixed-root contract; this pins the same for
+ * the no-thinking pass, on both the helper and the enrichment it feeds.
+ */
+
+const noThink = await import("../../open-sse/utils/noThinkingAlias.ts");
+const registry = await import("../../src/lib/modelMetadataRegistry.ts");
+
+const BASE_MODEL = "claude-opus-4-6";
+const BASE_ID = `claude/${BASE_MODEL}`;
+
+function baseEntry() {
+  return {
+    id: BASE_ID,
+    object: "model",
+    owned_by: "claude",
+    root: BASE_MODEL,
+    name: "Claude Opus 4.6",
+    supportsThinking: true,
+  };
+}
+
+function variantOf(entry: Record<string, unknown>) {
+  const models = noThink.appendNoThinkingVariants([entry] as never) as Array<
+    Record<string, unknown>
+  >;
+  assert.equal(models.length, 2, "the base model must be eligible for a no-thinking variant");
+  return models[1];
+}
+
+test("the no-thinking variant keeps the base model's unprefixed root", () => {
+  const variant = variantOf(baseEntry());
+
+  assert.equal(variant.id, `no-think/${BASE_ID}`, "the id carries the gateway prefix");
+  assert.equal(
+    variant.root,
+    BASE_MODEL,
+    "root is the model, not the address — it must not carry no-think/ or the provider"
+  );
+});
+
+test("without a root on the source entry, the bare model name is derived", () => {
+  const { root: _dropped, ...noRoot } = baseEntry();
+  const variant = variantOf(noRoot);
+
+  assert.equal(variant.root, BASE_MODEL, "fall back to the last path segment, never the alias id");
+});
+
+test("enrichment resolves registry metadata for the variant (the user-visible defect)", () => {
+  const variant = variantOf(baseEntry());
+  const enriched = registry.enrichCatalogModelEntry(variant as never) as Record<string, unknown>;
+
+  assert.ok(
+    typeof enriched.context_length === "number" && enriched.context_length > 0,
+    `the variant must advertise a context window; got ${JSON.stringify(enriched.context_length)}`
+  );
+
+  // And the same window as the model it aliases — the variant is the same model.
+  const enrichedBase = registry.enrichCatalogModelEntry(baseEntry() as never) as Record<
+    string,
+    unknown
+  >;
+  assert.equal(
+    enriched.context_length,
+    enrichedBase.context_length,
+    "a no-thinking variant advertises the same window as the model it addresses"
+  );
+  assert.equal(enriched.max_output_tokens, enrichedBase.max_output_tokens);
+  assert.equal(enriched.max_input_tokens, enrichedBase.max_input_tokens);
+});
+
+test("the base entry is returned untouched alongside the variant", () => {
+  const entry = baseEntry();
+  const models = noThink.appendNoThinkingVariants([entry] as never) as Array<
+    Record<string, unknown>
+  >;
+
+  assert.equal(models[0].id, BASE_ID);
+  assert.equal(models[0].root, BASE_MODEL, "appending a variant must not mutate the base row");
+});
diff --git a/tests/unit/pricing-model-id-spelling-parity.test.ts b/tests/unit/pricing-model-id-spelling-parity.test.ts
new file mode 100644
index 000000000..3b834b0b0
--- /dev/null
+++ b/tests/unit/pricing-model-id-spelling-parity.test.ts
@@ -0,0 +1,115 @@
+/**
+ * tests/unit/pricing-model-id-spelling-parity.test.ts
+ *
+ * The same Claude model is spelled two ways across the registry — providers use
+ * whatever their upstream accepts, so `anthropic` ships `claude-opus-4.7` while
+ * `cc`/`vp`/`cmd` ship `claude-opus-4-7`. That is correct: those strings are sent
+ * upstream, and normalising the DATA would break the requests.
+ *
+ * What must not diverge is anything that COMPARES those strings.
+ * `getPricingForModel(provider, model)` is a verbatim object lookup, so a pricing
+ * table listing only one spelling silently drops cost accounting for the other.
+ * The anthropic table already doubles up its entries deliberately
+ * ("Intentional duplicates of dot-notation variants") — it had simply missed one.
+ *
+ * Measured across every provider with a pricing table, exactly two rows resolved to
+ * no pricing purely because of spelling — and the sweep found a second kind of
+ * mismatch the dot-vs-dash framing would have missed:
+ *
+ *   anthropic/claude-opus-4.7        priced only as "claude-opus-4-7"        (dot vs dash)
+ *   minimax/MiniMax-M2.7-highspeed   priced only as "minimax-m2.7-highspeed" (case)
+ *
+ * Both tables already double up their entries on purpose; each had missed exactly
+ * one row, which therefore billed at the default rate. Remaining pricing misses are
+ * providers with no pricing table at all — a separate concern, not asserted here.
+ *
+ * The sweep is written structurally so a future model added with one spelling and
+ * priced under another fails here.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+
+const { PROVIDER_MODELS } = await import("../../open-sse/config/providerModels.ts");
+const { getPricingForModel, getDefaultPricing } = await import(
+  "../../src/shared/constants/pricing.ts"
+);
+
+type ModelEntry = { id: string };
+type PricingTable = Record<string, Record<string, unknown> | undefined>;
+
+const modelsByProvider = PROVIDER_MODELS as unknown as Record<string, ModelEntry[] | undefined>;
+const pricingTable = getDefaultPricing() as unknown as Record<string, PricingTable | undefined>;
+
+/** Spelling-insensitive form: "claude-opus-4.7" and "claude-opus-4-7" collapse. */
+function collapseSpelling(id: string): string {
+  return id.replace(/[.\-_]/g, "").toLowerCase();
+}
+
+test("no model loses its pricing purely because of how its id is spelled", () => {
+  const offenders: string[] = [];
+  let priced = 0;
+
+  for (const [providerId, models] of Object.entries(modelsByProvider)) {
+    const providerPricing = pricingTable[providerId];
+    if (!providerPricing) continue; // provider has no pricing table at all — separate concern
+    const collapsedKeys = new Map<string, string>();
+    for (const key of Object.keys(providerPricing)) {
+      if (!collapsedKeys.has(collapseSpelling(key))) {
+        collapsedKeys.set(collapseSpelling(key), key);
+      }
+    }
+
+    for (const model of models ?? []) {
+      if (!model?.id) continue;
+      if (getPricingForModel(providerId, model.id)) {
+        priced++;
+        continue;
+      }
+      const wouldMatch = collapsedKeys.get(collapseSpelling(model.id));
+      if (wouldMatch) {
+        offenders.push(
+          `${providerId}/${model.id} has no pricing, but "${wouldMatch}" is priced (same id, other spelling)`
+        );
+      }
+    }
+  }
+
+  assert.ok(priced > 100, `expected a broad sweep, only ${priced} rows resolved pricing`);
+  assert.deepEqual(offenders, [], `pricing lost to id spelling:\n  ${offenders.join("\n  ")}`);
+});
+
+test("both spellings of the current Claude 4.x models are priced under anthropic", () => {
+  for (const base of ["claude-opus-4-8", "claude-opus-4-7", "claude-opus-4-6", "claude-sonnet-4-6"]) {
+    const dotted = base.replace(/-(\d)$/, ".$1");
+    const dashed = base;
+    const dottedPricing = getPricingForModel("anthropic", dotted);
+    const dashedPricing = getPricingForModel("anthropic", dashed);
+    assert.ok(dottedPricing, `"${dotted}" must be priced`);
+    assert.ok(dashedPricing, `"${dashed}" must be priced`);
+    assert.deepEqual(
+      dottedPricing,
+      dashedPricing,
+      `"${dotted}" and "${dashed}" are the same model and must cost the same`
+    );
+  }
+});
+
+test("registry ids keep their upstream spelling — the data is NOT normalised", () => {
+  // Guard on the fix direction: the two spellings must both still exist in the
+  // registry. Rewriting them to one form would send an id the upstream rejects.
+  const spellings = new Map<string, Set<string>>();
+  for (const models of Object.values(modelsByProvider)) {
+    for (const model of models ?? []) {
+      if (!model?.id || !/claude/i.test(model.id)) continue;
+      const set = spellings.get(collapseSpelling(model.id)) ?? new Set<string>();
+      set.add(model.id);
+      spellings.set(collapseSpelling(model.id), set);
+    }
+  }
+  const divergent = [...spellings.values()].filter((set) => set.size > 1);
+  assert.ok(
+    divergent.length > 0,
+    "providers legitimately spell the same Claude model differently; that must stay untouched"
+  );
+});
