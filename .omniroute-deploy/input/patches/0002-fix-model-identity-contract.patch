diff --git a/src/shared/providers/identity.ts b/src/shared/providers/identity.ts
new file mode 100644
index 000000000..632762f50
--- /dev/null
+++ b/src/shared/providers/identity.ts
@@ -0,0 +1,275 @@
+/**
+ * Canonical provider-identity resolver — the single place that turns the first
+ * segment of a published model id into the provider it actually belongs to, and
+ * back again.
+ *
+ * WHY THIS EXISTS
+ *
+ * A published model id can legitimately arrive in any of these shapes:
+ *
+ *   <nodeId>/<model>      anthropic-compatible-<uuid>/claude-opus-5
+ *   <prefix>/<model>      pix4k/claude-opus-5          (operator-configured prefix)
+ *   <alias>/<model>       cx/gpt-5.6, ag/gemini-3.6-flash
+ *   <providerId>/<model>  codex/gpt-5.6
+ *   <model>               gpt-5.6                      (bare, no provider segment)
+ *
+ * Before this module, roughly a dozen call sites each did `split("/")[0]` and
+ * then treated segment 0 as though it were a provider *node id*. That is only
+ * true for one of the shapes above, so every other shape silently resolved to a
+ * provider that does not exist. The most damaging instance was the api-key
+ * "non-public models" gate (src/lib/db/apiKeys.ts): it looked up
+ * `syncedAvailableModels` under the literal prefix/alias, found nothing, and
+ * denied the request — for a model the catalog had just advertised. That gate
+ * runs on the inference path too, so an advertised id was not merely invisible,
+ * it was uncallable.
+ *
+ * THE CONTRACT THIS MODULE ENFORCES
+ *
+ *   storage  keeps the raw node id      (key_value keys, call_logs.provider, …)
+ *   publish  uses the operator's prefix (or the registry alias)
+ *   inbound  accepts EVERY shape above and normalizes to the node id
+ *
+ * Callers that need "which provider is this?" use `resolveProviderIdentity`.
+ * Callers that need "how do I show this provider publicly?" use
+ * `getPublicProviderPrefix`. Nothing should re-derive either by hand.
+ *
+ * @module shared/providers/identity
+ */
+
+import { isCompatibleProviderConnectionId } from "@/shared/utils/compatibleProviderId";
+
+/** The subset of a provider_nodes row this module needs. */
+export type ProviderNodeLike = {
+  id?: string | null;
+  prefix?: string | null;
+  type?: string | null;
+  name?: string | null;
+};
+
+/** How the first segment of a model id was recognized. */
+export type ProviderSegmentKind =
+  /** Matched a provider_nodes.id verbatim (a custom compatible node). */
+  | "nodeId"
+  /** Matched a provider_nodes.prefix (operator-configured public prefix). */
+  | "nodePrefix"
+  /** Matched a built-in registry provider id. */
+  | "providerId"
+  /** Matched a built-in registry alias (cx, cc, ag, kr…). */
+  | "alias"
+  /** A synthetic namespace that is not a provider at all (no-think, auto, qtSd, combo). */
+  | "synthetic"
+  /** Nothing matched — the segment is passed through unchanged. */
+  | "unknown";
+
+export type ProviderIdentity = {
+  /** The id every STORAGE key must use. Never a prefix, never an alias. */
+  providerId: string;
+  /** The public prefix, when the resolved provider declares one. */
+  publicPrefix: string | null;
+  /** How `segment` was recognized — useful for diagnostics and for gating. */
+  kind: ProviderSegmentKind;
+};
+
+/**
+ * Namespaces that occupy segment 0 of a published id but are NOT providers.
+ *
+ * `no-think/<provider>/<model>` and `qtSd/<slug>/<provider>/<model>` wrap a real
+ * provider id in a synthetic outer segment, and `auto`/`combo` name a routing
+ * construct rather than an upstream. A caller that blindly treats segment 0 as a
+ * provider will resolve these to a provider named "no-think" or "auto"; callers
+ * must instead recognize the synthetic namespace and look deeper.
+ */
+export const SYNTHETIC_MODEL_NAMESPACES: ReadonlySet<string> = new Set([
+  "no-think",
+  "auto",
+  "combo",
+  "qtSd",
+]);
+
+export function isSyntheticModelNamespace(segment: string): boolean {
+  return SYNTHETIC_MODEL_NAMESPACES.has(segment);
+}
+
+/**
+ * Split a published model id into its provider segment and the remainder,
+ * WITHOUT assuming the remainder is slash-free.
+ *
+ * Only the FIRST slash separates provider from model: `openrouter/vendor/model`
+ * is provider `openrouter` and model `vendor/model`, not a three-part id. Call
+ * sites that used `split("/")[1]` truncated every namespaced model id.
+ */
+export function splitProviderSegment(modelId: string): {
+  segment: string | null;
+  rest: string;
+} {
+  const clean = (modelId || "").trim();
+  const firstSlash = clean.indexOf("/");
+  if (firstSlash < 0) return { segment: null, rest: clean };
+  return {
+    segment: clean.slice(0, firstSlash).trim(),
+    rest: clean.slice(firstSlash + 1).trim(),
+  };
+}
+
+type ResolveOptions = {
+  /** provider_nodes rows; pass the cached list to avoid a query per call. */
+  nodes?: readonly ProviderNodeLike[];
+  /** alias/providerId -> canonical providerId, as built from the registry. */
+  aliasToProviderId?: Readonly<Record<string, string>>;
+  /** canonical providerId -> alias, as built from the registry. */
+  providerIdToAlias?: Readonly<Record<string, string>>;
+};
+
+/**
+ * Resolve one provider segment (NOT a full model id) to its canonical identity.
+ *
+ * Resolution order is deliberate:
+ *   1. synthetic namespaces — never a provider, reported as such;
+ *   2. an exact provider_nodes.id — a compatible node addressed by storage id;
+ *   3. a registry alias / provider id — built-ins win over a user prefix here,
+ *      because a node whose prefix shadows a built-in must not hijack it (a
+ *      prefix collision is rejected at write time, but pre-existing rows and
+ *      direct-DB edits can still produce one);
+ *   4. a provider_nodes.prefix — the operator's public prefix;
+ *   5. unknown — returned verbatim so behaviour degrades to the old identity
+ *      fallback rather than throwing.
+ */
+export function resolveProviderSegment(
+  segment: string | null | undefined,
+  options: ResolveOptions = {}
+): ProviderIdentity {
+  const raw = (segment || "").trim();
+  if (!raw) return { providerId: "", publicPrefix: null, kind: "unknown" };
+
+  const { nodes = [], aliasToProviderId = {}, providerIdToAlias = {} } = options;
+
+  if (isSyntheticModelNamespace(raw)) {
+    return { providerId: raw, publicPrefix: null, kind: "synthetic" };
+  }
+
+  const byNodeId = nodes.find((node) => node?.id === raw);
+  if (byNodeId?.id) {
+    return {
+      providerId: byNodeId.id,
+      publicPrefix: normalizePrefix(byNodeId.prefix),
+      kind: "nodeId",
+    };
+  }
+
+  const mapped = aliasToProviderId[raw];
+  if (mapped) {
+    return {
+      providerId: mapped,
+      publicPrefix: providerIdToAlias[mapped] || null,
+      // `mapped === raw` means the segment was already the canonical id.
+      kind: mapped === raw ? "providerId" : "alias",
+    };
+  }
+
+  const byPrefix = nodes.find((node) => normalizePrefix(node?.prefix) === raw);
+  if (byPrefix?.id) {
+    return {
+      providerId: byPrefix.id,
+      publicPrefix: normalizePrefix(byPrefix.prefix),
+      kind: "nodePrefix",
+    };
+  }
+
+  return { providerId: raw, publicPrefix: null, kind: "unknown" };
+}
+
+/**
+ * Resolve a FULL published model id to `{providerId, modelId}` plus how the
+ * provider segment was recognized.
+ *
+ * `modelId` is always the upstream-facing id, i.e. what storage keys such as
+ * `syncedAvailableModels` and `modelCompatOverrides` are keyed by. A bare id
+ * (no provider segment) yields `providerId: null` — the caller decides whether
+ * to infer a provider, because inference is a routing policy, not an identity
+ * fact.
+ */
+export function resolveProviderIdentity(
+  publishedModelId: string,
+  options: ResolveOptions = {}
+): { providerId: string | null; modelId: string; kind: ProviderSegmentKind } {
+  const { segment, rest } = splitProviderSegment(publishedModelId);
+  if (!segment) return { providerId: null, modelId: rest, kind: "unknown" };
+
+  const identity = resolveProviderSegment(segment, options);
+
+  // A synthetic outer namespace wraps a real provider-qualified id; recurse so
+  // `no-think/pix4k/claude-opus-5` resolves to the pix4k node, not "no-think".
+  if (identity.kind === "synthetic" && rest.includes("/")) {
+    const inner = resolveProviderIdentity(rest, options);
+    if (inner.providerId) return inner;
+  }
+
+  return { providerId: identity.providerId, modelId: rest, kind: identity.kind };
+}
+
+/**
+ * The prefix a provider must be PUBLISHED under: the operator's configured node
+ * prefix when there is one, else the registry alias, else the canonical id.
+ *
+ * This is the inverse of `resolveProviderSegment` and the only sanctioned way to
+ * build a public id. Four call sites in the catalog, the combo builder and the
+ * /v1beta surface each reimplemented this chain slightly differently, which is
+ * how the same model ended up published under a prefix on one surface and a raw
+ * UUID on another.
+ */
+export function getPublicProviderPrefix(
+  providerId: string,
+  options: ResolveOptions = {}
+): string {
+  const raw = (providerId || "").trim();
+  if (!raw) return raw;
+  const { nodes = [], providerIdToAlias = {} } = options;
