+ * routing prefix, so it must not collapse to the short alias. /v1/models reports
+ * `owned_by: "github"` while publishing both `github/x` and `gh/x` ids, and any
+ * surface that reported `gh` instead would silently stop matching a client that
+ * groups or filters by owner (exactly the class of drift that made
+ * GET /v1/providers/<p>/models return an empty list).
+ */
+export function resolvePublicOwnerId(providerId: string, options: ResolveOptions = {}): string {
+  const raw = (providerId || "").trim();
+  if (!raw) return raw;
+  const { nodes = [], aliasToProviderId = {} } = options;
+
+  const node = nodes.find((entry) => entry?.id === raw);
+  const nodePrefix = normalizePrefix(node?.prefix);
+  if (nodePrefix) return nodePrefix;
+
+  // An alias must resolve to its canonical id; an unknown value passes through so
+  // behaviour degrades to the caller's own fallback instead of throwing.
+  return aliasToProviderId[raw] || raw;
+}
+
+/**
+ * True when `segment` is safe to expose publicly as a provider prefix. A raw
+ * compatible-node id is a storage detail (an internal UUID) and must never
+ * appear in a public model id — clients group by it and render it verbatim.
+ */
