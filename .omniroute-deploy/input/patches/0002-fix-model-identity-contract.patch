+  );
+
+  // The raw node id is what stored rows reference, so it must keep working and
+  // return the SAME roster: one provider, two names for it.
+  const byNodeId = await fetchScoped(nodeId);
+  assert.equal(byNodeId.status, 200, "the raw node id must remain addressable");
+  assert.deepEqual(
+    [...byNodeId.ids].sort(),
+    [...byPrefix.ids].sort(),
+    "addressing a custom provider by prefix or by node id must return the same models"
+  );
+});
