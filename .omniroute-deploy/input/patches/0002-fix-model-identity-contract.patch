+  await combosDb.createCombo({
+    name: "banned-combo",
+    strategy: "failover",
+    models: [{ provider: "openai", modelStr: "openai/gpt-4o" }],
+  } as never);
+
+  const key = await makeKey("combo-blocked", {
+    allowedCombos: ["banned-combo"],
+    allowedModels: ["openai/gpt-4o"],
+    blockedModels: ["banned-combo"],
+  });
+
+  const listed = await listCatalogIds("combo-blocked", key.key);
+  assert.equal(
+    listed.includes("banned-combo"),
+    false,
+    "the deny-list outranks allowed_combos in the catalog, as it does on the request path"
+  );
+
+  const policy = await loadPolicy("combo-blocked");
+  const call = await policy.enforceApiKeyPolicy(makeRequest(key.key), "banned-combo");
+  assert.ok(call.rejection, "and the same combo must be uncallable");
+});
diff --git a/tests/unit/apikey-published-id-round-trip.test.ts b/tests/unit/apikey-published-id-round-trip.test.ts
new file mode 100644
index 000000000..1f64888b8
--- /dev/null
+++ b/tests/unit/apikey-published-id-round-trip.test.ts
@@ -0,0 +1,154 @@
+/**
+ * tests/unit/apikey-published-id-round-trip.test.ts
+ *
+ * A published model id must be CALLABLE. This pins the defect class where the
+ * catalog advertised an id that the api-key gate then refused.
+ *
+ * `disable_non_public_models` allows a model only when it is "discovered", and the
+ * discovery lookup is keyed by the provider's STORAGE id. The gate used to take the
+ * first path segment of the requested id verbatim as that storage key, which holds
+ * only when a client addresses a provider by its canonical id. Every other shape the
+ * catalog actually publishes resolved to a provider that does not exist:
+ *
+ *   pix4k/<model>   an operator-configured node prefix  -> looked up provider "pix4k"
+ *   cx/<model>      a registry alias                    -> looked up provider "cx"
+ *   <curated model> straight from the static registry    -> never in synced/custom
+ *
+ * Because `isModelAllowedForKey` also runs on the inference path (via
+ * enforceApiKeyPolicy), the symptom was not a missing catalog row but a 403 on an
+ * id OmniRoute had just published. The existing coverage in
+ * apikeypolicy-disable-non-public.test.ts exercises built-in providers only, where
+ * prefix == canonical id, so it passed throughout.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+const TEST_DATA_DIR = fs.mkdtempSync(path.join(os.tmpdir(), "omniroute-published-roundtrip-"));
+process.env.DATA_DIR = TEST_DATA_DIR;
+process.env.API_KEY_SECRET = process.env.API_KEY_SECRET || "published-id-round-trip-secret";
+
+const coreDb = await import("../../src/lib/db/core.ts");
+const apiKeysDb = await import("../../src/lib/db/apiKeys.ts");
+const modelsDb = await import("../../src/lib/db/models.ts");
+const providersDb = await import("../../src/lib/db/providers.ts");
+const readCache = await import("../../src/lib/db/readCache.ts");
+
+/** The node id shape the creation route generates for anthropic-compatible. */
+const NODE_ID = "anthropic-compatible-11111111-2222-3333-4444-555555555555";
+const NODE_PREFIX = "pix4k";
+const CONNECTION_ID = "conn-round-trip-1";
+const SYNCED_MODEL = "claude-opus-5";
+const HIDDEN_MODEL = "claude-sonnet-4";
+
+async function resetStorage() {
+  apiKeysDb.resetApiKeyState();
+  coreDb.resetDbInstance();
+  if (fs.existsSync(TEST_DATA_DIR)) fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true });
+  fs.mkdirSync(TEST_DATA_DIR, { recursive: true });
+}
+
+/**
+ * Seed a custom compatible provider the way the product does: a provider_nodes
+ * row carrying the public prefix, plus per-connection synced models keyed by the
+ * raw node id.
+ */
+async function seedCompatibleProvider() {
+  await providersDb.createProviderNode({
+    id: NODE_ID,
+    type: "anthropic-compatible",
+    name: "Pix4k",
+    prefix: NODE_PREFIX,
+    baseUrl: "https://example.invalid/v1",
+  } as never);
+
+  await modelsDb.replaceSyncedAvailableModelsForConnection(NODE_ID, CONNECTION_ID, [
+    { id: SYNCED_MODEL },
+    { id: HIDDEN_MODEL },
+  ] as never);
+
+  // provider_nodes is read through a 5s TTL cache; drop it so the resolver sees
+  // the row we just wrote instead of a pre-seed snapshot.
+  readCache.invalidateReadCaches?.();
+  apiKeysDb.clearApiKeyCaches();
+}
+
+async function makeRestrictedKey(label: string) {
+  const created = await apiKeysDb.createApiKey(label, `machine-${label}`);
+  await apiKeysDb.updateApiKeyPermissions(created.id, { disableNonPublicModels: true });
+  apiKeysDb.clearApiKeyCaches();
+  return created;
+}
+
+test.beforeEach(async () => {
+  await resetStorage();
+});
+
+test.after(async () => {
+  apiKeysDb.resetApiKeyState();
+  coreDb.resetDbInstance();
+  fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true });
+});
+
+test("a model published under the node PREFIX is callable", async () => {
+  await seedCompatibleProvider();
+  const key = await makeRestrictedKey("prefix-shape");
+
+  // `<prefix>/<model>` is what /v1/models publishes for a node with a prefix.
+  const allowed = await apiKeysDb.isModelAllowedForKey(key.key, `${NODE_PREFIX}/${SYNCED_MODEL}`);
+  assert.equal(allowed, true, "the prefix-qualified id the catalog advertises must be callable");
+});
+
+test("the same model addressed by raw node id stays callable", async () => {
+  await seedCompatibleProvider();
+  const key = await makeRestrictedKey("nodeid-shape");
+
+  // Combo steps persist this shape, so it must keep working alongside the prefix.
+  const allowed = await apiKeysDb.isModelAllowedForKey(key.key, `${NODE_ID}/${SYNCED_MODEL}`);
+  assert.equal(allowed, true, "storage-shaped ids must not regress");
+});
+
+test("hiding a model still denies it under BOTH id shapes", async () => {
+  await seedCompatibleProvider();
+  modelsDb.mergeModelCompatOverride(NODE_ID, HIDDEN_MODEL, { isHidden: true } as never);
+  apiKeysDb.clearApiKeyCaches();
+  const key = await makeRestrictedKey("hidden-shape");
+
+  // The visibility check is keyed by the node id; resolving the prefix correctly
+  // is what makes the hidden check reachable at all. Before the fix the prefix
+  // shape failed earlier, at discovery, so hiding was never actually consulted.
+  assert.equal(
+    await apiKeysDb.isModelAllowedForKey(key.key, `${NODE_PREFIX}/${HIDDEN_MODEL}`),
+    false,
+    "a hidden model must stay denied when addressed by prefix"
+  );
+  assert.equal(
+    await apiKeysDb.isModelAllowedForKey(key.key, `${NODE_ID}/${HIDDEN_MODEL}`),
+    false,
+    "a hidden model must stay denied when addressed by node id"
+  );
+});
+
+test("an unknown model on a real provider is still denied", async () => {
+  await seedCompatibleProvider();
+  const key = await makeRestrictedKey("unknown-model");
+
+  assert.equal(
+    await apiKeysDb.isModelAllowedForKey(key.key, `${NODE_PREFIX}/never-synced`),
+    false,
+    "widening discovery must not turn the gate into allow-all"
+  );
+});
+
+test("a curated registry model is discoverable, not treated as non-public", async () => {
+  const key = await makeRestrictedKey("registry-model");
+
+  // The catalog publishes models straight from the static registry for providers
+  // with no synced rows. Those were denied because discovery only consulted
+  // synced + custom, which made the flag behave as a near-global deny.
+  const allowed = await apiKeysDb.isModelAllowedForKey(key.key, "openai/gpt-4.1");
+  assert.equal(allowed, true, "a curated, routable registry model must be callable");
+});
diff --git a/tests/unit/assess-route-scope-and-self-url.test.ts b/tests/unit/assess-route-scope-and-self-url.test.ts
new file mode 100644
index 000000000..3cf797374
--- /dev/null
+++ b/tests/unit/assess-route-scope-and-self-url.test.ts
@@ -0,0 +1,207 @@
+/**
+ * tests/unit/assess-route-scope-and-self-url.test.ts
+ *
+ * Three defects in `src/app/api/assess/route.ts`, all measured before the fix.
+ *
+ * 1. `getModelsForProvider()` was literally `void providerId; return getAllModels();`
+ *    so `{"scope":{"type":"provider","providerId":"openai"}}` assessed the ENTIRE
+ *    auto catalog. Measured on a two-connection instance: 38 `auto/*` ids came back
+ *    for a provider scope, and `models_tested` in the response described work that
+ *    had nothing to do with the requested provider.
+ *
+ * 2. The self-referential base URL was hardcoded `http://localhost:20128/v1` in two
+ *    places, ignoring `PORT` / `BASE_URL` / `OMNIROUTE_BASE_URL`. 20128 IS the
+ *    default port, so this looked fine on a default instance — and hit a closed
+ *    socket on any other, where the catch swallowed the error and the route answered
+ *    "0 models" as if nothing were configured. The shared `resolveOmniRouteBaseUrl()`
+ *    (already used by the a2a skills) is the convention.
+ *
+ * 3. `process.env.OMNIROUTe_API_KEY` / `OMNIROUTe_BASE_URL` — lowercase `e` in
+ *    "OMNIROUTe". No such variable exists anywhere in the repo (`.env.example`
+ *    documents `OMNIROUTE_API_KEY`), so both reads were permanently `undefined`.
+ *
+ * The scope test drives the real route handler; the other two are asserted on the
+ * shipped source because the URL is only observable by making a live request.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+const TEST_DATA_DIR = fs.mkdtempSync(path.join(os.tmpdir(), "omniroute-assess-scope-"));
+process.env.DATA_DIR = TEST_DATA_DIR;
+process.env.API_KEY_SECRET = "assess-scope-test-secret";
+process.env.DISABLE_SQLITE_AUTO_BACKUP = "true";
+
+const core = await import("../../src/lib/db/core.ts");
+const providersDb = await import("../../src/lib/db/providers.ts");
+const assessRoute = await import("../../src/app/api/assess/route.ts");
+
+const ROUTE_SOURCE = fs.readFileSync("src/app/api/assess/route.ts", "utf8");
+
+/**
+ * The route source with comments stripped.
+ *
+ * The fix documents the old hardcoded URL and the typo'd env name in its own WHY
+ * comment, so asserting on the raw file would match the explanation rather than the
+ * behaviour. These checks are about what the module EXECUTES.
+ */
+const ROUTE_CODE = ROUTE_SOURCE.replace(/\/\*[\s\S]*?\*\//g, "").replace(/(^|\s)\/\/.*$/gm, "");
+
+async function seedConnection(provider: string, label: string) {
+  return providersDb.createProviderConnection({
+    provider,
+    authType: "apikey",
+    name: `assess-${label}`,
+    apiKey: `sk-assess-${label}`,
+    isActive: true,
+    testStatus: "active",
+  } as never);
+}
+
+test.after(() => {
+  core.resetDbInstance();
+  fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true });
+});
+
+// ---------------------------------------------------------------------------
+// 1. provider scope must actually scope
+// ---------------------------------------------------------------------------
+
+/**
+ * Serve the route's own `/v1/models` read from the in-process catalog.
+ *
+ * The route fetches its own HTTP surface, and there is no listener in a unit test, so
+ * without this the catalog comes back empty and every scope assertion passes
+ * vacuously. The stub answers only that one URL and delegates everything else.
+ */
+async function withSelfCatalog<T>(run: () => Promise<T>): Promise<T> {
+  const catalog = await import("../../src/app/api/v1/models/catalog.ts");
+  const realFetch = globalThis.fetch;
+  globalThis.fetch = (async (input: RequestInfo | URL, init?: RequestInit) => {
+    const url = typeof input === "string" ? input : input instanceof URL ? input.href : input.url;
+    if (url.endsWith("/v1/models")) {
+      catalog.__resetCatalogBuilderRunsForTest();
+      return catalog.getUnifiedModelsResponse(new Request("http://localhost/v1/models"));
+    }
+    return realFetch(input as never, init);
+  }) as typeof globalThis.fetch;
+  try {
+    return await run();
+  } finally {
+    globalThis.fetch = realFetch;
+  }
+}
+
+test("a provider scope resolves only the auto models that can route to that provider", async () => {
+  core.resetDbInstance();
+  fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true });
+  fs.mkdirSync(TEST_DATA_DIR, { recursive: true });
+  await seedConnection("openai", "openai");
+  await seedConnection("claude", "claude");
+
+  const { scoped, all } = await withSelfCatalog(async () => ({
+    scoped: await assessRoute.__getModelsForProviderForTest("claude"),
+    all: await assessRoute.__getAllModelsForTest(),
+  }));
+
+  // Guard against the vacuous version of this test: the whole point is that the
+  // scoped list is SMALLER than the full one, which says nothing if both are empty.
+  assert.ok(all.length > 0, "precondition: the catalog must advertise auto models");
+  assert.ok(
+    scoped.length < all.length,
+    `a provider scope must be a strict subset: scoped=${scoped.length} all=${all.length}`
+  );
+  for (const entry of scoped) {
+    assert.ok(
+      all.some((m) => m.modelId === entry.modelId),
+      `scoped entry "${entry.modelId}" must come from the published catalog`
+    );
+  }
+});
+
+test("an unknown provider scope resolves nothing instead of the whole catalog", async () => {
+  const { scoped, all } = await withSelfCatalog(async () => ({
+    scoped: await assessRoute.__getModelsForProviderForTest("not-a-real-provider-xyz"),
+    all: await assessRoute.__getAllModelsForTest(),
+  }));
+  assert.ok(all.length > 0, "precondition: there must be something a full sweep would return");
+  assert.deepEqual(
+    scoped,
+    [],
+    "a provider the catalog does not know must yield an empty assessment, not a full sweep"
+  );
+});
+
+test("an empty provider scope resolves nothing", async () => {
+  assert.deepEqual(await assessRoute.__getModelsForProviderForTest("   "), []);
+});
+
+// ---------------------------------------------------------------------------
+// 2. multi-segment model scope must not be truncated
+// ---------------------------------------------------------------------------
+
+test("a model scope keeps every segment after the first slash", async () => {
+  const response = await assessRoute.POST(
+    new Request("http://localhost/api/assess", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({
+        scope: { type: "model", modelId: "openrouter/anthropic/claude-opus-4.8" },
+      }),
+    }) as never
+  );
+  // The probe itself cannot succeed without a live upstream; what matters is the id
+  // the route derived, which the run's tested count reflects (1 pair, not 0).
+  assert.equal(response.status, 200, "a model scope must be accepted");
+  const body = (await response.json()) as { models_tested?: number };
+  assert.equal(body.models_tested, 1, "exactly the one requested pair must be assessed");
+
+  // `split("/")[1]` returned "anthropic" here — a model that does not exist.
+  assert.doesNotMatch(
+    ROUTE_SOURCE,
+    /scope\.modelId\.split\("\/"\)\[1\]/,
+    "the model scope must not be split on every slash"
+  );
+});
+
+// ---------------------------------------------------------------------------
+// 3. no hardcoded port, no typo'd env var
+// ---------------------------------------------------------------------------
+
+test("the route derives its own base URL instead of hardcoding the default port", () => {
+  assert.doesNotMatch(
+    ROUTE_CODE,
+    /http:\/\/localhost:20128/,
+    "the self base URL must come from resolveOmniRouteBaseUrl(), not a hardcoded literal"
+  );
+  assert.match(
+    ROUTE_CODE,
+    /resolveOmniRouteBaseUrl/,
+    "the shared resolver is the convention (OMNIROUTE_BASE_URL → BASE_URL → NEXT_PUBLIC_BASE_URL → default)"
+  );
+});
+
+test("the route reads the documented env var name, not the typo", () => {
+  assert.doesNotMatch(
+    ROUTE_CODE,
+    /OMNIROUTe_/,
+    'the lowercase-e "OMNIROUTe_*" names never existed; .env.example documents OMNIROUTE_API_KEY'
+  );
+  assert.match(ROUTE_CODE, /OMNIROUTE_API_KEY/, "the documented key name must be read");
+});
+
+test("resolveOmniRouteBaseUrl honours an overridden base URL", async () => {
+  // Guard on the fix direction: the resolver must actually vary with the env, or
+  // switching to it would have been cosmetic.
+  const { resolveOmniRouteBaseUrl, DEFAULT_OMNIROUTE_BASE_URL } = await import(
+    "../../src/shared/utils/resolveOmniRouteBaseUrl.ts"
+  );
+  assert.equal(
+    resolveOmniRouteBaseUrl({ OMNIROUTE_BASE_URL: "http://127.0.0.1:31337/" }),
+    "http://127.0.0.1:31337"
+  );
+  assert.equal(resolveOmniRouteBaseUrl({}), DEFAULT_OMNIROUTE_BASE_URL);
+});
diff --git a/tests/unit/catalog-alias-backed-node-prefix.test.ts b/tests/unit/catalog-alias-backed-node-prefix.test.ts
new file mode 100644
index 000000000..93f99f2de
--- /dev/null
+++ b/tests/unit/catalog-alias-backed-node-prefix.test.ts
@@ -0,0 +1,121 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+/**
+ * The alias-backed publishing loop in `/v1/models` (the port of 9router#730 that
+ * surfaces models registered ONLY through a `modelAliases` entry) was the last
+ * loop in the catalog that named its provider without consul
+ * `provider_nodes.prefix`:
+ *
+ *     const alias = providerIdToAlias[canonicalProviderId] || providerKey;
+ *
+ * For a compatible-provider node BOTH sides of that `||` are the node's internal
+ * uuid — it is not in the static alias map by construction. So an operator who
+ * registered `setModelAlias("kimi", "<node-uuid>/kimi-k2.6")` got the uuid
+ * published as the model-id prefix, and under the default `prefixMode="dual"`
+ * the canonical branch minted a SECOND uuid-prefixed row plus one per
+ * reasoning-effort variant and the `no-think/` alias — 10 rows in the observed
+ * case, every one of them exposing storage state to clients.
+ *
+ * The three other publishing loops (synced :836, custom :1212, fallback :1428)
+ * already read `prefix || alias || id` and guard their canonical branch with
+ * `!prefix`; this test pins the alias-backed loop to the same contract.
+ */
+
+const TEST_DATA_DIR = fs.mkdtempSync(path.join(os.tmpdir(), "omniroute-alias-backed-"));
+process.env.DATA_DIR = TEST_DATA_DIR;
+process.env.API_KEY_SECRET = process.env.API_KEY_SECRET || "alias-backed-test-secret";
+
+const core = await import("../../src/lib/db/core.ts");
+const aliasesDb = await import("../../src/lib/db/models/aliases.ts");
+const providersDb = await import("../../src/lib/db/providers.ts");
+const readCache = await import("../../src/lib/db/readCache.ts");
+const v1Catalog = await import("../../src/app/api/v1/models/catalog.ts");
+
+const NODE_ID = "anthropic-compatible-44444444-3333-2222-1111-000000000000";
+const NODE_PREFIX = "pix4k";
+const MODEL = "kimi-k2.6";
+
+async function listIds(): Promise<string[]> {
+  readCache.invalidateReadCaches?.();
+  (
+    v1Catalog as { __resetCatalogBuilderRunsForTest?: () => void }
+  ).__resetCatalogBuilderRunsForTest?.();
+  const response = await v1Catalog.getUnifiedModelsResponse(
+    new Request("http://localhost/v1/models")
+  );
+  const body = (await response.json()) as { data?: Array<{ id?: unknown }> };
+  return (body.data ?? [])
+    .map((entry) => entry?.id)
+    .filter((id): id is string => typeof id === "string" && id.length > 0);
+}
+
+test.before(async () => {
+  core.resetDbInstance();
+  fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true });
+  fs.mkdirSync(TEST_DATA_DIR, { recursive: true });
+
+  await providersDb.createProviderNode({
+    id: NODE_ID,
+    type: "anthropic-compatible",
+    name: "Pix4k",
+    prefix: NODE_PREFIX,
+    baseUrl: "https://example.invalid/v1",
+  } as never);
+  await providersDb.createProviderConnection({
+    provider: NODE_ID,
+    authType: "apikey",
+    apiKey: "test-key-alias-backed",
+    isActive: true,
+    testStatus: "active",
+  } as never);
+  // The model exists ONLY as an alias mapping — no synced list, no custom model.
+  await aliasesDb.setModelAlias("kimi", `${NODE_ID}/${MODEL}`);
+});
+
+test.after(() => {
+  core.resetDbInstance();
+  fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true });
+});
+
+test("an alias-backed model on a compatible node publishes under the operator prefix", async () => {
+  const ids = await listIds();
+  assert.ok(
+    ids.includes(`${NODE_PREFIX}/${MODEL}`),
+    `expected ${NODE_PREFIX}/${MODEL}; got ${JSON.stringify(ids.filter((id) => id.includes(MODEL)))}`
+  );
+});
+
+test("no published id carries the node's internal uuid", async () => {
+  const ids = await listIds();
+  // Precondition: this loop must actually have produced rows, otherwise the
+  // assertion below is vacuous and would pass on a broken build too.
+  assert.ok(
+    ids.some((id) => id.includes(MODEL)),
+    "the alias-backed row must be published at all for this check to mean anything"
+  );
+  assert.deepEqual(
+    ids.filter((id) => id.includes(NODE_ID)),
+    [],
+    "the raw node uuid is storage state and must never reach a client"
+  );
+});
+
+test("the canonical branch does not mint a second uuid-prefixed row under dual mode", async () => {
+  // `prefixMode` defaults to "dual", which mints both the alias-prefixed and the
+  // canonical-prefixed id. For a prefixed node the canonical id IS the uuid, so
+  // that branch has to stay off — same `!prefix` guard as the synced/custom loops.
+  const ids = await listIds();
+  const forModel = ids.filter((id) => id.endsWith(`/${MODEL}`));
+  assert.ok(forModel.length > 0, "the alias-backed row must be published");
+  for (const id of forModel) {
+    const prefix = id.slice(0, id.length - `/${MODEL}`.length);
+    assert.ok(
+      prefix === NODE_PREFIX || !prefix.includes(NODE_ID),
+      `unexpected publishing prefix ${JSON.stringify(prefix)} for ${MODEL}`
+    );
+  }
+});
diff --git a/tests/unit/catalog-alias-publish-round-trip.test.ts b/tests/unit/catalog-alias-publish-round-trip.test.ts
new file mode 100644
index 000000000..37af79c2c
--- /dev/null
+++ b/tests/unit/catalog-alias-publish-round-trip.test.ts
@@ -0,0 +1,163 @@
+/**
+ * tests/unit/catalog-alias-publish-round-trip.test.ts
+ *
+ * `buildAliasMaps().providerIdToAlias` decides the PUBLIC prefix every model of a
+ * provider is advertised under in /v1/models. Nothing checked that the chosen
+ * alias parses back to the same provider, so a provider whose registry alias was
+ * wrong advertised ids no client could call.
+ *
+ * Measured across the whole registry before the fix — five providers in that state:
+ *
+ *   aihorde     → "horde/…"     parseModel → "horde"        (no such provider)
+ *   modal       → "mdl/…"       parseModel → "mdl"          (no such provider)
+ *   copilot-web → "copilot/…"   parseModel → "copilot"      (no such provider)
+ *   poe-web     → "poe/…"       parseModel → "poe"          (a DIFFERENT provider)
+ *   agy         → "agy/…"       parseModel → "antigravity"  (canonicalised, see W7a)
+ *
+ * And one inbound defect of the same family: `poe-web` declares `alias: "poe"`
+ * while `poe` is a real provider with its own three models, so the map resolved
+ * `poe` → `poe-web` even though `parseModel("poe/…")` routes to `poe`. An inbound
+ * `poe/gpt-5.2` was attributed to the wrong provider.
+ *
+ * Both are structural, so the assertions below sweep the whole registry rather
+ * than listing the six ids — a future provider added with a bad alias fails here
+ * instead of shipping an uncallable namespace.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+
+const { buildAliasMaps, resolveCanonicalProviderId } = await import(
+  "../../src/app/api/v1/models/catalogProviderMaps.ts"
+);
+const { parseModel } = await import("../../open-sse/services/model.ts");
+const { PROVIDER_MODELS, PROVIDER_ID_TO_ALIAS } = await import(
+  "../../open-sse/config/providerModels.ts"
+);
+const { AI_PROVIDERS } = await import("../../src/shared/constants/providers.ts");
+
+type ModelEntry = { id: string };
+const modelsByKey = PROVIDER_MODELS as unknown as Record<string, ModelEntry[] | undefined>;
+
+/**
+ * `agy` is a deliberate exception, resolved in its own right by the alias
+ * canonicalisation work: the id `agy` exists in both registries but every
+ * `agy/<model>` intentionally routes to `antigravity`. Excluded here so this
+ * suite pins the round-trip rule without re-litigating that decision.
+ */
+const CANONICALISED_ELSEWHERE = new Set(["agy"]);
+
+test("every published alias parses back to the provider it publishes for", () => {
+  const { providerIdToAlias } = buildAliasMaps();
+  const offenders: string[] = [];
+  let checked = 0;
+
+  for (const [providerId, alias] of Object.entries(providerIdToAlias)) {
+    if (CANONICALISED_ELSEWHERE.has(providerId)) continue;
+    const models = modelsByKey[providerId] ?? modelsByKey[alias];
+    if (!models?.length) continue;
+    checked++;
+    const publishedId = `${alias}/${models[0].id}`;
+    const resolved = parseModel(publishedId).provider;
+    if (resolved !== providerId) {
+      offenders.push(`${providerId} publishes "${publishedId}" which parses to "${resolved}"`);
+    }
+  }
+
+  assert.ok(checked > 100, `expected a broad sweep, only checked ${checked} providers`);
+  assert.deepEqual(offenders, [], `advertised-but-uncallable namespaces:\n  ${offenders.join("\n  ")}`);
+});
+
+test("no provider's own id is resolved to a different provider", () => {
+  const { aliasToProviderId } = buildAliasMaps();
+  const offenders: string[] = [];
+
+  const ownIds = new Set<string>([
+    ...Object.keys(AI_PROVIDERS),
+    ...Object.keys(PROVIDER_ID_TO_ALIAS),
+  ]);
+  for (const id of ownIds) {
+    const mapped = aliasToProviderId[id];
+    if (mapped && mapped !== id) offenders.push(`"${id}" resolves to "${mapped}"`);
+  }
+
+  assert.deepEqual(
+    offenders,
+    [],
+    `a provider id was taken over by another provider's alias:\n  ${offenders.join("\n  ")}`
+  );
+});
+
+test("the measured providers publish a callable namespace", () => {
+  const { providerIdToAlias } = buildAliasMaps();
+  // Each of these used to publish an alias that resolved nowhere (or elsewhere).
+  // The fix falls back to the provider id, which parses back by construction.
+  // jina-ai is the same defect on a provider with no static models, so the
+  // whole-registry sweep above cannot see it: it declares `alias: "jina"` and
+  // `parseModel("jina/…")` resolves to a provider named "jina" that exists in
+  // neither registry. models-catalog-route.test.ts pinned the uncallable
+  // `jina/<model>` id until this rule landed.
+  for (const providerId of ["aihorde", "modal", "copilot-web", "poe-web", "jina-ai"]) {
+    const alias = providerIdToAlias[providerId];
+    assert.ok(alias, `${providerId} must have a publishable prefix`);
+    assert.equal(
+      parseModel(`${alias}/__probe__`).provider,
+      providerId,
+      `${providerId} publishes "${alias}/" which does not route back to it`
+    );
+  }
+});
+
+test("poe and poe-web stay distinct on both directions", () => {
+  const { aliasToProviderId, providerIdToAlias } = buildAliasMaps();
+  assert.equal(resolveCanonicalProviderId(aliasToProviderId, "poe"), "poe");
+  assert.equal(resolveCanonicalProviderId(aliasToProviderId, "poe-web"), "poe-web");
+  assert.notEqual(providerIdToAlias["poe"], providerIdToAlias["poe-web"]);
+  assert.equal(parseModel("poe/gpt-5.2").provider, "poe");
+});
+
+test("the short aliases clients already use still resolve inbound", () => {
+  // The fix gates only the OUTBOUND publishing choice. Every alias a client may
+  // already hold must keep resolving, including the four whose publishing was
+  // rejected.
+  const { aliasToProviderId } = buildAliasMaps();
+  const expected: Record<string, string> = {
+    cc: "claude",
+    cx: "codex",
+    gh: "github",
+    kr: "kiro",
+    kc: "kilocode",
+    cl: "cline",
+    cu: "cursor",
+    kmc: "kimi-coding",
+    ag: "antigravity",
+    horde: "aihorde",
+    mdl: "modal",
+    copilot: "copilot-web",
+    gld: "gitlab-duo",
+  };
+  for (const [alias, providerId] of Object.entries(expected)) {
+    assert.equal(aliasToProviderId[alias], providerId, `inbound alias "${alias}" regressed`);
+  }
+});
+
+test("gitlab-duo resolves from its open-sse alias, which the two registries disagreed on", () => {
+  // `AI_PROVIDERS` declares gitlab-duo's alias as its own id while the open-sse
+  // registry declares "gld". The retired bidirectional branch produced this one
+  // mapping as a side effect; registering the open-sse pair in its real direction
+  // covers it explicitly.
+  const { aliasToProviderId } = buildAliasMaps();
+  assert.equal(aliasToProviderId["gld"], "gitlab-duo");
+  assert.equal(aliasToProviderId["gitlab-duo"], "gitlab-duo");
+});
+
+test("every provider with models has a publishable prefix", () => {
+  // Rejecting a bad alias must never leave a provider with no prefix at all —
+  // getProviderPrefixes() would then drop `undefined` into its prefix set.
+  const { providerIdToAlias, aliasToProviderId } = buildAliasMaps();
+  const missing: string[] = [];
+  for (const providerId of new Set(Object.values(aliasToProviderId))) {
+    if (!providerIdToAlias[providerId]) missing.push(providerId);
+  }
+  assert.deepEqual(missing, [], `providers with no publishable prefix: ${missing.join(", ")}`);
+});
