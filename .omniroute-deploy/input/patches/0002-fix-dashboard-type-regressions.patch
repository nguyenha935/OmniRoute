+/**
+ * Narrow an unknown error into a plain string safe to render as a React child.
+ * A bare string is used as-is; an Error contributes only its message. Anything
+ * else (plain objects, numbers, null) yields "" so a raw object is never
+ * stringified into the DOM (which would throw "Objects are not valid as a
+ * React child" and crash the modal).
+ */
+function errorMessage(error: unknown): string {
+  if (typeof error === "string") return error;
+  if (error instanceof Error) return error.message;
+  return "";
+}
