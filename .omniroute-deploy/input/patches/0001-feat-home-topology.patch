+  .topology-edge-kame,
+  .topology-edge-halo,
+  .topology-edge-plasma {
+    animation: none !important;
+  }
+  /* Without the marching dash these read as solid strands rather than frozen dashes. */
+  .topology-edge-kame,
+  .topology-edge-plasma {
+    stroke-dasharray: none !important;
+  }
+  /* The pulse animated transform/box-shadow; keep a static lit state so "active" is
+   * still obvious at a glance. */
+  .topology-router-core {
+    transform: none !important;
+    box-shadow:
+      0 0 8px #fde047,
+      0 0 16px color-mix(in srgb, var(--color-primary) 60%, transparent) !important;
+  }
+}
